@model IEnumerable<ClothingShop.Models.Order>
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Đơn hàng của tôi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-receipt me-2"></i>Lịch sử đơn hàng</h3>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark btn-sm">Tiếp tục mua sắm</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-bag-x display-4 text-muted"></i>
                <h5 class="mt-3">Bạn chưa có đơn hàng nào</h5>
                <a href="@Url.Action("Index", "Product")" class="btn btn-dark btn-sm mt-2">Mua sắm ngay</a>
            </div>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            string badgeClass = order.Status == OrderStatus.Completed ? "bg-success"
                : order.Status == OrderStatus.Cancelled ? "bg-danger"
                : order.Status == OrderStatus.Shipping ? "bg-info text-dark"
                : order.Status == OrderStatus.Confirmed ? "bg-primary"
                : "bg-warning text-dark";

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong class="me-2">Đơn hàng #@order.OrderId</strong>
                        <small class="text-muted">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @badgeClass">@order.Status</span>
                        <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        <i class="bi bi-geo-alt me-1"></i>@order.ReceiverName - @order.Phone | @order.Address
                    </div>

                    @if (order.OrderDetails != null && order.OrderDetails.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Phân loại</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in order.OrderDetails)
                                    {
                                        <tr>
                                            <td>@(d.Product != null ? d.Product.Name : "Sản phẩm #" + d.ProductId)</td>
                                            <td class="small text-muted">@d.Size / @d.Color</td>
                                            <td class="text-center">@d.Quantity</td>
                                            <td class="text-end">@PriceFormatter.Vnd(d.UnitPrice)</td>
                                            <td class="text-end fw-semibold">@PriceFormatter.Vnd(d.UnitPrice * d.Quantity)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top">
                        <div>
                            @if (order.DiscountAmount > 0)
                            {
                                <small class="text-success me-3">Giảm giá: -@PriceFormatter.Vnd(order.DiscountAmount)</small>
                            }
                            <span class="fw-bold">Tổng cộng: <span class="text-danger fs-5">@PriceFormatter.Vnd(order.TotalAmount)</span></span>
                        </div>

                        @if (order.Status == OrderStatus.Pending)
                        {
                            using (Html.BeginForm("Cancel", "Order", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn hủy đơn hàng #@order.OrderId?');">
                                    <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
