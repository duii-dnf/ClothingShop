@using ClothingShop.Services
@model IEnumerable<ClothingShop.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history me-2"></i>Đơn hàng của tôi</h2>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info py-4 text-center shadow-sm">
            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
            Bạn chưa có đơn hàng nào. <a href="@Url.Action("Index", "Product")" class="alert-link">Khám phá sản phẩm ngay</a>!
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 12%">Mã đơn</th>
                        <th style="width: 20%">Ngày đặt</th>
                        <th style="width: 25%">Người nhận</th>
                        <th style="width: 15%">Phương thức</th>
                        <th style="width: 15%" class="text-end">Tổng tiền</th>
                        <th style="width: 13%" class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.OrderId</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div>@order.ReceiverName</div>
                                <small class="text-muted">@order.Phone</small>
                            </td>
                            <td>@order.PaymentMethod</td>
                            <td class="text-end fw-bold text-danger">@PriceFormatter.Vnd(order.TotalAmount)</td>
                            <td class="text-center">
                                @if (order.Status == "Completed")
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                }
                                else if (order.Status == "Shipping")
                                {
                                    <span class="badge bg-primary">Đang giao</span>
                                }
                                else if (order.Status == "Confirmed")
                                {
                                    <span class="badge bg-info text-dark">Đã xác nhận</span>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

