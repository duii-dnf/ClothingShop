@model ClothingShop.Web.ViewModels.CheckoutVM
@using ClothingShop.Models
@using ClothingShop.Services
@using ClothingShop.Web.ViewModels
@{
    ViewBag.Title = "Đặt hàng";
    var cartItems = ViewBag.CartItems as List<CartItemVM> ?? new List<CartItemVM>();
    decimal subTotal = ViewBag.SubTotal != null ? (decimal)ViewBag.SubTotal : 0m;
    decimal shippingFee = ViewBag.ShippingFee != null ? (decimal)ViewBag.ShippingFee : 0m;
    decimal total = ViewBag.Total != null ? (decimal)ViewBag.Total : (subTotal + shippingFee);
    bool isFreeShip = (shippingFee == 0m && subTotal > 0m);
    bool isBankSelected = Model != null && Model.PaymentMethod == PaymentMethods.BankTransfer;

    // Phân loại danh sách Voucher ngay trên Server (không dùng AJAX)
    var allCoupons = ViewBag.Coupons as List<Coupon> ?? new List<Coupon>();
    DateTime today = DateTime.Today;

    var usableCoupons = allCoupons
        .Where(c => c.IsActive
                    && today >= c.StartDate.Date
                    && today <= c.EndDate.Date
                    && c.UsedCount < c.UsageLimit
                    && subTotal >= c.MinOrder)
        .OrderByDescending(c => Math.Round(subTotal * (c.DiscountPercent / 100m), 0))
        .ThenBy(c => c.EndDate)
        .ToList();

    var usableIds = usableCoupons.Select(c => c.CouponId).ToList();
    var unavailableCoupons = allCoupons
        .Where(c => !usableIds.Contains(c.CouponId))
        .OrderByDescending(c => c.EndDate)
        .ToList();

    int? bestCouponId = usableCoupons.Any() ? usableCoupons.First().CouponId : (int?)null;
}

<div class="container py-4" id="checkoutPage"
     data-subtotal="@((long)subTotal)"
     data-shipping="@((long)shippingFee)">

    <!-- Checkout Progress Bar -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-center" style="max-width:520px;margin:0 auto;">
            <!-- Step 1 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success text-white fw-bold" style="width:38px;height:38px;">
                    <i class="bi bi-check2 fs-6"></i>
                </div>
                <div class="small fw-semibold text-success mt-1">Giỏ hàng</div>
            </div>
            <!-- Line -->
            <div class="flex-grow-1 mx-2" style="height:3px;background:linear-gradient(to right,#198754,#0a0a0a);border-radius:2px;"></div>
            <!-- Step 2 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-obsidian text-white fw-bold border border-dark" style="width:38px;height:38px;">
                    2
                </div>
                <div class="small fw-semibold mt-1">Đặt hàng</div>
            </div>
            <!-- Line -->
            <div class="flex-grow-1 mx-2" style="height:3px;background:#dee2e6;border-radius:2px;"></div>
            <!-- Step 3 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted border" style="width:38px;height:38px;">
                    3
                </div>
                <div class="small text-muted mt-1">Hoàn tất</div>
            </div>
        </div>
    </div>

    <h3 class="font-display fw-bold mb-4"><i class="bi bi-credit-card me-2"></i>Xác nhận thông tin đặt hàng</h3>

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { novalidate = "novalidate", id = "checkoutForm" }))
    {
        @Html.AntiForgeryToken()

        <div id="checkoutErrorSummary" class="alert alert-danger border-0 rounded-4 shadow-sm d-none align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <span id="checkoutErrorSummaryText">Vui lòng điền đầy đủ và chính xác các thông tin giao hàng được đánh dấu đỏ trước khi đặt hàng.</span>
        </div>

        if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger border-0 rounded-4 shadow-sm" })
        }

        <div class="row g-4">
            <!-- CỘT TRÁI: Địa chỉ, Thông tin người nhận, Phương thức thanh toán -->
            <div class="col-lg-7">
                @if (Model.SavedAddresses != null && Model.SavedAddresses.Any())
                {
                    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                        <div class="card-header bg-white fw-bold py-3">
                            <i class="bi bi-geo-alt-fill text-danger me-2"></i>Sổ địa chỉ đã lưu
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var addr in Model.SavedAddresses)
                            {
                                <label class="list-group-item d-flex gap-2 align-items-start py-3">
                                    <input class="form-check-input mt-1" type="radio" name="SelectedAddressId" value="@addr.AddressId"
                                           @(Model.SelectedAddressId == addr.AddressId ? "checked" : "") />
                                    <div>
                                        <strong>@addr.ReceiverName</strong> &bull; @addr.ReceiverPhone
                                        @if (addr.IsDefault)
                                        {
                                            <span class="badge bg-obsidian rounded-pill ms-1">Mặc định</span>
                                        }
                                        <div class="small text-muted mt-1">
                                            @string.Join(", ", new[] { addr.DetailAddress, addr.Ward, addr.District, addr.Province }.Where(s => !string.IsNullOrWhiteSpace(s)))
                                        </div>
                                    </div>
                                </label>
                            }
                            <label class="list-group-item d-flex gap-2 align-items-center py-3">
                                <input class="form-check-input mt-0" type="radio" name="SelectedAddressId" value="0"
                                       @(!Model.SelectedAddressId.HasValue || Model.SelectedAddressId == 0 ? "checked" : "") />
                                <span class="fw-semibold text-primary">Nhập địa chỉ giao hàng mới bên dưới</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="card border-0 rounded-4 shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-person-vcard me-2"></i>Thông tin người nhận
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" for="inpReceiverName">Họ tên người nhận <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.ReceiverName, new { @class = "form-control rounded-3", placeholder = "Nguyễn Văn A", id = "inpReceiverName" })
                                @Html.ValidationMessageFor(m => m.ReceiverName, "", new { @class = "text-danger small" })
                                <div class="invalid-feedback" id="errReceiverName">Vui lòng nhập họ tên người nhận.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" for="phoneInput">Số điện thoại <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control rounded-3", id = "phoneInput", maxlength = "10", placeholder = "0901234567" })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                                <div class="invalid-feedback" id="errPhone">Vui lòng nhập số điện thoại nhận hàng.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small" for="inpProvince">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <div class="vn-combo-wrap">
                                    @Html.TextBoxFor(m => m.Province, new { @class = "form-control rounded-3 pe-5", placeholder = "Chọn hoặc nhập Tỉnh/TP", id = "inpProvince", autocomplete = "off" })
                                    <button type="button" class="vn-combo-toggle" data-target="menuProvince" tabindex="-1" aria-label="Mở danh sách Tỉnh / Thành phố">
                                        <i class="bi bi-chevron-down small"></i>
                                    </button>
                                    <div class="vn-combo-menu" id="menuProvince"></div>
                                    <div class="invalid-feedback" id="errProvince">Vui lòng chọn hoặc nhập Tỉnh / Thành phố.</div>
                                </div>
                                @Html.ValidationMessageFor(m => m.Province, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small" for="inpDistrict">Quận / Huyện <span class="text-danger">*</span></label>
                                <div class="vn-combo-wrap">
                                    @Html.TextBoxFor(m => m.District, new { @class = "form-control rounded-3 pe-5", placeholder = "Chọn hoặc nhập Quận/Huyện", id = "inpDistrict", autocomplete = "off" })
                                    <button type="button" class="vn-combo-toggle" data-target="menuDistrict" tabindex="-1" aria-label="Mở danh sách Quận / Huyện">
                                        <i class="bi bi-chevron-down small"></i>
                                    </button>
                                    <div class="vn-combo-menu" id="menuDistrict"></div>
                                    <div class="invalid-feedback" id="errDistrict">Vui lòng chọn hoặc nhập Quận / Huyện.</div>
                                </div>
                                @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small" for="inpWard">Phường / Xã <span class="text-danger">*</span></label>
                                <div class="vn-combo-wrap">
                                    @Html.TextBoxFor(m => m.Ward, new { @class = "form-control rounded-3 pe-5", placeholder = "Chọn hoặc nhập Phường/Xã", id = "inpWard", autocomplete = "off" })
                                    <button type="button" class="vn-combo-toggle" data-target="menuWard" tabindex="-1" aria-label="Mở danh sách Phường / Xã">
                                        <i class="bi bi-chevron-down small"></i>
                                    </button>
                                    <div class="vn-combo-menu" id="menuWard"></div>
                                    <div class="invalid-feedback" id="errWard">Vui lòng chọn hoặc nhập Phường / Xã.</div>
                                </div>
                                @Html.ValidationMessageFor(m => m.Ward, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small" for="inpAddress">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control rounded-3", placeholder = "Số nhà, tên đường...", id = "inpAddress" })
                                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                                <div class="invalid-feedback" id="errAddress">Vui lòng nhập địa chỉ cụ thể (số nhà, tên đường...).</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Ghi chú giao hàng</label>
                                @Html.TextAreaFor(m => m.Note, new { @class = "form-control rounded-3", rows = 2, placeholder = "Giao giờ hành chính, gọi trước khi giao..." })
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.SaveToAddressBook, new { @class = "form-check-input", id = "chkSaveAddr" })
                                    <label class="form-check-label small" for="chkSaveAddr">Lưu địa chỉ mới này vào sổ địa chỉ</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PHƯƠNG THỨC THANH TOÁN (Tách biệt giao diện COD vs Chuyển khoản) -->
                <div class="card border-0 rounded-4 shadow-sm">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-wallet2 me-2"></i>Phương thức thanh toán
                    </div>
                    <div class="card-body p-4 d-flex flex-column gap-3">
                        <!-- Lựa chọn 1: COD -->
                        <label id="cardCOD" class="payment-option-card border rounded-3 p-3 @(!isBankSelected ? "active" : "")" for="pmCOD">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="pmCOD" value="@PaymentMethods.COD"
                                           @(!isBankSelected ? "checked" : "") />
                                    <span class="form-check-label fw-bold text-dark">Thanh toán khi nhận hàng (COD)</span>
                                </div>
                                <i class="bi bi-cash-coin fs-4 text-success"></i>
                            </div>
                            <div id="codInfoBox" class="small text-muted mt-2 ps-4 @(isBankSelected ? "d-none" : "")">
                                <i class="bi bi-info-circle me-1"></i>Bạn sẽ thanh toán bằng tiền mặt trực tiếp cho nhân viên giao hàng khi kiểm tra và nhận đơn.
                            </div>
                        </label>

                        <!-- Lựa chọn 2: Chuyển khoản ngân hàng -->
                        <div id="cardBank" class="payment-option-card border rounded-3 p-3 @(isBankSelected ? "active" : "")">
                            <label class="d-flex justify-content-between align-items-center w-100" for="pmBank" style="cursor: pointer;">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="pmBank" value="@PaymentMethods.BankTransfer"
                                           @(isBankSelected ? "checked" : "") />
                                    <span class="form-check-label fw-bold text-dark">Chuyển khoản ngân hàng (VietQR)</span>
                                </div>
                                <i class="bi bi-qr-code-scan fs-4 text-primary"></i>
                            </label>

                            <!-- Khung chi tiết chuyển khoản: chỉ hiện khi chọn Ngân hàng -->
                            <div id="bankInfoBox" class="mt-3 pt-3 border-top @(isBankSelected ? "" : "d-none")">
                                <div class="row g-3 align-items-center">
                                    <div class="col-sm-4 text-center">
                                        <div class="bg-white border rounded-3 p-2 d-inline-block">
                                            <img id="bankQrImg"
                                                 src="https://img.vietqr.io/image/VCB-0123456789-compact2.png?amount=@((long)total)&addInfo=CLOTHINGSHOP%20@(Uri.EscapeDataString(Model.Phone ?? ""))&accountName=CLOTHINGSHOP%20VN"
                                                 alt="Mã QR chuyển khoản Vietcombank"
                                                 class="img-fluid rounded-2"
                                                 style="max-width: 150px;"
                                                 onerror="this.parentElement.style.display='none';" />
                                        </div>
                                        <div class="text-muted mt-1" style="font-size: 0.72rem;">Quét bằng app ngân hàng</div>
                                    </div>
                                    <div class="col-sm-8">
                                        <div class="bg-light rounded-3 p-3 small">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">Ngân hàng:</span>
                                                <strong class="text-dark">Vietcombank (VCB)</strong>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted">Số tài khoản:</span>
                                                <span class="d-flex align-items-center gap-2">
                                                    <strong id="bankAccountNumber" class="text-dark">0123456789</strong>
                                                    <button type="button" id="btnCopyStk" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.72rem;">
                                                        Sao chép
                                                    </button>
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">Chủ tài khoản:</span>
                                                <strong class="text-dark">CLOTHINGSHOP VN</strong>
                                            </div>
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">Số tiền chuyển:</span>
                                                <strong id="bankTransferAmount" class="text-danger fs-6">@PriceFormatter.Vnd(total)</strong>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">Nội dung CK:</span>
                                                <strong id="bankTransferContent" class="text-primary">CLOTHINGSHOP @(string.IsNullOrWhiteSpace(Model.Phone) ? "DONHANG" : Model.Phone)</strong>
                                            </div>
                                        </div>
                                        <div class="small text-success mt-2">
                                            <i class="bi bi-shield-check me-1"></i>Đơn hàng chuyển khoản sẽ được ghi nhận <strong>Đã thanh toán</strong> và ưu tiên đóng gói sớm.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="errPaymentMethod" class="text-danger small d-none">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng chọn phương thức thanh toán.
                        </div>
                        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: Tóm tắt đơn hàng (cuộn theo nhưng luôn nằm dưới Header) -->
            <div class="col-lg-5">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden checkout-summary-sticky">
                    <div class="card-header bg-obsidian text-white fw-bold py-3">
                        Đơn hàng của bạn (@cartItems.Sum(x => x.Quantity) sản phẩm)
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in cartItems)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold small">@item.ProductName</div>
                                        <small class="text-muted">@item.Size / @item.Color &times; @item.Quantity</small>
                                    </div>
                                    <span class="fw-semibold small">@PriceFormatter.Vnd(item.TotalPrice)</span>
                                </li>
                            }
                        </ul>

                        <!-- Thanh bấm chọn Voucher -->
                        <div class="mb-3">
                            @Html.HiddenFor(m => m.CouponCode, new { id = "couponInput" })

                            <div class="d-flex justify-content-between align-items-center border rounded-3 p-3 bg-light voucher-trigger-box"
                                 role="button"
                                 tabindex="0"
                                 data-bs-toggle="modal"
                                 data-bs-target="#voucherModal">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-ticket-perforated-fill text-danger fs-5"></i>
                                    <span class="fw-semibold small text-dark">Mã khuyến mãi</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span id="voucherTriggerBadge" class="text-muted small">
                                        @(usableCoupons.Any() ? $"Chọn mã ({usableCoupons.Count} khả dụng)" : "Chọn hoặc nhập mã")
                                    </span>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                </div>
                            </div>

                            @Html.ValidationMessageFor(m => m.CouponCode, "", new { @class = "text-danger small d-block mt-1" })

                            <div id="appliedVoucherNotice" class="d-none mt-2 px-2 py-1 rounded bg-success-subtle text-success small d-flex justify-content-between align-items-center">
                                <span id="appliedVoucherText"></span>
                                <button type="button" id="btnRemoveVoucher" class="btn btn-link btn-sm text-danger p-0 text-decoration-none fw-semibold">Gỡ mã</button>
                            </div>
                        </div>

                        <!-- Chi tiết thanh toán -->
                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted">Tạm tính tiền hàng:</span>
                                <span>@PriceFormatter.Vnd(subTotal)</span>
                            </div>

                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <span>@(isFreeShip ? PriceFormatter.Vnd(30000m) : PriceFormatter.Vnd(shippingFee))</span>
                            </div>

                            @if (isFreeShip)
                            {
                                <div class="d-flex justify-content-between small mb-2">
                                    <span class="text-muted">Giảm giá phí vận chuyển:</span>
                                    <span class="text-danger">-@PriceFormatter.Vnd(30000m)</span>
                                </div>
                            }

                            <div id="discountRow" class="d-flex justify-content-between align-items-center small mb-2 d-none">
                                <span class="text-muted">
                                    Voucher giảm giá
                                    <span id="appliedCouponBadge" class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"></span>
                                </span>
                                <span id="discountAmountText" class="text-danger fw-semibold">-0₫</span>
                            </div>

                            <hr class="my-3" />

                            <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                                <span>Tổng thanh toán:</span>
                                <span id="finalTotalText" class="text-danger font-display">@PriceFormatter.Vnd(total)</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" id="btnSubmitOrder" class="btn btn-dark btn-lg rounded-pill fw-bold">
                                <i class="bi bi-check2-circle me-1"></i>
                                <span id="btnSubmitLabel">@(isBankSelected ? "XÁC NHẬN CHUYỂN KHOẢN & ĐẶT HÀNG" : "XÁC NHẬN ĐẶT HÀNG")</span>
                                (<span id="btnTotalText">@PriceFormatter.Vnd(total)</span>)
                            </button>
                            <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary btn-sm rounded-pill">Quay lại giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL CHỌN & NHẬP MÃ KHUYẾN MÃI -->
<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="voucherModalLabel">
                    <i class="bi bi-ticket-perforated-fill text-danger me-2"></i>Chọn ClothingShop Voucher
                </h5>
                <button type="button" id="btnCloseVoucherModal" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body bg-light">
                <div class="bg-white p-3 rounded-3 border mb-3">
                    <div class="input-group input-group-sm">
                        <input type="text" id="modalManualCode" class="form-control text-uppercase" placeholder="Nhập mã khuyến mãi (VD: SALE10, NEWUSER)..." />
                        <button type="button" id="btnManualApply" class="btn btn-dark px-3 fw-semibold">Áp dụng</button>
                    </div>
                    <div id="modalManualMsg" class="small mt-2"></div>
                </div>

                <div class="fw-semibold small text-dark mb-2">Mã giảm giá khả dụng (@usableCoupons.Count)</div>
                @if (!usableCoupons.Any())
                {
                    <div class="bg-white border rounded-3 p-3 small text-muted mb-3">
                        Hiện chưa có mã nào đủ điều kiện cho đơn hàng này.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var c in usableCoupons)
                        {
                            decimal discount = Math.Round(subTotal * (c.DiscountPercent / 100m), 0);
                            if (discount > subTotal) { discount = subTotal; }
                            int usedPct = c.UsageLimit > 0 ? Math.Min(100, (int)Math.Round(c.UsedCount * 100.0 / c.UsageLimit)) : 0;

                            <div class="voucher-card"
                                 data-usable="true"
                                 data-code="@c.Code.ToUpper()"
                                 data-percent="@c.DiscountPercent"
                                 data-discount="@((long)discount)"
                                 data-reason="">
                                @if (c.CouponId == bestCouponId)
                                {
                                    <span class="voucher-best-tag">Lựa chọn tốt nhất</span>
                                }
                                <div class="voucher-stub">
                                    <div class="voucher-stub__percent">-@c.DiscountPercent%</div>
                                    <div class="voucher-stub__label">VOUCHER</div>
                                </div>
                                <div class="voucher-body">
                                    <div class="pe-2">
                                        <div class="fw-bold text-dark">
                                            Giảm @c.DiscountPercent%
                                            <span class="badge bg-light text-dark border ms-1">@c.Code</span>
                                        </div>
                                        <div class="small text-secondary">
                                            Đơn tối thiểu @PriceFormatter.Vnd(c.MinOrder) &bull; Giảm <strong class="text-danger">@PriceFormatter.Vnd(discount)</strong>
                                        </div>
                                        <div class="progress my-1" style="height: 4px;">
                                            <div class="progress-bar bg-danger" style="width: @usedPct%;"></div>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            Đã dùng @usedPct% &bull; HSD: @c.EndDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                    <div class="voucher-radio"></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (unavailableCoupons.Any())
                {
                    <div class="fw-semibold small text-muted mt-3 mb-2">Voucher không khả dụng (@unavailableCoupons.Count)</div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var c in unavailableCoupons)
                        {
                            string reason;
                            if (!c.IsActive)
                            {
                                reason = "Mã giảm giá hiện đã bị khóa.";
                            }
                            else if (today > c.EndDate.Date)
                            {
                                reason = $"Mã đã hết hạn vào ngày {c.EndDate:dd/MM/yyyy}.";
                            }
                            else if (today < c.StartDate.Date)
                            {
                                reason = $"Mã bắt đầu áp dụng từ ngày {c.StartDate:dd/MM/yyyy}.";
                            }
                            else if (c.UsedCount >= c.UsageLimit)
                            {
                                reason = "Mã giảm giá đã hết lượt sử dụng.";
                            }
                            else if (subTotal < c.MinOrder)
                            {
                                reason = $"Mua thêm {PriceFormatter.Vnd(c.MinOrder - subTotal)} để đạt đơn tối thiểu {PriceFormatter.Vnd(c.MinOrder)}.";
                            }
                            else
                            {
                                reason = "Đơn hàng chưa thỏa điều kiện áp dụng mã này.";
                            }

                            <div class="border rounded-3 overflow-hidden bg-white">
                                <div class="voucher-card disabled border-0 rounded-0"
                                     data-usable="false"
                                     data-code="@c.Code.ToUpper()"
                                     data-percent="@c.DiscountPercent"
                                     data-discount="0"
                                     data-reason="@reason">
                                    <div class="voucher-stub">
                                        <div class="voucher-stub__percent">-@c.DiscountPercent%</div>
                                        <div class="voucher-stub__label">KHÔNG KHẢ DỤNG</div>
                                    </div>
                                    <div class="voucher-body">
                                        <div>
                                            <div class="fw-bold text-secondary">
                                                Giảm @c.DiscountPercent%
                                                <span class="badge bg-light text-secondary border ms-1">@c.Code</span>
                                            </div>
                                            <div class="small text-muted">Đơn tối thiểu @PriceFormatter.Vnd(c.MinOrder)</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">HSD: @c.EndDate.ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <div class="voucher-radio"></div>
                                    </div>
                                </div>
                                <div class="voucher-reason">
                                    <i class="bi bi-exclamation-circle me-1"></i>@reason
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer flex-column align-items-stretch bg-white border-top">
                <div id="modalSelectionSummary" class="small text-secondary mb-2">
                    Chưa chọn voucher nào.
                </div>
                <button type="button" id="btnConfirmVoucher" class="btn btn-dark rounded-pill fw-semibold py-2 w-100" data-bs-dismiss="modal">
                    Đồng ý
                </button>
            </div>
        </div>
    </div>
</div>

<style>
