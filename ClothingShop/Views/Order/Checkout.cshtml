@section scripts {
    <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var pageEl = document.getElementById('checkoutPage');
                    var subTotal = pageEl ? (Number(pageEl.getAttribute('data-subtotal')) || 0) : 0;
                    var shippingFee = pageEl ? (Number(pageEl.getAttribute('data-shipping')) || 0) : 0;
                    var baseTotal = subTotal + shippingFee;
                    var currentFinalTotal = baseTotal;

                    var couponInput = document.getElementById('couponInput');
                    var phoneInput = document.getElementById('phoneInput');
                    var triggerBadge = document.getElementById('voucherTriggerBadge');
                    var defaultBadgeText = triggerBadge ? (triggerBadge.textContent || 'Chọn hoặc nhập mã').trim() : 'Chọn hoặc nhập mã';

                    var appliedNotice = document.getElementById('appliedVoucherNotice');
                    var appliedText = document.getElementById('appliedVoucherText');
                    var discountRow = document.getElementById('discountRow');
                    var appliedCouponBadge = document.getElementById('appliedCouponBadge');
                    var discountAmountText = document.getElementById('discountAmountText');
                    var finalTotalText = document.getElementById('finalTotalText');
                    var btnTotalText = document.getElementById('btnTotalText');
                    var btnSubmitLabel = document.getElementById('btnSubmitLabel');

                    // Phần tử thanh toán COD / Ngân hàng
                    var pmCOD = document.getElementById('pmCOD');
                    var pmBank = document.getElementById('pmBank');
                    var cardCOD = document.getElementById('cardCOD');
                    var cardBank = document.getElementById('cardBank');
                    var codInfoBox = document.getElementById('codInfoBox');
                    var bankInfoBox = document.getElementById('bankInfoBox');
                    var bankTransferAmount = document.getElementById('bankTransferAmount');
                    var bankTransferContent = document.getElementById('bankTransferContent');
                    var bankQrImg = document.getElementById('bankQrImg');
                    var btnCopyStk = document.getElementById('btnCopyStk');

                    // Phần tử Modal Voucher
                    var modalSummary = document.getElementById('modalSelectionSummary');
                    var manualInput = document.getElementById('modalManualCode');
                    var manualMsg = document.getElementById('modalManualMsg');
                    var btnManualApply = document.getElementById('btnManualApply');
                    var btnConfirm = document.getElementById('btnConfirmVoucher');
                    var btnRemove = document.getElementById('btnRemoveVoucher');
                    var btnCloseModal = document.getElementById('btnCloseVoucherModal');

                    var allCards = document.querySelectorAll('.voucher-card');
                    var tempSelectedCode = '';

                    function formatVnd(amount = 0) {
                        return Math.round(Number(amount) || 0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '₫';
                    }

                    // Dùng vòng lặp for trả về trực tiếp để hết lỗi TypeScript 'never'
                    function findCardByCode(code = '') {
                        var target = code.trim().toUpperCase();
                        for (var i = 0; i < allCards.length; i++) {
                            var card = allCards[i];
                            if ((card.getAttribute('data-code') || '').toUpperCase() === target) {
                                return card;
                            }
                        }
                        return null;
                    }

                    // Đồng bộ số tiền & nội dung chuyển khoản + QR mỗi khi tổng tiền hoặc SĐT thay đổi
                    function syncBankTransferInfo() {
                        var phoneVal = (phoneInput instanceof HTMLInputElement && phoneInput.value.trim())
                            ? phoneInput.value.trim()
                            : 'DONHANG';
                        var contentText = 'CLOTHINGSHOP ' + phoneVal;

                        if (bankTransferAmount) {
                            bankTransferAmount.textContent = formatVnd(currentFinalTotal);
                        }
                        if (bankTransferContent) {
                            bankTransferContent.textContent = contentText;
                        }
                        if (bankQrImg instanceof HTMLImageElement) {
                            bankQrImg.src = 'https://img.vietqr.io/image/VCB-0123456789-compact2.png?amount='
                                + Math.round(currentFinalTotal)
                                + '&addInfo=' + encodeURIComponent(contentText)
                                + '&accountName=CLOTHINGSHOP%20VN';
                        }
                    }

                    // Bật/tắt giao diện COD và Chuyển khoản ngân hàng
                    function updatePaymentMethodUI() {
                        var isBank = (pmBank instanceof HTMLInputElement) && pmBank.checked;

                        if (cardCOD) cardCOD.classList.toggle('active', !isBank);
                        if (cardBank) cardBank.classList.toggle('active', isBank);
                        if (codInfoBox) codInfoBox.classList.toggle('d-none', isBank);
                        if (bankInfoBox) bankInfoBox.classList.toggle('d-none', !isBank);

                        if (btnSubmitLabel) {
                            btnSubmitLabel.textContent = isBank
                                ? 'XÁC NHẬN CHUYỂN KHOẢN & ĐẶT HÀNG'
                                : 'XÁC NHẬN ĐẶT HÀNG';
                        }
                        if (isBank) {
                            syncBankTransferInfo();
                        }
                    }

                    if (pmCOD) pmCOD.addEventListener('change', updatePaymentMethodUI);
                    if (pmBank) pmBank.addEventListener('change', updatePaymentMethodUI);
                    if (phoneInput instanceof HTMLInputElement) {
                        phoneInput.addEventListener('input', syncBankTransferInfo);
                    }

                    if (btnCopyStk) {
                        btnCopyStk.addEventListener('click', function () {
                            var stkEl = document.getElementById('bankAccountNumber');
                            var stk = stkEl ? (stkEl.textContent || '').trim() : '0123456789';
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                navigator.clipboard.writeText(stk);
                            }
                            btnCopyStk.textContent = 'Đã chép';
                            setTimeout(function () {
                                btnCopyStk.textContent = 'Sao chép';
                            }, 1500);
                        });
                    }

                    function updateModalSummary(code = '', discount = 0) {
                        if (!modalSummary) return;
                        if (code) {
                            modalSummary.innerHTML = 'Đã chọn <strong>1 Voucher (' + code + ')</strong> &bull; Tiết kiệm <strong class="text-danger">-' + formatVnd(discount) + '</strong>';
                        } else {
                            modalSummary.textContent = 'Chưa chọn voucher nào.';
                        }
                    }

                    function highlightSelectedCard(code = '') {
                        var target = code.trim().toUpperCase();
                        for (var i = 0; i < allCards.length; i++) {
                            var card = allCards[i];
                            if (card.getAttribute('data-usable') !== 'true') continue;
                            var radio = card.querySelector('.voucher-radio');
                            var isMatch = (card.getAttribute('data-code') || '').toUpperCase() === target;
                            if (isMatch) {
                                card.classList.add('selected');
                                if (radio) radio.innerHTML = '<i class="bi bi-check-lg"></i>';
                            } else {
                                card.classList.remove('selected');
                                if (radio) radio.innerHTML = '';
                            }
                        }
                    }

                    function applyVoucherToUI(code = '', percent = 0, discount = 0) {
                        currentFinalTotal = Math.max(0, baseTotal - discount);

                        if (couponInput instanceof HTMLInputElement) {
                            couponInput.value = code;
                        }
                        if (triggerBadge) {
                            triggerBadge.className = 'voucher-pill-active';
                            triggerBadge.textContent = code + ' (-' + formatVnd(discount) + ')';
                        }
                        if (appliedCouponBadge) {
                            appliedCouponBadge.textContent = code + ' (-' + percent + '%)';
                        }
                        if (discountAmountText) {
                            discountAmountText.textContent = '-' + formatVnd(discount);
                        }
                        if (discountRow) {
                            discountRow.classList.remove('d-none');
                        }
                        if (finalTotalText) {
                            finalTotalText.textContent = formatVnd(currentFinalTotal);
                        }
                        if (btnTotalText) {
                            btnTotalText.textContent = formatVnd(currentFinalTotal);
                        }
                        if (appliedText) {
                            appliedText.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Đã áp dụng mã <strong>' + code + '</strong> (-' + percent + '%)';
                        }
                        if (appliedNotice) {
                            appliedNotice.classList.remove('d-none');
                        }

                        tempSelectedCode = code;
                        highlightSelectedCard(code);
                        updateModalSummary(code, discount);
                        syncBankTransferInfo();
                    }

                    function clearVoucherFromUI() {
                        currentFinalTotal = baseTotal;

                        if (couponInput instanceof HTMLInputElement) {
                            couponInput.value = '';
                        }
                        if (triggerBadge) {
                            triggerBadge.className = 'text-muted small';
                            triggerBadge.textContent = defaultBadgeText;
                        }
                        if (discountRow) {
                            discountRow.classList.add('d-none');
                        }
                        if (appliedNotice) {
                            appliedNotice.classList.add('d-none');
                        }
                        if (finalTotalText) {
                            finalTotalText.textContent = formatVnd(baseTotal);
                        }
                        if (btnTotalText) {
                            btnTotalText.textContent = formatVnd(baseTotal);
                        }

                        tempSelectedCode = '';
                        highlightSelectedCard('');
                        updateModalSummary('', 0);
                        syncBankTransferInfo();
                    }

                    // Chọn 1 voucher khả dụng
                    for (var i = 0; i < allCards.length; i++) {
                        (function (card) {
                            if (card.getAttribute('data-usable') !== 'true') return;

                            card.addEventListener('click', function () {
                                var code = (card.getAttribute('data-code') || '').toUpperCase();
                                var discount = Number(card.getAttribute('data-discount')) || 0;

                                if (tempSelectedCode === code) {
                                    tempSelectedCode = '';
                                    highlightSelectedCard('');
                                    updateModalSummary('', 0);
                                } else {
                                    tempSelectedCode = code;
                                    highlightSelectedCard(code);
                                    updateModalSummary(code, discount);
                                }
                                if (manualMsg) manualMsg.innerHTML = '';
                            });
                        })(allCards[i]);
                    }

                    // Bấm "Đồng ý" trong Modal
                    if (btnConfirm) {
                        btnConfirm.addEventListener('click', function () {
                            if (!tempSelectedCode) {
                                clearVoucherFromUI();
                                return;
                            }
                            var card = findCardByCode(tempSelectedCode);
                            if (card && card.getAttribute('data-usable') === 'true') {
                                var percent = Number(card.getAttribute('data-percent')) || 0;
                                var discount = Number(card.getAttribute('data-discount')) || 0;
                                applyVoucherToUI(tempSelectedCode, percent, discount);
                            }
                        });
                    }

                    // Nhập mã trực tiếp trong Modal
                    function handleManualApply() {
                        if (!(manualInput instanceof HTMLInputElement)) return;
                        var code = manualInput.value.trim().toUpperCase();

                        if (!code) {
                            if (manualMsg) {
                                manualMsg.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Vui lòng nhập mã khuyến mãi.</span>';
                            }
                            return;
                        }

                        var matchedCard = findCardByCode(code);
                        if (!matchedCard) {
                            if (manualMsg) {
                                manualMsg.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Mã "' + code + '" không tồn tại.</span>';
                            }
                            return;
                        }

                        if (matchedCard.getAttribute('data-usable') !== 'true') {
                            var reason = matchedCard.getAttribute('data-reason') || 'Mã không đủ điều kiện áp dụng.';
                            if (manualMsg) {
                                manualMsg.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>' + reason + '</span>';
                            }
                            return;
                        }

                        var percent = Number(matchedCard.getAttribute('data-percent')) || 0;
                        var discount = Number(matchedCard.getAttribute('data-discount')) || 0;
                        applyVoucherToUI(code, percent, discount);

                        manualInput.value = '';
                        if (manualMsg) manualMsg.innerHTML = '';
                        if (btnCloseModal instanceof HTMLElement) {
                            btnCloseModal.click();
                        }
                    }

                    if (btnManualApply) btnManualApply.addEventListener('click', handleManualApply);

                    if (manualInput instanceof HTMLInputElement) {
                        manualInput.addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                handleManualApply();
                            }
                        });
                    }

                    if (btnRemove) {
                        btnRemove.addEventListener('click', clearVoucherFromUI);
                    }

                    // Khôi phục trạng thái nếu reload do lỗi validation
                    if (couponInput instanceof HTMLInputElement && couponInput.value.trim()) {
                        var savedCard = findCardByCode(couponInput.value);
                        if (savedCard && savedCard.getAttribute('data-usable') === 'true') {
                            var code = (savedCard.getAttribute('data-code') || '').toUpperCase();
                            var percent = Number(savedCard.getAttribute('data-percent')) || 0;
                            var discount = Number(savedCard.getAttribute('data-discount')) || 0;
                            applyVoucherToUI(code, percent, discount);
                        }
                    }

                    updatePaymentMethodUI();
                });
    </script>
    <script src="@Url.Content("~/Content/data/vietnam-provinces.js")"></script>
    <script>
        (function () {
            // 1. Editable Cascading Combobox (63 Tỉnh/Thành, Quận/Huyện, Phường/Xã) - dữ liệu tĩnh cục bộ
            var vnData = window.VN_PROVINCES || [];
            var inpProvince = document.getElementById('inpProvince');
            var inpDistrict = document.getElementById('inpDistrict');
            var inpWard = document.getElementById('inpWard');
            var menuProvince = document.getElementById('menuProvince');
            var menuDistrict = document.getElementById('menuDistrict');
            var menuWard = document.getElementById('menuWard');

            function normalizeVn(str) {
                return (str || '')
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd')
                    .trim();
            }

            function findProvince(name) {
                var key = normalizeVn(name);
                if (!key) return null;
                return vnData.find(function (p) { return normalizeVn(p.n) === key; }) || null;
            }

            function findDistrict(prov, name) {
                if (!prov || !prov.d) return null;
                var key = normalizeVn(name);
                if (!key) return null;
                return prov.d.find(function (d) { return normalizeVn(d.n) === key; }) || null;
            }

            function closeAllMenus(exceptMenu) {
                [menuProvince, menuDistrict, menuWard].forEach(function (m) {
                    if (m && m !== exceptMenu) m.style.display = 'none';
                });
            }

            function renderComboMenu(menu, items, query, onSelect) {
                if (!menu) return;
                var q = normalizeVn(query);
                var filtered = q
                    ? items.filter(function (item) { return normalizeVn(item).indexOf(q) !== -1; })
                    : items;

                if (filtered.length === 0) {
                    menu.innerHTML = '<div class="px-3 py-2 small text-muted">Không có gợi ý khớp — bạn vẫn có thể tự nhập</div>';
                    menu.style.display = 'block';
                    return;
                }

                menu.innerHTML = '';
                filtered.slice(0, 80).forEach(function (item) {
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'vn-combo-item';
                    btn.textContent = item;
                    btn.addEventListener('mousedown', function (ev) {
                        ev.preventDefault();
                        onSelect(item);
                        menu.style.display = 'none';
                    });
                    menu.appendChild(btn);
                });
                menu.style.display = 'block';
            }

            function getProvinceNames() {
                return vnData.map(function (p) { return p.n; });
            }

            function getDistrictNames() {
                var p = findProvince(inpProvince ? inpProvince.value : '');
                return p && p.d ? p.d.map(function (d) { return d.n; }) : [];
            }

            function getWardNames() {
                var p = findProvince(inpProvince ? inpProvince.value : '');
                var d = findDistrict(p, inpDistrict ? inpDistrict.value : '');
                return d && d.w ? d.w : [];
            }

            function bindCombo(input, menu, getItems, onSelected) {
                if (!input || !menu) return;
                input.addEventListener('focus', function () {
                    closeAllMenus(menu);
                    renderComboMenu(menu, getItems(), input.value, onSelected);
                });
                input.addEventListener('input', function () {
                    closeAllMenus(menu);
                    renderComboMenu(menu, getItems(), input.value, onSelected);
                });
            }

            bindCombo(inpProvince, menuProvince, getProvinceNames, function (val) {
                inpProvince.value = val;
                if (inpDistrict) { inpDistrict.value = ''; clearFieldError(inpDistrict); }
                if (inpWard) { inpWard.value = ''; clearFieldError(inpWard); }
                clearFieldError(inpProvince);
                validateOneField('inpProvince');
            });

            bindCombo(inpDistrict, menuDistrict, getDistrictNames, function (val) {
                inpDistrict.value = val;
                if (inpWard) { inpWard.value = ''; clearFieldError(inpWard); }
                clearFieldError(inpDistrict);
                validateOneField('inpDistrict');
            });

            bindCombo(inpWard, menuWard, getWardNames, function (val) {
                inpWard.value = val;
                clearFieldError(inpWard);
                validateOneField('inpWard');
            });

            document.querySelectorAll('.vn-combo-toggle').forEach(function (btn) {
                btn.addEventListener('click', function (ev) {
                    ev.stopPropagation();
                    var targetId = btn.getAttribute('data-target');
                    var menu = document.getElementById(targetId);
                    if (!menu) return;
                    var isOpen = menu.style.display === 'block';
                    closeAllMenus(null);
                    if (!isOpen) {
                        if (targetId === 'menuProvince') {
                            renderComboMenu(menu, getProvinceNames(), '', function (val) {
                                inpProvince.value = val;
                                if (inpDistrict) inpDistrict.value = '';
                                if (inpWard) inpWard.value = '';
                                validateOneField('inpProvince');
                            });
                            inpProvince.focus();
                        } else if (targetId === 'menuDistrict') {
                            renderComboMenu(menu, getDistrictNames(), '', function (val) {
                                inpDistrict.value = val;
                                if (inpWard) inpWard.value = '';
                                validateOneField('inpDistrict');
                            });
                            inpDistrict.focus();
                        } else if (targetId === 'menuWard') {
                            renderComboMenu(menu, getWardNames(), '', function (val) {
                                inpWard.value = val;
                                validateOneField('inpWard');
                            });
                            inpWard.focus();
                        }
                    }
                });
            });

            document.addEventListener('click', function (ev) {
                if (!ev.target.closest('.vn-combo-wrap')) {
                    closeAllMenus(null);
                }
            });

            // Dữ liệu vnData đã được nạp tĩnh từ vietnam-provinces.js

            // 2. Form Validation (Client-side đồng bộ Server-side)
            var form = document.getElementById('checkoutForm');
            var summaryBox = document.getElementById('checkoutErrorSummary');
            var summaryText = document.getElementById('checkoutErrorSummaryText');

            function setFieldError(input, errEl, msg) {
                if (!input) return;
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (errEl) errEl.textContent = msg;
            }

            function clearFieldError(input) {
                if (!input) return;
                input.classList.remove('is-invalid');
            }

            function setFieldValid(input) {
                if (!input) return;
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
            }

            function isNewAddressSelected() {
                var selAddr = document.querySelector('input[name="SelectedAddressId"]:checked');
                return !selAddr || selAddr.value === '0';
            }

            function validateOneField(id) {
                var el = document.getElementById(id);
                if (!el) return true;
                var val = (el.value || '').trim();

                if (id === 'inpReceiverName') {
                    var err = document.getElementById('errReceiverName');
                    if (!val) { setFieldError(el, err, 'Vui lòng nhập họ tên người nhận.'); return false; }
                    if (val.length < 2 || !/^[A-Za-zÀ-ỹ\s'.-]{2,100}$/.test(val)) {
                        setFieldError(el, err, 'Họ tên người nhận tối thiểu 2 ký tự và không chứa ký tự đặc biệt bất thường.');
                        return false;
                    }
                    setFieldValid(el);
                    return true;
                }

                if (id === 'phoneInput') {
                    var errPhone = document.getElementById('errPhone');
                    if (!val) { setFieldError(el, errPhone, 'Vui lòng nhập số điện thoại nhận hàng.'); return false; }
                    if (!/^0\d{9}$/.test(val)) {
                        setFieldError(el, errPhone, 'Số điện thoại không hợp lệ (gồm 10 chữ số, bắt đầu bằng số 0).');
                        return false;
                    }
                    setFieldValid(el);
                    return true;
                }

                if (id === 'inpProvince') {
                    var errP = document.getElementById('errProvince');
                    if (!val) { setFieldError(el, errP, 'Vui lòng chọn hoặc nhập Tỉnh / Thành phố.'); return false; }
                    setFieldValid(el);
                    return true;
                }

                if (id === 'inpDistrict') {
                    var errD = document.getElementById('errDistrict');
                    if (!val) { setFieldError(el, errD, 'Vui lòng chọn hoặc nhập Quận / Huyện.'); return false; }
                    setFieldValid(el);
                    return true;
                }

                if (id === 'inpWard') {
                    var errW = document.getElementById('errWard');
                    if (!val) { setFieldError(el, errW, 'Vui lòng chọn hoặc nhập Phường / Xã.'); return false; }
                    setFieldValid(el);
                    return true;
                }

                if (id === 'inpAddress') {
                    var errA = document.getElementById('errAddress');
                    if (!val || val.length < 5) {
                        setFieldError(el, errA, 'Vui lòng nhập địa chỉ cụ thể (số nhà, tên đường...).');
                        return false;
                    }
                    setFieldValid(el);
                    return true;
                }

                return true;
            }

            var fieldIds = ['inpReceiverName', 'phoneInput', 'inpProvince', 'inpDistrict', 'inpWard', 'inpAddress'];
            fieldIds.forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', function () {
                    if (el.classList.contains('is-invalid')) {
                        validateOneField(id);
                    }
                    if (summaryBox && !document.querySelector('.is-invalid')) {
                        summaryBox.classList.add('d-none');
                        summaryBox.classList.remove('d-flex');
                    }
                });
                el.addEventListener('blur', function () {
                    if (isNewAddressSelected() && el.value.trim() !== '') {
                        validateOneField(id);
                    }
                });
            });

            // Reset lỗi khi đổi lựa chọn địa chỉ trong sổ địa chỉ
            document.querySelectorAll('input[name="SelectedAddressId"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    fieldIds.forEach(function (id) { clearFieldError(document.getElementById(id)); });
                    if (summaryBox) {
                        summaryBox.classList.add('d-none');
                        summaryBox.classList.remove('d-flex');
                    }
                });
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    var allValid = true;
                    var firstInvalidEl = null;

                    if (isNewAddressSelected()) {
                        fieldIds.forEach(function (id) {
                            var ok = validateOneField(id);
                            if (!ok) {
                                allValid = false;
                                if (!firstInvalidEl) firstInvalidEl = document.getElementById(id);
                            }
                        });
                    }

                    // Kiểm tra phương thức thanh toán
                    var pmChecked = document.querySelector('input[name="PaymentMethod"]:checked');
                    var pmErr = document.getElementById('errPaymentMethod');
                    if (!pmChecked) {
                        allValid = false;
                        if (pmErr) pmErr.classList.remove('d-none');
                        if (!firstInvalidEl) firstInvalidEl = document.getElementById('cardCOD');
                    } else if (pmErr) {
                        pmErr.classList.add('d-none');
                    }

                    if (!allValid) {
                        e.preventDefault();
                        if (summaryBox && summaryText) {
                            summaryText.textContent = 'Vui lòng điền đầy đủ và chính xác các thông tin giao hàng được đánh dấu đỏ trước khi đặt hàng.';
                            summaryBox.classList.remove('d-none');
                            summaryBox.classList.add('d-flex');
                        }
                        if (firstInvalidEl) {
                            firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            setTimeout(function () {
                                if (typeof firstInvalidEl.focus === 'function') firstInvalidEl.focus();
                            }, 250);
                        }
                    } else if (summaryBox) {
                        summaryBox.classList.add('d-none');
                        summaryBox.classList.remove('d-flex');
                    }
                });
            }
        })();
    </script>
}