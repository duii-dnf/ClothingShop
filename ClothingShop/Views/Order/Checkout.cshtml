@model ClothingShop.Web.ViewModels.CheckoutVM
@using ClothingShop.Models
@using ClothingShop.Services
@using ClothingShop.Web.ViewModels
@{
    ViewBag.Title = "Đặt hàng";
    var cartItems = ViewBag.CartItems as List<CartItemVM> ?? new List<CartItemVM>();
    decimal subTotal = ViewBag.SubTotal != null ? (decimal)ViewBag.SubTotal : 0m;
    decimal shippingFee = ViewBag.ShippingFee != null ? (decimal)ViewBag.ShippingFee : 0m;
    decimal total = ViewBag.Total != null ? (decimal)ViewBag.Total : 0m;
}

<div class="container py-4">
    <div class="d-flex justify-content-center gap-3 small fw-semibold mb-4">
        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check me-1"></i>1. Giỏ hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-obsidian rounded-pill px-3 py-2">2. Đặt hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-light text-muted border rounded-pill px-3 py-2">3. Hoàn tất</span>
    </div>

    <h3 class="font-display fw-bold mb-4"><i class="bi bi-credit-card me-2"></i>Xác nhận thông tin đặt hàng</h3>

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger border-0 rounded-4 shadow-sm" })

        <div class="row g-4">
            <div class="col-lg-7">
                @if (Model.SavedAddresses != null && Model.SavedAddresses.Any())
                {
                    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                        <div class="card-header bg-white fw-bold py-3">
                            <i class="bi bi-geo-alt-fill text-danger me-2"></i>Sổ địa chỉ đã lưu
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var addr in Model.SavedAddresses)
                            {
                                <label class="list-group-item d-flex gap-2 align-items-start py-3">
                                    <input class="form-check-input mt-1" type="radio" name="SelectedAddressId" value="@addr.AddressId"
                                           @(Model.SelectedAddressId == addr.AddressId ? "checked" : "") />
                                    <div>
                                        <strong>@addr.ReceiverName</strong> &bull; @addr.ReceiverPhone
                                        @if (addr.IsDefault)
                                        {
                                            <span class="badge bg-obsidian rounded-pill ms-1">Mặc định</span>
                                        }
                                        <div class="small text-muted mt-1">
                                            @string.Join(", ", new[] { addr.DetailAddress, addr.Ward, addr.District, addr.Province }.Where(s => !string.IsNullOrWhiteSpace(s)))
                                        </div>
                                    </div>
                                </label>
                            }
                            <label class="list-group-item d-flex gap-2 align-items-center py-3">
                                <input class="form-check-input mt-0" type="radio" name="SelectedAddressId" value="0"
                                       @(!Model.SelectedAddressId.HasValue || Model.SelectedAddressId == 0 ? "checked" : "") />
                                <span class="fw-semibold text-primary">Nhập địa chỉ giao hàng mới bên dưới</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="card border-0 rounded-4 shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-person-vcard me-2"></i>Thông tin người nhận
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Họ tên người nhận <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.ReceiverName, new { @class = "form-control rounded-3", placeholder = "Nguyễn Văn A" })
                                @Html.ValidationMessageFor(m => m.ReceiverName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Số điện thoại <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control rounded-3", pattern = "0[0-9]{9}", maxlength = "10", placeholder = "0901234567", title = "Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng số 0" })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Tỉnh / Thành phố</label>
                                @Html.TextBoxFor(m => m.Province, new { @class = "form-control rounded-3", placeholder = "TP. Hồ Chí Minh" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Quận / Huyện</label>
                                @Html.TextBoxFor(m => m.District, new { @class = "form-control rounded-3", placeholder = "Quận Tân Phú" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Phường / Xã</label>
                                @Html.TextBoxFor(m => m.Ward, new { @class = "form-control rounded-3", placeholder = "Phường Tây Thạnh" })
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control rounded-3", placeholder = "Số nhà, tên đường..." })
                                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Ghi chú giao hàng</label>
                                @Html.TextAreaFor(m => m.Note, new { @class = "form-control rounded-3", rows = 2, placeholder = "Giao giờ hành chính, gọi trước khi giao..." })
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.SaveToAddressBook, new { @class = "form-check-input", id = "chkSaveAddr" })
                                    <label class="form-check-label small" for="chkSaveAddr">Lưu địa chỉ mới này vào sổ địa chỉ</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 rounded-4 shadow-sm">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-wallet2 me-2"></i>Phương thức thanh toán
                    </div>
                    <div class="card-body p-4">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="pmCOD" value="@PaymentMethods.COD"
                                   @(string.IsNullOrEmpty(Model.PaymentMethod) || Model.PaymentMethod == PaymentMethods.COD ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="pmCOD">
                                Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="pmBank" value="@PaymentMethods.BankTransfer"
                                   @(Model.PaymentMethod == PaymentMethods.BankTransfer ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="pmBank">
                                Chuyển khoản ngân hàng
                            </label>
                            <div class="small text-muted mt-1">Vietcombank &bull; STK: 0123456789 &bull; Chủ TK: CLOTHINGSHOP VN</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="card-header bg-obsidian text-white fw-bold py-3">
                        Đơn hàng của bạn (@cartItems.Sum(x => x.Quantity) sản phẩm)
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in cartItems)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold small">@item.ProductName</div>
                                        <small class="text-muted">@item.Size / @item.Color &times; @item.Quantity</small>
                                    </div>
                                    <span class="fw-semibold small">@PriceFormatter.Vnd(item.TotalPrice)</span>
                                </li>
                            }
                        </ul>

                        <div class="bg-light rounded-3 p-3 mb-3">
                            <label class="form-label small fw-bold">Mã khuyến mãi</label>
                            @Html.TextBoxFor(m => m.CouponCode, new { @class = "form-control form-control-sm rounded-pill text-uppercase px-3", placeholder = "Nhập mã: SALE10 hoặc NEWUSER" })
                            @Html.ValidationMessageFor(m => m.CouponCode, "", new { @class = "text-danger small d-block mt-1" })
                            <small class="text-muted d-block mt-1">Gợi ý: <code>SALE10</code> (-10% đơn từ 200K), <code>NEWUSER</code> (-15% đơn từ 300K)</small>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span>@PriceFormatter.Vnd(subTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="@(shippingFee == 0 ? "text-success fw-semibold" : "")">
                                @(shippingFee == 0 ? "Miễn phí" : PriceFormatter.Vnd(shippingFee))
                            </span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                            <span>Tổng thanh toán:</span>
                            <span class="text-danger font-display">@PriceFormatter.Vnd(total)</span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg rounded-pill fw-bold">
                                <i class="bi bi-check2-circle me-1"></i>XÁC NHẬN ĐẶT HÀNG
                            </button>
                            <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary btn-sm rounded-pill">Quay lại giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
