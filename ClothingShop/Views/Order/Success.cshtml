@model ClothingShop.Models.Order
@using ClothingShop.Services
@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="d-flex justify-content-center gap-3 small fw-semibold mb-4">
        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check me-1"></i>1. Giỏ hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check me-1"></i>2. Đặt hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-obsidian rounded-pill px-3 py-2">3. Hoàn tất</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 rounded-4 shadow-sm text-center p-4">
                <div class="card-body">
                    <i class="bi bi-check-circle-fill text-success display-2"></i>
                    <h2 class="font-display fw-bold mt-3">ĐẶT HÀNG THÀNH CÔNG!</h2>
                    <p class="text-muted">Cảm ơn bạn đã tin chọn <strong>CLOTHINGSHOP.</strong> Đơn hàng của bạn đang được xử lý.</p>

                    @if (Model != null)
                    {
                        <div class="bg-light rounded-4 p-4 text-start my-4 small">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Mã đơn hàng:</span>
                                <strong class="fs-6">#@Model.OrderId</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Người nhận:</span>
                                <strong>@Model.ReceiverName (@Model.Phone)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Địa chỉ giao hàng:</span>
                                <span>@Model.Address</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Thanh toán:</span>
                                <span class="badge bg-dark rounded-pill">@Model.PaymentMethod</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Tổng thanh toán:</span>
                                <strong class="text-danger fs-5 font-display">@PriceFormatter.Vnd(Model.TotalAmount)</strong>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2">
                        <a href="@Url.Action("History", "Order")" class="btn btn-dark rounded-pill px-4 fw-semibold">Xem đơn hàng của tôi</a>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark rounded-pill px-4">Tiếp tục mua sắm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
