@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center my-5 py-5">
    <div class="alert alert-success d-inline-block p-5 rounded-4 shadow-sm border-0" style="background-color: #f0fdf4;">
        <div class="display-1 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>
        <h2 class="mb-3 text-dark">Cảm ơn bạn đã đặt hàng!</h2>
        <p class="fs-5 text-dark">Mã đơn hàng của bạn là: <strong>#@ViewBag.OrderId</strong></p>
        <p class="text-muted mb-4">Chúng tôi sẽ sớm liên hệ qua điện thoại để xác nhận đơn hàng của bạn.</p>

        <div class="d-flex justify-content-center gap-3 mt-2">
            <a href="@Url.Action("Index", "Home")" class="btn btn-success px-4">Về trang chủ</a>
            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary px-4">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>