@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="alert alert-success" style="display: inline-block; padding: 40px; border-radius: 10px;">
        <h1 style="font-size: 50px;"><i class="glyphicon glyphicon-ok-circle"></i></h1>
        <h2>Cảm ơn bạn đã đặt hàng!</h2>
        <p style="font-size: 1.2em;">Mã đơn hàng của bạn là: <strong>#@ViewBag.OrderId</strong></p>
        <p>Chúng tôi sẽ sớm liên hệ với bạn để xác nhận đơn hàng.</p>

        <br />
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Về trang chủ</a>
        <a href="@Url.Action("Index", "Product")" class="btn btn-default">Tiếp tục mua sắm</a>
    </div>
</div>