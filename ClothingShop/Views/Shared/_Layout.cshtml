@using ClothingShop.Services

@{
    var currentUser = SessionHelper.CurrentUser;
    int cartCount = (Session[SessionHelper.CartCountKey] as int?) ?? 0;
    var promoClass = ViewBag.PromoWine == true ? "promo-strip promo-strip--wine" : "promo-strip";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ClothingShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="store-body">

    <header class="site-header">
        <div class="site-header__inner">
            <div class="header-left">
                <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <nav class="main-nav d-none d-lg-block" aria-label="Danh mục sản phẩm">
                    <ul class="main-nav__list">
                        @Html.Action("CategoryMenu", "Menu", new { area = "", mode = "desktop" })
                    </ul>
                </nav>
            </div>

            @Html.ActionLink("ClothingShop", "Index", "Home", new { area = "" }, new { @class = "brand" })

            <div class="header-actions">
                <button class="icon-btn" type="button" data-bs-toggle="collapse" data-bs-target="#searchBar" aria-expanded="false" aria-label="Tìm kiếm">
                    <i class="bi bi-search"></i>
                </button>

                <a class="icon-btn" href="@Url.Action("Index", "Cart", new { area = "" })" aria-label="Giỏ hàng">
                    <i class="bi bi-bag"></i>
                    @if (cartCount > 0)
                    {
                        <span class="cart-count">@cartCount</span>
                    }
                </a>

                @if (currentUser == null)
                {
                    <a class="icon-btn" href="@Url.Action("Login", "Account", new { area = "" })" aria-label="Đăng nhập">
                        <i class="bi bi-person"></i>
                    </a>
                }
                else
                {
                    <div class="dropdown">
                        <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tài khoản">
                            <i class="bi bi-person-check"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text fw-semibold">@currentUser.FullName</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (currentUser.IsAdmin)
                            {
                                <li>@Html.ActionLink("Trang quản trị", "Index", "Dashboard", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            }
                            <li>@Html.ActionLink("Đơn hàng của tôi", "History", "Order", new { area = "" }, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "" }, new { @class = "dropdown-item" })</li>
                        </ul>
                    </div>
                }

                <button class="menu-btn d-none d-lg-inline-flex" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
                    <i class="bi bi-list"></i> Menu
                </button>
            </div>
        </div>

        <div class="collapse search-bar" id="searchBar">
            <form action="@Url.Action("Search", "Product", new { area = "" })" method="get">
                <input type="text" name="keyword" class="form-control" placeholder="Tìm sản phẩm..." aria-label="Từ khóa" />
                <button class="btn btn-primary" type="submit">Tìm</button>
            </form>
        </div>
    </header>

    <div class="@promoClass">
        @if (currentUser == null)
        {
            <a href="@Url.Action("Register", "Account", new { area = "" })">Đăng ký thành viên và nhập mã NEWUSER để nhận ưu đãi</a>
        }
        else
        {
            <a href="@Url.Action("Index", "Product", new { area = "" })">Khám phá bộ sưu tập mới của ClothingShop</a>
        }
    </div>

    <!-- Menu trượt (điện thoại và nút MENU trên desktop) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <span class="brand brand--sm" id="mobileMenuLabel">ClothingShop</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body">
            @Html.Action("CategoryMenu", "Menu", new { area = "", mode = "mobile" })
            <ul class="mobile-links">
                @if (currentUser == null)
                {
                    <li>@Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, null)</li>
                    <li>@Html.ActionLink("Đăng ký", "Register", "Account", new { area = "" }, null)</li>
                }
                else
                {
                    <li>@Html.ActionLink("Đơn hàng của tôi", "History", "Order", new { area = "" }, null)</li>
                    if (currentUser.IsAdmin)
                    {
                        <li>@Html.ActionLink("Trang quản trị", "Index", "Dashboard", new { area = "Admin" }, null)</li>
                    }
                    <li>@Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "" }, null)</li>
                }
                <li>@Html.ActionLink("Giỏ hàng", "Index", "Cart", new { area = "" }, null)</li>
            </ul>
        </div>
    </div>

    <main>
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container pt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
            </div>
        }

        @if (ViewBag.FullWidth == true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container page-wrap">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-cta">
                <span class="footer-cta__word">Thành viên</span>
                @if (currentUser == null)
                {
                    <a class="btn btn-lime" href="@Url.Action("Register", "Account", new { area = "" })">Đăng ký</a>
                }
                else
                {
                    <a class="btn btn-lime" href="@Url.Action("Index", "Product", new { area = "" })">Mua sắm</a>
                }
            </div>
            <p class="footer-note">Đăng ký tài khoản để theo dõi đơn hàng và sử dụng mã giảm giá.</p>

            <div class="footer-grid">
                <div class="footer-col--contact">
                    <p class="footer-label">Liên hệ</p>
                    <p class="footer-big">clothingshop@example.com</p>
                    <p class="footer-label mt-4">Mạng xã hội</p>
                    <p class="footer-big">Facebook / Instagram / TikTok</p>
                </div>
                <div>
                    <ul class="footer-list">
                        @Html.Action("CategoryMenu", "Menu", new { area = "", mode = "footer" })
                    </ul>
                </div>
                <div>
                    <ul class="footer-list">
                        <li><a href="@Url.Action("Index", "Cart", new { area = "" })">Giỏ hàng</a></li>
                        <li><a href="@Url.Action("History", "Order", new { area = "" })">Đơn hàng của tôi</a></li>
                        @if (currentUser == null)
                        {
                            <li><a href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập</a></li>
                            <li><a href="@Url.Action("Register", "Account", new { area = "" })">Đăng ký</a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action("Logout", "Account", new { area = "" })">Đăng xuất</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="footer-bottom-row">
                <div class="footer-wordmark">ClothingShop</div>
                <div>
                    <p class="footer-label">Chấp nhận thanh toán</p>
                    <span class="pay-pill">COD</span><span class="pay-pill">Chuyển khoản</span>
                </div>
                <div>
                    <p class="footer-label">Dự án</p>
                    <span class="footer-legal">Đồ án môn Lập trình Web</span>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>