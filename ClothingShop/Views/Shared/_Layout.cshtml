@using ClothingShop.Services
@{
    var currentUser = SessionHelper.CurrentUser;
    int cartCount = Session[SessionHelper.CartCountKey] != null ? (int)Session[SessionHelper.CartCountKey] : 0;
    int favCount = Session["FavCount"] != null ? (int)Session["FavCount"] : 0;
    string currentKeyword = Request.QueryString["keyword"] ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - AURELIA.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&family=Urbanist:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        .navbar-brand-aurelia {
            white-space: nowrap;
            flex-shrink: 0;
            text-decoration: none;
        }
        .brand-wordmark {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: 0.08em;
            color: #111111;
            line-height: 1;
        }
        .brand-sub {
            font-family: 'Urbanist', sans-serif;
            font-size: 0.55rem;
            font-weight: 600;
            letter-spacing: 0.22em;
            color: #6c757d;
            margin-top: 3px;
            line-height: 1;
        }
        .header-actions-group {
            flex-wrap: nowrap;
            flex-shrink: 0;
        }
        .header-actions-group .btn {
            white-space: nowrap;
        }
        #searchWrapper {
            width: 185px;
            flex-shrink: 1;
        }
        @@media (min-width: 1200px) {
            #searchWrapper {
                width: 225px;
            }
        }
        .header-search-box {
            display: flex;
            align-items: center;
            background-color: #F4F3EF;
            border: 1px solid #E5E1D8;
            border-radius: 999px;
            height: 36px;
            padding: 0 6px 0 12px;
            transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .header-search-box:focus-within {
            background-color: #ffffff;
            border-color: #111111;
            box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
        }
        .header-search-input {
            border: 0;
            background: transparent;
            outline: none;
            width: 100%;
            font-size: 0.84rem;
            color: #111111;
            min-width: 0;
        }
        .header-search-input::placeholder {
            color: #7a766e;
        }
        .header-search-clear {
            border: 0;
            background: transparent;
            color: #8c877e;
            padding: 0 4px;
            font-size: 0.85rem;
            line-height: 1;
            display: none;
            cursor: pointer;
        }
        .header-search-clear:hover {
            color: #111111;
        }
        .header-search-btn {
            border: 0;
            background-color: #111111;
            color: #ffffff;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 0.78rem;
            transition: background-color 0.2s ease, transform 0.15s ease;
        }
        .header-search-btn:hover {
            background-color: #2c2c2c;
            transform: scale(1.04);
        }
        .search-suggestions-box {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 100%;
            min-width: 100%;
            background: #ffffff;
            border: 1px solid #EAE5DC;
            border-radius: 16px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
            z-index: 9999;
            display: none;
            overflow: hidden;
        }
        @@media (min-width: 992px) {
            .search-suggestions-box {
                width: 350px;
            }
        }
        .suggestion-list-scroll {
            max-height: 340px;
            overflow-y: auto;
            padding: 6px;
        }
        .suggestion-item {
            border-radius: 10px;
            transition: background-color 0.15s ease;
        }
        .suggestion-item:hover,
        .suggestion-item.is-active {
            background-color: #F6F4EF;
        }
        @@media (min-width: 992px) {
            #mainNavbar .navbar-nav {
                flex-wrap: nowrap;
            }
            #mainNavbar .navbar-nav .nav-link {
                white-space: nowrap;
                color: #111111;
                font-size: 0.92rem;
                padding-left: 0.65rem;
                padding-right: 0.65rem;
            }
            #mainNavbar .navbar-nav .nav-item.dropdown {
                position: relative;
            }

                #mainNavbar .navbar-nav .nav-item.dropdown > .dropdown-menu {
                    position: absolute;
                    top: 100%;
                    left: 0;
                    margin-top: 0;
                    border: 0;
                    border-radius: 12px;
                    padding: 8px;
                    min-width: 200px;
                }

                    #mainNavbar .navbar-nav .nav-item.dropdown:hover > .dropdown-menu,
                    #mainNavbar .navbar-nav .nav-item.dropdown > .dropdown-menu.show {
                        display: block !important;
                    }

                #mainNavbar .navbar-nav .nav-item.dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 8px 12px;
                    white-space: nowrap;
                }
        }
        @@media (min-width: 1200px) {
            #mainNavbar .navbar-nav .nav-link {
                padding-left: 0.85rem;
                padding-right: 0.85rem;
            }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Promo Strip -->
    <div class="bg-obsidian text-white py-2 small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-lime rounded-pill fw-bold px-2">NEW DROP</span>
                <span>Freeship đơn từ <strong>500K</strong> &bull; Nhập mã <strong class="text-warning">SALE10</strong> giảm ngay 10%</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-3 text-white-50">
                <span><i class="bi bi-arrow-repeat me-1"></i>Đổi size 7 ngày</span>
                <span><i class="bi bi-telephone me-1"></i>1900 636 888</span>
            </div>
        </div>
    </div>

    <!-- Main Glass Navbar (Bootstrap 5 + Menu 2 cấp động) -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-glass border-bottom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand navbar-brand-aurelia d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <!-- AURELIA Minimalist Fashion Hanger SVG -->
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="36" height="36" rx="8" fill="#111111" />
                    <path d="M18 10.5C18 9.12 19.12 8 20.5 8C21.88 8 23 9.12 23 10.5C23 11.74 22.05 12.76 20.82 12.95L18 13.8V15.4" stroke="#F8F7F4" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M18 15.4L8.5 21.8C7.85 22.24 8.16 23.25 8.95 23.25H27.05C27.84 23.25 28.15 22.24 27.5 21.8L18 15.4Z" stroke="#F8F7F4" stroke-width="1.65" stroke-linejoin="round" />
                    <path d="M14.5 26.75H21.5" stroke="#F8F7F4" stroke-width="1.35" stroke-linecap="round" opacity="0.7" />
                </svg>
                <span class="d-flex flex-column">
                    <span class="brand-wordmark">AURELIA<span style="color:#E11D48;">.</span></span>
                    <span class="brand-sub">ATELIER &bull; SAIGON</span>
                </span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Product")">Cửa hàng</a>
                    </li>
                    @Html.Action("CategoryMenu", "Menu", new { mode = "desktop" })
                    <li class="nav-item">
                        <a class="nav-link fw-bold" style="color:#E11D48 !important;" href="@Url.Action("Index", "Product", new { onSale = true })">
                            <i class="bi bi-fire me-1"></i>Sale
                        </a>
                    </li>
                </ul>

                <!-- Search Bar với Autocomplete (Zero AJAX) -->
                <div class="position-relative me-lg-2 my-2 my-lg-0" id="searchWrapper">
                    <form method="get" action="@Url.Action("Index", "Product")" id="headerSearchForm" autocomplete="off">
                        <div class="header-search-box">
                            <input type="text" name="keyword" id="headerSearchInput" value="@currentKeyword"
                                   class="header-search-input"
                                   placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm sản phẩm" />
                            <button type="button" id="headerSearchClear" class="header-search-clear" title="Xóa từ khóa" aria-label="Xóa từ khóa">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                            <button class="header-search-btn ms-1" type="submit" title="Tìm kiếm" aria-label="Tìm kiếm">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                    <!-- Dropdown gợi ý autocomplete -->
                    <div id="searchSuggestions" class="search-suggestions-box"></div>
                </div>

                <!-- Yêu thích, Giỏ hàng & Tài khoản -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0 header-actions-group">
                    <a href="@Url.Action("Index", "Favorite")" class="btn btn-outline-danger btn-sm rounded-pill px-3 position-relative fw-semibold" title="Sản phẩm yêu thích">
                        <i class="bi bi-heart-fill"></i>
                        @if (favCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">
                                @favCount
                            </span>
                        }
                    </a>

                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-dark btn-sm rounded-pill px-3 position-relative fw-semibold">
                        <i class="bi bi-bag me-1"></i>Giỏ
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @cartCount
                            </span>
                        }
                    </a>

                    @if (currentUser == null)
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-dark btn-sm rounded-pill px-3 fw-semibold">Đăng nhập</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Đăng ký</a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark btn-sm rounded-pill px-3 dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@currentUser.FullName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-4 p-2 mt-2">
                                <li class="px-3 py-2">
                                    <div class="fw-bold small">@currentUser.FullName</div>
                                    <span class="badge bg-dark-subtle text-dark rounded-pill">@currentUser.Role</span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                @if (currentUser.CanAccessAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item rounded-3 fw-semibold text-primary" href="@Url.Action("Index", currentUser.IsAdmin ? "Dashboard" : "Order", new { area = "Admin" })">
                                            <i class="bi bi-grid-1x2-fill me-2"></i>Khu vực Quản trị
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item rounded-3" href="@Url.Action("Profile", "Account")">
                                        <i class="bi bi-person-vcard me-2"></i>Hồ sơ &amp; Sổ địa chỉ
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3" href="@Url.Action("Index", "Favorite")">
                                        <i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm yêu thích
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3" href="@Url.Action("History", "Order")">
                                        <i class="bi bi-bag-check me-2"></i>Đơn hàng của tôi
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item rounded-3 text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="container mt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 rounded-4 shadow-sm alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 rounded-4 shadow-sm alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    }

    <!-- Nội dung chính -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Editorial Footer -->
    <footer class="bg-obsidian text-light pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
                <div class="col-lg-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="0.75" y="0.75" width="34.5" height="34.5" rx="7.25" fill="#111111" stroke="#F8F7F4" stroke-opacity="0.3" stroke-width="1.5" />
                            <path d="M18 10.5C18 9.12 19.12 8 20.5 8C21.88 8 23 9.12 23 10.5C23 11.74 22.05 12.76 20.82 12.95L18 13.8V15.4" stroke="#F8F7F4" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M18 15.4L8.5 21.8C7.85 22.24 8.16 23.25 8.95 23.25H27.05C27.84 23.25 28.15 22.24 27.5 21.8L18 15.4Z" stroke="#F8F7F4" stroke-width="1.65" stroke-linejoin="round" />
                            <path d="M14.5 26.75H21.5" stroke="#F8F7F4" stroke-width="1.35" stroke-linecap="round" opacity="0.7" />
                        </svg>
                        <div class="d-flex flex-column">
                            <h4 class="brand-wordmark text-white mb-0">AURELIA<span style="color:#E11D48;">.</span></h4>
                            <span class="brand-sub text-white-50">ATELIER &bull; SAIGON</span>
                        </div>
                    </div>
                    <p class="text-white-50 small mb-3">
                        Thương hiệu thời trang Gen-Z dành cho cả Nam và Nữ. Phom dáng hiện đại, chất liệu chọn lọc, cập nhật xu hướng streetwear &amp; minimal mỗi tuần.
                    </p>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-secondary bg-opacity-25 text-white fw-normal px-3 py-2 rounded-pill">#Streetwear</span>
                        <span class="badge bg-secondary bg-opacity-25 text-white fw-normal px-3 py-2 rounded-pill">#Minimal</span>
                        <span class="badge bg-secondary bg-opacity-25 text-white fw-normal px-3 py-2 rounded-pill">#GenZStyle</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-uppercase small mb-3 text-white">Danh mục</h6>
                    @Html.Action("CategoryMenu", "Menu", new { mode = "footer" })
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-uppercase small mb-3 text-white">Khám phá nhanh</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action("Index", "Product", new { gender = "Nam" })" class="text-white-50 text-decoration-none">Thời trang Nam</a></li>
                        <li class="mb-2"><a href="@Url.Action("Index", "Product", new { gender = "Nữ" })" class="text-white-50 text-decoration-none">Thời trang Nữ</a></li>
                        <li class="mb-2"><a href="@Url.Action("Index", "Product", new { isNew = true })" class="text-white-50 text-decoration-none">Hàng mới về</a></li>
                        <li class="mb-2"><a href="@Url.Action("Index", "Product", new { onSale = true })" class="text-warning text-decoration-none fw-semibold">Săn Deal Khuyến Mãi</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h6 class="fw-bold text-uppercase small mb-3 text-white">Cửa hàng &amp; Liên hệ</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2"><i class="bi bi-geo-alt text-white me-2"></i>140 Lê Trọng Tấn, Tân Phú, TP.HCM</li>
                        <li class="mb-2"><i class="bi bi-envelope text-white me-2"></i>support@aurelia.vn</li>
                        <li class="mb-2"><i class="bi bi-telephone text-white me-2"></i>1900 636 888 (8:00 - 21:00)</li>
                    </ul>
                </div>
                <!-- Bản đồ cửa hàng -->
                <div class="col-lg-3">
                    <h6 class="fw-bold text-uppercase small mb-3 text-white"><i class="bi bi-map me-1"></i>Tìm chúng tôi</h6>
                    <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="height:160px;">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.264!2d106.629!3d10.779!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752936ed12a40f%3A0x2a1ba3a9a4f47a40!2s140%20L%C3%AA%20Tr%E1%BB%8Dng%20T%E1%BA%A5n%2C%20T%C3%A2n%20Ph%C3%BA%2C%20H%E1%BB%93%20Ch%C3%AD%20Minh!5e0!3m2!1svi!2svn!4v1700000000000"
                            width="100%" height="100%" style="border:0;filter:grayscale(30%);" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="Bản đồ AURELIA"></iframe>
                    </div>
                    <p class="small text-white-50 mt-2 mb-0"><i class="bi bi-clock me-1"></i>T2–CN: 8:00 – 21:00</p>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 small text-white-50">
                <span>&copy; @DateTime.Now.Year AURELIA. Bảo lưu mọi quyền.</span>
                <span>AURELIA Atelier &bull; TP. Hồ Chí Minh</span>
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @Html.Action("SearchProductData", "Menu")
    <script>
        // Search Autocomplete lọc thuần trên dữ liệu đã render sẵn từ Server (không dùng AJAX)
        (function () {
            var input = document.getElementById('headerSearchInput');
            var clearBtn = document.getElementById('headerSearchClear');
            var box = document.getElementById('searchSuggestions');
            var form = document.getElementById('headerSearchForm');
            if (!input || !box) return;
            var allProducts = window.SEARCH_PRODUCTS || [];
            var activeIndex = -1;

            function normalizeText(str) {
                return (str || '')
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd');
            }

            function formatVnd(n) { return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '₫'; }

            function toggleClear() {
                if (clearBtn) clearBtn.style.display = input.value.length > 0 ? 'inline-block' : 'none';
            }

            function showSuggestions(items, term) {
                activeIndex = -1;
                if (!items || items.length === 0) {
                    box.innerHTML = '<div class="p-4 text-muted small text-center">' +
                        '<i class="bi bi-search d-block fs-4 mb-2 opacity-50"></i>' +
                        'Không tìm thấy sản phẩm cho "<strong>' + term.replace(/</g, '&lt;') + '</strong>"</div>';
                    box.style.display = 'block';
                    return;
                }
                var header = '<div class="px-3 py-2 border-bottom bg-light d-flex justify-content-between align-items-center" style="font-size:0.75rem;">' +
                    '<span class="text-uppercase fw-bold text-muted" style="letter-spacing:0.06em;">Gợi ý sản phẩm</span>' +
                    '<span class="text-muted">' + items.length + ' kết quả</span></div>';

                var listHtml = '<div class="suggestion-list-scroll">' + items.map(function (p) {
                    var priceHtml = p.discountPrice && p.discountPrice < p.price
                        ? '<span class="fw-bold" style="color:#E11D48;">' + formatVnd(p.discountPrice) + '</span> <s class="text-muted ms-1" style="font-size:0.75rem;">' + formatVnd(p.price) + '</s>'
                        : '<span class="fw-bold text-dark">' + formatVnd(p.price) + '</span>';
                    return '<a href="/Product/Details/' + p.id + '" class="d-flex align-items-center gap-3 px-2 py-2 text-decoration-none text-dark suggestion-item">' +
                        '<img src="' + p.imageUrl + '" style="width:46px;height:54px;object-fit:cover;border-radius:8px;flex-shrink:0;border:1px solid #eee;" onerror="this.src=\'/Content/images/products/default.jpg\'" />' +
                        '<div class="min-w-0 flex-grow-1"><div class="small fw-semibold text-truncate">' + p.name + '</div><div class="small mt-1">' + priceHtml + '</div></div>' +
                        '<i class="bi bi-arrow-up-right text-muted small me-1"></i>' +
                        '</a>';
                }).join('') + '</div>';

                var footer = '<a href="/Product?keyword=' + encodeURIComponent(term) + '" class="d-block text-center py-2 border-top small fw-semibold text-dark text-decoration-none bg-light">' +
                    'Xem tất cả kết quả cho "' + term.replace(/</g, '&lt;') + '" <i class="bi bi-arrow-right ms-1"></i></a>';

                box.innerHTML = header + listHtml + footer;
                box.style.display = 'block';
            }

            function runFilter() {
                toggleClear();
                var term = input.value.trim();
                if (term.length < 2) { box.style.display = 'none'; return; }
                var q = normalizeText(term);
                var matched = allProducts.filter(function (p) {
                    return normalizeText(p.name).indexOf(q) !== -1;
                }).slice(0, 8);
                showSuggestions(matched, term);
            }

            toggleClear();
            input.addEventListener('input', runFilter);
            input.addEventListener('focus', function () {
                if (input.value.trim().length >= 2) runFilter();
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    input.value = '';
                    toggleClear();
                    box.style.display = 'none';
                    input.focus();
                });
            }

            input.addEventListener('keydown', function (e) {
                var items = box.querySelectorAll('.suggestion-item');
                if (e.key === 'Escape') {
                    box.style.display = 'none';
                    return;
                }
                if (box.style.display === 'block' && items.length > 0) {
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        activeIndex = (activeIndex + 1) % items.length;
                        items.forEach(function (el, idx) { el.classList.toggle('is-active', idx === activeIndex); });
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        activeIndex = (activeIndex - 1 + items.length) % items.length;
                        items.forEach(function (el, idx) { el.classList.toggle('is-active', idx === activeIndex); });
                    } else if (e.key === 'Enter' && activeIndex >= 0 && items[activeIndex]) {
                        e.preventDefault();
                        window.location.href = items[activeIndex].href;
                    }
                }
            });

            document.addEventListener('click', function (e) {
                if (!document.getElementById('searchWrapper').contains(e.target)) box.style.display = 'none';
            });
        })();
    </script>
    <style>
        .suggestion-item:hover { background: #f8f9fa; }
        body { font-family: 'Nunito', 'Be Vietnam Pro', sans-serif; }
        .font-display { font-family: 'Urbanist', 'Space Grotesk', sans-serif; }
    </style>
    <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var dropdownItems = document.querySelectorAll('#mainNavbar .navbar-nav .nav-item.dropdown');

                    dropdownItems.forEach(function (item) {
                        var toggleLink = item.querySelector('a.dropdown-toggle');
                        var menu = item.querySelector('.dropdown-menu');

                        item.addEventListener('mouseenter', function () {
                            if (window.innerWidth >= 992) {
                                item.classList.add('show');
                                if (toggleLink) {
                                    toggleLink.classList.add('show');
                                    toggleLink.setAttribute('aria-expanded', 'true');
                                }
                                if (menu) {
                                    menu.classList.add('show');
                                }
                            }
                        });

                        item.addEventListener('mouseleave', function () {
                            if (window.innerWidth >= 992) {
                                item.classList.remove('show');
                                if (toggleLink) {
                                    toggleLink.classList.remove('show');
                                    toggleLink.setAttribute('aria-expanded', 'false');
                                }
                                if (menu) {
                                    menu.classList.remove('show');
                                }
                            }
                        });

                        if (toggleLink) {
                            toggleLink.addEventListener('click', function (e) {
                                if (window.innerWidth >= 992 && toggleLink instanceof HTMLAnchorElement && toggleLink.href) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    window.location.href = toggleLink.href;
                                }
                            });
                        }
                    });
                });
    </script><script>
                document.addEventListener('DOMContentLoaded', function () {
                    var categoryLinks = document.querySelectorAll('.navbar-nav .nav-item.dropdown > a.dropdown-toggle');
                    for (var i = 0; i < categoryLinks.length; i++) {
                        (function (link) {
                            link.addEventListener('click', function (e) {
                                if (window.innerWidth >= 992 && link instanceof HTMLAnchorElement && link.href) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    window.location.href = link.href;
                                }
                            });
                        })(categoryLinks[i]);
                    }
                });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
