@model IEnumerable<ClothingShop.ViewModels.MenuItemViewModel>

@if (Model != null)
{
    foreach (var parent in Model)
    {
        if (parent.Children != null && parent.Children.Any())
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle fw-semibold" href="@Url.Action("Index", "Product", new { categoryId = parent.Id })" role="button" data-bs-toggle="dropdown">
                    @parent.Name
                </a>
                <ul class="dropdown-menu shadow-sm">
                    <li>
                        <a class="dropdown-item fw-semibold" href="@Url.Action("Index", "Product", new { categoryId = parent.Id })">
                            Tất cả @parent.Name
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    @foreach (var child in parent.Children)
                    {
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Index", "Product", new { categoryId = child.Id })">
                                @child.Name
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link fw-semibold" href="@Url.Action("Index", "Product", new { categoryId = parent.Id })">
                    @parent.Name
                </a>
            </li>
        }
    }
}
