@model ClothingShop.Models.Product
@using System.Collections.Generic
@using ClothingShop.Services
@{
    bool hasSale = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < Model.Price;
    int salePct = hasSale && Model.Price > 0 ? (int)Math.Round((1m - Model.DiscountPrice.Value / Model.Price) * 100m) : 0;
    var favIds = Session["FavIds"] as List<int>;
    bool isFav = favIds != null && favIds.Contains(Model.ProductId);
    string currentUrl = Request.RawUrl;
    string img = string.IsNullOrEmpty(Model.ImageUrl)
        ? Url.Content("~/Content/images/products/default.jpg")
        : (Model.ImageUrl.StartsWith("http") || Model.ImageUrl.StartsWith("/")
            ? Model.ImageUrl
            : Url.Content("~/Content/images/products/" + Model.ImageUrl));
}

<div class="card h-100 border-0 bg-white shadow-sm product-card">
    <div class="position-relative product-img-wrap">
        <a href="@Url.Action("Details", "Product", new { id = Model.ProductId })">
            <img src="@img" alt="@Model.Name" />
        </a>

        <!-- Badges góc trái -->
        <div class="position-absolute top-0 start-0 p-2 d-flex flex-column gap-1">
            @if (hasSale && salePct > 0)
            {
                <span class="badge bg-danger rounded-pill px-2 py-1 fw-bold">-@salePct%</span>
            }
            @if (Model.IsNew)
            {
                <span class="badge bg-obsidian rounded-pill px-2 py-1">NEW</span>
            }
            @if (Model.Stock <= 0)
            {
                <span class="badge bg-secondary rounded-pill px-2 py-1">Hết hàng</span>
            }
        </div>

        <!-- Badge giới tính góc phải -->
        @if (!string.IsNullOrEmpty(Model.Gender))
        {
            <span class="position-absolute top-0 end-0 m-2 badge bg-white bg-opacity-90 text-dark rounded-pill shadow-sm fw-semibold" style="font-size:0.7rem;">
                @Model.Gender
            </span>
        }
    </div>

    <div class="card-body d-flex flex-column p-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">
                @(Model.Category != null ? Model.Category.Name : "Thời trang")
            </small>
            @if (!string.IsNullOrEmpty(Model.Colors))
            {
                <small class="text-muted" style="font-size: 0.72rem;">@Model.Colors</small>
            }
        </div>

        <h6 class="card-title mb-2 lh-sm">
            <a href="@Url.Action("Details", "Product", new { id = Model.ProductId })" class="text-dark text-decoration-none fw-bold">
                @Model.Name
            </a>
        </h6>

        <div class="mt-auto pt-2">
            <div class="d-flex align-items-baseline gap-2 mb-2">
                @if (hasSale)
                {
                    <span class="fw-bold text-danger fs-6">@PriceFormatter.Vnd(Model.DiscountPrice)</span>
                    <small class="text-muted text-decoration-line-through">@PriceFormatter.Vnd(Model.Price)</small>
                }
                else
                {
                    <span class="fw-bold text-dark fs-6">@PriceFormatter.Vnd(Model.Price)</span>
                }
            </div>

            <div class="d-flex gap-2">
                <a href="@Url.Action("Details", "Product", new { id = Model.ProductId })" class="btn btn-dark btn-sm rounded-pill fw-semibold flex-grow-1">
                    Chọn size
                </a>
                @using (Html.BeginForm("Toggle", "Favorite", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit" class="btn btn-sm rounded-circle @(isFav ? "btn-danger" : "btn-outline-danger")"
                            title="@(isFav ? "Bỏ yêu thích" : "Thêm vào yêu thích")">
                        <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>
