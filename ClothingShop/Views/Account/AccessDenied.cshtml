@{
    ViewBag.Title = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <i class="bi bi-shield-lock-fill text-danger display-2"></i>
                    <h3 class="fw-bold mt-3">Không có quyền truy cập</h3>
                    <p class="text-muted">Tài khoản của bạn không có quyền thực hiện chức năng này.</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-dark">Quay về trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div>
