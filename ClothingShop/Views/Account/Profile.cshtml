@model ClothingShop.ViewModels.UserProfileVM
@using ClothingShop.Services
@{
    ViewBag.Title = "Hồ sơ cá nhân";
}

<div class="container py-4">
    <h3 class="fw-bold mb-4"><i class="bi bi-person-circle me-2"></i>Hồ sơ cá nhân &amp; Sổ địa chỉ</h3>

    <div class="row g-4">
        <!-- Cột trái: Cập nhật thông tin cá nhân & đổi mật khẩu -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-dark text-white fw-semibold">Thông tin tài khoản</div>
                <div class="card-body">
                    @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="text" class="form-control" value="@Model.Email" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và tên</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại (10 số, bắt đầu bằng 0)</label>
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", pattern = "0[0-9]{9}", maxlength = "10", placeholder = "0901234567", title = "Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng số 0" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Giới tính</label>
                                <select name="Gender" class="form-select">
                                    <option value="Nam" @(Model.Gender == "Nam" ? "selected" : "")>Nam</option>
                                    <option value="Nữ" @(Model.Gender == "Nữ" ? "selected" : "")>Nữ</option>
                                    <option value="Unisex" @(Model.Gender == "Unisex" ? "selected" : "")>Khác</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ngày sinh</label>
                                <input type="date" name="BirthDate" value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Địa chỉ chính</label>
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                            </div>
                        </div>

                        <hr />
                        <h6 class="fw-bold mb-3">Đổi mật khẩu (bỏ trống nếu không đổi)</h6>
                        <div class="mb-2">
                            <label class="form-label small">Mật khẩu hiện tại</label>
                            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control form-control-sm" })
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small">Mật khẩu mới</label>
                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Xác nhận mật khẩu mới</label>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control form-control-sm" })
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-save me-1"></i>Lưu thay đổi
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Sổ địa chỉ & Đơn hàng gần đây -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-geo-alt me-1"></i>Sổ địa chỉ giao hàng
                </div>
                <div class="card-body">
                    @if (Model.Addresses != null && Model.Addresses.Any())
                    {
                        <div class="list-group mb-3">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@addr.ReceiverName</strong> - @addr.ReceiverPhone
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-dark ms-1">Mặc định</span>
                                            }
                                            <div class="small text-muted">
                                                @string.Join(", ", new[] { addr.DetailAddress, addr.Ward, addr.District, addr.Province }.Where(s => !string.IsNullOrWhiteSpace(s)))
                                            </div>
                                        </div>
                                        <div class="d-flex gap-1">
                                            @if (!addr.IsDefault)
                                            {
                                                using (Html.BeginForm("SetDefaultAddress", "Account", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                    <button type="submit" class="btn btn-outline-dark btn-sm">Mặc định</button>
                                                }
                                            }
                                            @using (Html.BeginForm("DeleteAddress", "Account", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Xóa địa chỉ này?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <h6 class="fw-bold mb-2">Thêm địa chỉ mới</h6>
                    @using (Html.BeginForm("AddAddress", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="text" name="ReceiverName" class="form-control form-control-sm" placeholder="Tên người nhận *" required />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="ReceiverPhone" class="form-control form-control-sm" pattern="0[0-9]{9}" maxlength="10" placeholder="SĐT 10 số (0xxxxxxxxx) *" title="Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng số 0" required />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Province" class="form-control form-control-sm" placeholder="Tỉnh / TP" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="District" class="form-control form-control-sm" placeholder="Quận / Huyện" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Ward" class="form-control form-control-sm" placeholder="Phường / Xã" />
                            </div>
                            <div class="col-12">
                                <input type="text" name="DetailAddress" class="form-control form-control-sm" placeholder="Số nhà, tên đường *" required />
                            </div>
                            <div class="col-12 d-flex justify-content-between align-items-center mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="chkNewDef" />
                                    <label class="form-check-label small" for="chkNewDef">Đặt làm mặc định</label>
                                </div>
                                <button type="submit" class="btn btn-dark btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm địa chỉ
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="bi bi-receipt me-1"></i>Đơn hàng gần đây</span>
                    <a href="@Url.Action("History", "Order")" class="small text-dark">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                    {
                        <div class="p-3 text-muted small text-center">Chưa có đơn hàng nào.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <tbody>
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">#@o.OrderId</td>
                                        <td class="small text-muted">@o.OrderDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-secondary">@o.Status</span></td>
                                        <td class="text-end pe-3 fw-semibold text-danger">@PriceFormatter.Vnd(o.TotalAmount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
