@model List<ClothingShop.Web.ViewModels.CartItemVM>
@using ClothingShop.Services
@{
    ViewBag.Title = "Giỏ hàng";
    decimal subTotal = ViewBag.Total != null ? (decimal)ViewBag.Total : 0m;
    decimal shippingFee = subTotal >= 500000m || subTotal == 0m ? 0m : 30000m;
    decimal grandTotal = subTotal + shippingFee;
    int freeShipPct = subTotal >= 500000m ? 100 : (int)Math.Round(subTotal / 5000m);
}

<div class="container py-4">
    <!-- Bước mua hàng -->
    <div class="d-flex justify-content-center gap-3 small fw-semibold mb-4">
        <span class="badge bg-obsidian rounded-pill px-3 py-2">1. Giỏ hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-light text-muted border rounded-pill px-3 py-2">2. Đặt hàng</span>
        <span class="text-muted align-self-center">&rarr;</span>
        <span class="badge bg-light text-muted border rounded-pill px-3 py-2">3. Hoàn tất</span>
    </div>

    <h3 class="font-display fw-bold mb-4"><i class="bi bi-bag me-2"></i>Giỏ hàng của bạn</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-4 shadow-sm text-center py-5">
            <i class="bi bi-bag-x display-2 text-muted"></i>
            <h4 class="fw-bold mt-3">Giỏ hàng đang trống</h4>
            <p class="text-muted">Khám phá ngay các mẫu streetwear &amp; minimal mới nhất nhé!</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-dark rounded-pill px-4 mt-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Thanh tiến độ Freeship -->
                <div class="bg-white rounded-4 shadow-sm p-3 mb-3">
                    @if (shippingFee == 0)
                    {
                        <div class="small fw-semibold text-success mb-2">
                            <i class="bi bi-truck me-1"></i>Chúc mừng! Đơn hàng của bạn đã được <strong>MIỄN PHÍ VẬN CHUYỂN</strong>.
                        </div>
                    }
                    else
                    {
                        <div class="small fw-semibold mb-2">
                            <i class="bi bi-truck me-1"></i>Mua thêm <strong class="text-danger">@PriceFormatter.Vnd(500000m - subTotal)</strong> để nhận Freeship!
                        </div>
                    }
                    <div class="progress rounded-pill" style="height: 8px;">
                        <div class="progress-bar @(shippingFee == 0 ? "bg-success" : "bg-dark")" style="width:@freeShipPct%;"></div>
                    </div>
                </div>

                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center" style="width: 170px;">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-center pe-3">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string img = string.IsNullOrEmpty(item.ImageUrl)
                                        ? Url.Content("~/Content/images/products/default.jpg")
                                        : (item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/")
                                            ? item.ImageUrl
                                            : Url.Content("~/Content/images/products/" + item.ImageUrl));
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@img" alt="@item.ProductName" class="rounded-3 border" style="width:68px;height:86px;object-fit:cover;" />
                                                <div>
                                                    <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="small text-muted mt-1">
                                                        <span class="badge bg-light text-dark border rounded-pill">@item.Size</span>
                                                        <span class="badge bg-light text-dark border rounded-pill">@item.Color</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">@PriceFormatter.Vnd(item.UnitPrice)</td>
                                        <td>
                                            <!-- Cập nhật số lượng bằng Form POST thuần (KHÔNG AJAX) -->
                                            @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center gap-1" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(1, item.MaxStock)"
                                                       class="form-control form-control-sm rounded-pill text-center fw-bold" style="width: 68px;" />
                                                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-2" title="Cập nhật số lượng">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-danger">@PriceFormatter.Vnd(item.TotalPrice)</td>
                                        <td class="text-center pe-3">
                                            <a href="@Url.Action("Remove", "Cart", new { itemKey = item.ItemKey })"
                                               class="btn btn-outline-danger btn-sm rounded-circle"
                                               onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="card-header bg-obsidian text-white fw-bold py-3">Tóm tắt đơn hàng</div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-semibold">@PriceFormatter.Vnd(subTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-semibold @(shippingFee == 0 ? "text-success" : "")">
                                @(shippingFee == 0 ? "Miễn phí" : PriceFormatter.Vnd(shippingFee))
                            </span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                            <span>Tổng cộng:</span>
                            <span class="text-danger font-display">@PriceFormatter.Vnd(grandTotal)</span>
                        </div>
                        <div class="d-grid">
                            <a href="@Url.Action("Checkout", "Order")" class="btn btn-dark btn-lg rounded-pill fw-bold">
                                Tiến hành đặt hàng <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
