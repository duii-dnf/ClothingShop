@model List<ClothingShop.Web.ViewModels.CartItemVM>
@using ClothingShop.Services
@{
    ViewBag.Title = "Giỏ hàng";
    decimal subTotal = ViewBag.Total != null ? (decimal)ViewBag.Total : 0m;
    decimal shippingFee = subTotal >= 500000m || subTotal == 0m ? 0m : 30000m;
    decimal grandTotal = subTotal + shippingFee;
    string widthClass = subTotal >= 500000m ? "w-100"
        : subTotal >= 375000m ? "w-75"
        : subTotal >= 250000m ? "w-50"
        : subTotal > 0m ? "w-25"
        : "w-0";
}

<div class="container py-4">
    <!-- Checkout Progress Bar (đồng bộ với Checkout & Success) -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-center" style="max-width:520px;margin:0 auto;">
            <!-- Step 1 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-obsidian text-white fw-bold border border-dark" style="width:38px;height:38px;">
                    1
                </div>
                <div class="small fw-semibold mt-1">Giỏ hàng</div>
            </div>
            <!-- Line -->
            <div class="flex-grow-1 mx-2" style="height:3px;background:#dee2e6;border-radius:2px;"></div>
            <!-- Step 2 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted border" style="width:38px;height:38px;">
                    2
                </div>
                <div class="small text-muted mt-1">Đặt hàng</div>
            </div>
            <!-- Line -->
            <div class="flex-grow-1 mx-2" style="height:3px;background:#dee2e6;border-radius:2px;"></div>
            <!-- Step 3 -->
            <div class="text-center flex-shrink-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted border" style="width:38px;height:38px;">
                    3
                </div>
                <div class="small text-muted mt-1">Hoàn tất</div>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-4"><i class="bi bi-bag me-2"></i>Giỏ hàng của bạn</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-4 shadow-sm text-center py-5">
            <i class="bi bi-bag-x display-2 text-muted"></i>
            <h4 class="fw-bold mt-3">Giỏ hàng đang trống</h4>
            <p class="text-muted">Khám phá ngay các mẫu streetwear &amp; minimal mới nhất nhé!</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-dark rounded-pill px-4 mt-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Thanh tiến độ Freeship -->
                <div class="bg-white rounded-4 shadow-sm p-3 mb-3">
                    <div id="freeShipText" class="small fw-semibold mb-2 @(shippingFee == 0 ? "text-success" : "")">
                        @if (shippingFee == 0)
                        {
                            <i class="bi bi-truck me-1"></i><span>Chúc mừng! Đơn hàng của bạn đã được <strong>MIỄN PHÍ VẬN CHUYỂN</strong>.</span>
                        }
                        else
                        {
                            <i class="bi bi-truck me-1"></i><span>Mua thêm <strong class="text-danger">@PriceFormatter.Vnd(500000m - subTotal)</strong> để nhận Freeship!</span>
                        }
                    </div>
                    <div class="progress rounded-pill">
                        <div id="freeShipBar" class="progress-bar @(shippingFee == 0 ? "bg-success" : "bg-dark") @widthClass"></div>
                    </div>
                </div>

                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-center pe-3">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string img = string.IsNullOrEmpty(item.ImageUrl)
                                        ? Url.Content("~/Content/images/products/default.jpg")
                                        : (item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/")
                                            ? item.ImageUrl
                                            : Url.Content("~/Content/images/products/" + item.ImageUrl));
                                    <tr class="cart-item-row"
                                        data-unit-price="@((long)item.UnitPrice)"
                                        data-max-stock="@Math.Max(1, item.MaxStock)">
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@img" alt="@item.ProductName" width="68" height="86" class="rounded-3 border" />
                                                <div>
                                                    <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="small text-muted mt-1">
                                                        <span class="badge bg-light text-dark border rounded-pill">@item.Size</span>
                                                        <span class="badge bg-light text-dark border rounded-pill">@item.Color</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">@PriceFormatter.Vnd(item.UnitPrice)</td>
                                        <td>
                                            <!-- Form POST thuần tự động submit khi đổi số lượng -->
                                            @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center gap-1" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(1, item.MaxStock)"
                                                       size="3" class="form-control form-control-sm rounded-pill text-center fw-bold w-auto cart-qty-input" />
                                                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-2" title="Cập nhật số lượng">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-danger item-total-cell">@PriceFormatter.Vnd(item.TotalPrice)</td>
                                        <td class="text-center pe-3">
                                            <a href="@Url.Action("Remove", "Cart", new { itemKey = item.ItemKey })"
                                               class="btn btn-outline-danger btn-sm rounded-circle"
                                               onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="card-header bg-dark text-white fw-bold py-3">Tóm tắt đơn hàng</div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span id="summarySubTotal" class="fw-semibold">@PriceFormatter.Vnd(subTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span id="summaryShipping" class="fw-semibold @(shippingFee == 0 ? "text-success" : "")">
                                @(shippingFee == 0 ? "Miễn phí" : PriceFormatter.Vnd(shippingFee))
                            </span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                            <span>Tổng cộng:</span>
                            <span id="summaryGrandTotal" class="text-danger">@PriceFormatter.Vnd(grandTotal)</span>
                        </div>
                        <div class="d-grid">
                            <a href="@Url.Action("Checkout", "Order")" class="btn btn-dark btn-lg rounded-pill fw-bold">
                                Tiến hành đặt hàng <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function formatVnd(amount = 0) {
                return Math.round(Number(amount) || 0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '₫';
            }

            // Cập nhật hiển thị tiền trên giao diện ngay trong lúc đang gõ (thuần DOM, KHÔNG AJAX)
            function previewCartTotals() {
                var subTotal = 0;
                var rows = document.querySelectorAll('.cart-item-row');

                rows.forEach(function (row) {
                    var unitPrice = Number(row.getAttribute('data-unit-price')) || 0;
                    var maxStock = Number(row.getAttribute('data-max-stock')) || 1;
                    var input = row.querySelector('input.cart-qty-input');
                    var totalCell = row.querySelector('.item-total-cell');

                    var rawVal = (input instanceof HTMLInputElement) ? parseInt(input.value, 10) : 1;
                    var qty = isNaN(rawVal) || rawVal < 1 ? 1 : Math.min(rawVal, maxStock);
                    var lineTotal = unitPrice * qty;

                    if (totalCell) {
                        totalCell.textContent = formatVnd(lineTotal);
                    }
                    subTotal += lineTotal;
                });

                var shippingFee = (subTotal >= 500000 || subTotal === 0) ? 0 : 30000;
                var grandTotal = subTotal + shippingFee;
                var widthCls = subTotal >= 500000 ? 'w-100'
                    : subTotal >= 375000 ? 'w-75'
                    : subTotal >= 250000 ? 'w-50'
                    : subTotal > 0 ? 'w-25'
                    : 'w-0';

                var subTotalEl = document.getElementById('summarySubTotal');
                var grandTotalEl = document.getElementById('summaryGrandTotal');
                var shipEl = document.getElementById('summaryShipping');
                var freeShipText = document.getElementById('freeShipText');
                var freeShipBar = document.getElementById('freeShipBar');

                if (subTotalEl) subTotalEl.textContent = formatVnd(subTotal);
                if (grandTotalEl) grandTotalEl.textContent = formatVnd(grandTotal);

                if (shipEl && freeShipText && freeShipBar) {
                    freeShipBar.classList.remove('w-0', 'w-25', 'w-50', 'w-75', 'w-100');
                    freeShipBar.classList.add(widthCls);

                    if (shippingFee === 0) {
                        shipEl.classList.add('text-success');
                        shipEl.textContent = 'Miễn phí';

                        freeShipText.classList.add('text-success');
                        freeShipText.innerHTML = '<i class="bi bi-truck me-1"></i><span>Chúc mừng! Đơn hàng của bạn đã được <strong>MIỄN PHÍ VẬN CHUYỂN</strong>.</span>';
                        freeShipBar.classList.remove('bg-dark');
                        freeShipBar.classList.add('bg-success');
                    } else {
                        shipEl.classList.remove('text-success');
                        shipEl.textContent = formatVnd(shippingFee);

                        var remain = 500000 - subTotal;
                        freeShipText.classList.remove('text-success');
                        freeShipText.innerHTML = '<i class="bi bi-truck me-1"></i><span>Mua thêm <strong class="text-danger">' + formatVnd(remain) + '</strong> để nhận Freeship!</span>';
                        freeShipBar.classList.remove('bg-success');
                        freeShipBar.classList.add('bg-dark');
                    }
                }
            }

            var qtyInputs = document.querySelectorAll('input.cart-qty-input');
            qtyInputs.forEach(function (input) {
                if (!(input instanceof HTMLInputElement)) return;

                input.addEventListener('input', function () {
                    if (input.value !== '') {
                        previewCartTotals();
                    }
                });

                input.addEventListener('change', function () {
                    var row = input.closest('.cart-item-row');
                    var maxStock = row ? (Number(row.getAttribute('data-max-stock')) || 1) : 1;
                    var qty = parseInt(input.value, 10);

                    if (isNaN(qty) || qty < 1) qty = 1;
                    if (qty > maxStock) qty = maxStock;
                    input.value = String(qty);

                    var form = input.closest('form');
                    if (form) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
