@model List<ClothingShop.Web.ViewModels.CartItemVM>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4"><i class="bi bi-bag-check"></i> Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            Giỏ hàng của bạn đang trống. <a href="@Url.Action("Index", "Home")" class="alert-link">Tiếp tục mua sắm</a>.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%">Hình ảnh</th>
                        <th style="width: 35%">Tên sản phẩm</th>
                        <th style="width: 15%">Đơn giá</th>
                        <th style="width: 15%">Số lượng</th>
                        <th style="width: 10%">Thành tiền</th>
                        <th style="width: 10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-width: 80px;" />
                            </td>
                            <td class="fw-medium">@item.ProductName</td>
                            <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td>
                                @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex align-items-center gap-2" }))
                                {
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm text-center" style="width: 70px;" min="1" />
                                    <button type="submit" class="btn btn-sm btn-info text-white" title="Cập nhật">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                }
                            </td>
                            <td class="text-danger fw-bold">
                                @item.TotalPrice.ToString("N0") VNĐ
                            </td>
                            <td>
                                <a href="@Url.Action("Remove", "Cart", new { productId = item.ProductId })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end"><strong>Tổng cộng:</strong></td>
                        <td colspan="2" class="text-danger fs-5 fw-bold">
                            @(((decimal)ViewBag.Total).ToString("N0")) VNĐ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row mt-4">
            <div class="col-md-6 mb-3 mb-md-0">
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                </a>
            </div>
            <div class="col-md-6 text-md-end">
                <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg px-5 shadow-sm">
                    Thanh toán <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    }
</div>