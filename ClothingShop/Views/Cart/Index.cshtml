@model List<ClothingShop.Web.ViewModels.CartItemVM>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = ViewBag.Total != null ? (decimal)ViewBag.Total : 0;
}

<div class="py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="section-title mb-0"><i class="bi bi-bag-check me-2"></i>Giỏ hàng của bạn</h2>
        <span class="text-muted small">@(Model != null ? Model.Count : 0) sản phẩm</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive border bg-white" style="border-radius: 14px; overflow: hidden;">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase small" style="letter-spacing: .06em;">
                        <th style="width: 110px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th style="width: 170px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th class="text-end" style="width: 110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var imgPath = string.IsNullOrWhiteSpace(item.ImageUrl)
                            ? "~/Content/images/products/default.jpg"
                            : (item.ImageUrl.StartsWith("~") || item.ImageUrl.StartsWith("/") ? item.ImageUrl : "~/Content/images/products/" + item.ImageUrl);

                        <tr data-row-id="@item.ProductId">
                            <td>
                                <a href="@Url.Action("Details", "Product", new { id = item.ProductId })">
                                    <img src="@Url.Content(imgPath)"
                                         alt="@item.ProductName"
                                         style="width: 72px; height: 88px; object-fit: cover; border-radius: 10px; background: var(--tile);" />
                                </a>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="fw-semibold text-decoration-none">
                                    @item.ProductName
                                </a>
                            </td>
                            <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td>
                                <div class="qty">
                                    <button type="button" class="js-qty-btn" data-step="-1" data-id="@item.ProductId" aria-label="Giảm">-</button>
                                    <input type="number" class="js-qty-input" data-id="@item.ProductId" value="@item.Quantity" min="1" />
                                    <button type="button" class="js-qty-btn" data-step="1" data-id="@item.ProductId" aria-label="Tăng">+</button>
                                </div>
                            </td>
                            <td class="fw-semibold text-danger js-item-total">@item.TotalPrice.ToString("N0") VNĐ</td>
                            <td class="text-end">
                                <a href="@Url.Action("Remove", "Cart", new { productId = item.ProductId })"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-semibold">Tổng cộng:</td>
                        <td colspan="2" class="fs-5 fw-bold text-danger" id="cartGrandTotal">@total.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
            </a>
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-success px-4">
                Thanh toán <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }
    else
    {
        <div class="empty-catalog">
            <i class="bi bi-bag-x fs-1 text-muted d-block mb-3"></i>
            <p class="text-uppercase mb-2" style="letter-spacing: .08em;">Giỏ hàng của bạn đang trống</p>
            <p class="text-muted small mb-4">Hãy chọn thêm sản phẩm yêu thích để tiếp tục mua sắm.</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-ink">Khám phá sản phẩm</a>
        </div>
    }
</div>

@section scripts {
    <script>
        (function () {
            var updateUrl = '@Url.Action("Update", "Cart")';

            function syncQuantity(productId, qty) {
                if (qty < 1) qty = 1;
                var row = document.querySelector('tr[data-row-id="' + productId + '"]');
                var input = row ? row.querySelector('.js-qty-input') : null;
                if (input) input.value = qty;

                $.post(updateUrl, { productId: productId, quantity: qty }, function (res) {
                    if (res && res.success) {
                        if (row) {
                            var itemTotalEl = row.querySelector('.js-item-total');
                            if (itemTotalEl) itemTotalEl.textContent = res.itemTotal;
                        }
                        var grandTotalEl = document.getElementById('cartGrandTotal');
                        if (grandTotalEl) grandTotalEl.textContent = res.cartTotal;
                    }
                });
            }

            document.querySelectorAll('.js-qty-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-id');
                    var step = parseInt(btn.getAttribute('data-step'), 10);
                    var row = document.querySelector('tr[data-row-id="' + id + '"]');
                    var input = row.querySelector('.js-qty-input');
                    var nextVal = (parseInt(input.value, 10) || 1) + step;
                    if (nextVal >= 1) {
                        syncQuantity(id, nextVal);
                    }
                });
            });

            document.querySelectorAll('.js-qty-input').forEach(function (input) {
                input.addEventListener('change', function () {
                    var id = input.getAttribute('data-id');
                    var val = parseInt(input.value, 10) || 1;
                    syncQuantity(id, val);
                });
            });
        })();
    </script>
}