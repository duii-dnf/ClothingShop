@model IEnumerable<ClothingShop.Models.Product>
@{
    ViewBag.Title = "Sản phẩm yêu thích";
}

<div class="bg-dark text-white py-4 mb-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="badge bg-danger rounded-pill mb-1"><i class="bi bi-heart-fill me-1"></i>WISHLIST</span>
            <h2 class="fw-bold mb-0">SẢN PHẨM YÊU THÍCH CỦA BẠN</h2>
        </div>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-light btn-sm rounded-pill px-4">
            <i class="bi bi-bag me-1"></i>Khám phá thêm sản phẩm
        </a>
    </div>
</div>

<div class="container pb-5">
    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-4 shadow-sm text-center py-5">
            <i class="bi bi-heart display-2 text-muted"></i>
            <h4 class="fw-bold mt-3">Chưa có sản phẩm yêu thích nào</h4>
            <p class="text-muted small">Nhấn biểu tượng trái tim trên sản phẩm bạn thích để lưu lại xem sau nhé!</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-dark rounded-pill px-4 mt-2 fw-semibold">
                Đi mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="mb-3 small text-muted">
            Bạn đang lưu <strong class="text-dark">@Model.Count()</strong> sản phẩm yêu thích
        </div>
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3">
                    @Html.Partial("_ProductCard", item)
                </div>
            }
        </div>
    }
</div>
