@model ClothingShop.Models.Product
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = Model.Name;
    bool hasSale = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < Model.Price;
    int salePct = hasSale && Model.Price > 0 ? (int)Math.Round((1m - Model.DiscountPrice.Value / Model.Price) * 100m) : 0;
    decimal saving = hasSale ? (Model.Price - Model.DiscountPrice.Value) : 0m;

    string img = string.IsNullOrEmpty(Model.ImageUrl)
        ? Url.Content("~/Content/images/products/default.jpg")
        : (Model.ImageUrl.StartsWith("http") || Model.ImageUrl.StartsWith("/")
            ? Model.ImageUrl
            : Url.Content("~/Content/images/products/" + Model.ImageUrl));

    var variants = Model.ProductVariants != null
        ? Model.ProductVariants.Where(v => v.IsActive).OrderByDescending(v => v.Stock > 0).ThenBy(v => v.VariantId).ToList()
        : new List<ProductVariant>();
    var firstAvailable = variants.FirstOrDefault(v => v.Stock > 0) ?? variants.FirstOrDefault();
    var related = ViewBag.RelatedProducts as List<Product> ?? new List<Product>();
    var favIds = Session["FavIds"] as List<int>;
    var parentCategory = ViewBag.ParentCategory as Category;
    bool isFav = favIds != null && favIds.Contains(Model.ProductId);
}

@functions {
    public string GetColorDot(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#adb5bd";
        var k = name.Trim().ToLowerInvariant();
        if (k.Contains("đen") || k.Contains("black")) return "#1a1a1a";
        if (k.Contains("trắng") || k.Contains("white") || k.Contains("kem")) return "#f8f9fa";
        if (k.Contains("navy") || k.Contains("than")) return "#1b2a4a";
        if (k.Contains("xanh dương") || k.Contains("blue")) return "#2563eb";
        if (k.Contains("rêu") || k.Contains("olive") || k.Contains("xanh lá") || k.Contains("green")) return "#3f6212";
        if (k.Contains("be") || k.Contains("beige") || k.Contains("nâu") || k.Contains("brown")) return "#a18072";
        if (k.Contains("xám") || k.Contains("ghi") || k.Contains("gray") || k.Contains("grey")) return "#6c757d";
        if (k.Contains("đỏ") || k.Contains("red") || k.Contains("burgundy")) return "#b91c1c";
        if (k.Contains("hồng") || k.Contains("pink")) return "#ec4899";
        if (k.Contains("vàng") || k.Contains("yellow")) return "#eab308";
        return "#9ca3af";
    }
}

<style>
    .pdp-img-box {
        cursor: zoom-in;
    }

        .pdp-img-box img {
            transition: transform .25s ease-out;
            will-change: transform, transform-origin;
        }

        .pdp-img-box.is-zooming img {
            transition: transform .08s linear;
        }

    .pdp-zoom-lens {
        position: absolute;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, .9);
        box-shadow: 0 4px 16px rgba(0, 0, 0, .25);
        background: rgba(255, 255, 255, .12);
        pointer-events: none;
        transform: translate(-50%, -50%);
        opacity: 0;
        transition: opacity .2s ease;
        z-index: 2;
    }

    .pdp-img-box.is-zooming .pdp-zoom-lens {
        opacity: 1;
    }

    .pdp-zoom-hint {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: rgba(26, 26, 26, .72);
        color: #fff;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 50rem;
        pointer-events: none;
        transition: opacity .2s ease;
        z-index: 2;
    }

    .pdp-img-box.is-zooming .pdp-zoom-hint {
        opacity: 0;
    }

    .catalog-card-wrap {
        transition: transform .3s ease;
    }

        .catalog-card-wrap:hover {
            transform: translateY(-4px);
        }

        .catalog-card-wrap .card,
        .catalog-card-wrap .position-relative,
        .catalog-card-wrap a:has(img) {
            overflow: hidden;
        }

        .catalog-card-wrap img {
            transition: transform .45s cubic-bezier(.25, .8, .25, 1);
            will-change: transform;
        }

        .catalog-card-wrap:hover img {
            transform: scale(1.05);
        }

    .variant-pill-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1.5px solid #dee2e6;
        border-radius: 50rem;
        padding: 7px 14px;
        font-size: 13px;
        cursor: pointer;
        transition: all .2s ease;
        background: #fff;
        color: #212529;
    }

        .variant-pill-label:hover {
            border-color: #212529;
            transform: translateY(-1px);
        }

    .btn-check:checked + .variant-pill-label {
        background: #212529;
        border-color: #212529;
        color: #fff;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .12);
    }

    .btn-check:disabled + .variant-pill-label {
        opacity: .45;
        cursor: not-allowed;
        text-decoration: line-through;
    }

    .color-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 1px solid rgba(0, 0, 0, .25);
        display: inline-block;
        flex-shrink: 0;
    }

    .btn-check:checked + .variant-pill-label .color-dot {
        border-color: rgba(255, 255, 255, .75);
    }
</style>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")" class="text-decoration-none text-muted">Cửa hàng</a></li>
            @if (Model.Category != null)
            {
                if (parentCategory != null)
                {
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Product", new { categoryId = parentCategory.CategoryId })" class="text-decoration-none text-muted">
                            @parentCategory.Name
                        </a>
                    </li>
                }
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Product", new { categoryId = Model.CategoryId })" class="text-decoration-none text-muted">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-dark fw-semibold">@Model.Name</li>
        </ol>
    </nav>

    <div class="bg-white rounded-4 shadow-sm p-3 p-md-4 mb-5">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-md-5">
                <div class="position-relative rounded-4 overflow-hidden shadow-sm pdp-img-box" id="pdpZoomBox">
                    <img src="@img" alt="@Model.Name" class="img-fluid w-100" id="pdpMainImg" />
                    <span class="pdp-zoom-lens" id="pdpZoomLens"></span>
                    <span class="pdp-zoom-hint"><i class="bi bi-search me-1"></i>Rê chuột để soi chi tiết</span>
                    <div class="position-absolute top-0 start-0 p-3 d-flex gap-2" style="z-index:3;">
                        @if (hasSale && salePct > 0)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold">-@salePct%</span>
                        }
                        @if (Model.IsNew)
                        {
                            <span class="badge bg-dark rounded-pill px-3 py-2">NEW DROP</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-dark rounded-pill px-3 py-2">@Model.Category.Name</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Gender))
                    {
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@Model.Gender</span>
                    }
                    @if (Model.ProductStyles != null)
                    {
                        foreach (var st in Model.ProductStyles)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-semibold">#@st.Name</span>
                        }
                    }
                </div>

                <h2 class="fw-bold mb-3">@Model.Name</h2>

                <div class="bg-light rounded-4 p-3 mb-4 d-flex flex-wrap align-items-center gap-3">
                    @if (hasSale)
                    {
                        <span class="fs-2 fw-bold text-danger">@PriceFormatter.Vnd(Model.DiscountPrice)</span>
                        <span class="fs-5 text-muted text-decoration-line-through">@PriceFormatter.Vnd(Model.Price)</span>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2 fw-semibold">
                            Tiết kiệm @PriceFormatter.Vnd(saving)
                        </span>
                    }
                    else
                    {
                        <span class="fs-2 fw-bold text-dark">@PriceFormatter.Vnd(Model.Price)</span>
                    }
                </div>

                <p class="text-secondary lh-lg mb-4">@Model.Description</p>

                <div class="mb-4">
                    @if (Model.Stock > 0)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i>Còn hàng &bull; Tổng kho: @Model.Stock sản phẩm
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2">
                            <i class="bi bi-x-circle-fill me-1"></i>Tạm hết hàng
                        </span>
                    }
                </div>

                @using (Html.BeginForm("Add", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                    if (variants.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold small text-uppercase text-muted mb-0">
                                    Chọn phân loại (Size &bull; Màu sắc)
                                </label>
                                <span class="small text-muted">@variants.Count tùy chọn</span>
                            </div>

                            <div class="p-3 bg-light rounded-4 border d-flex flex-wrap gap-2">
                                @foreach (var v in variants)
                                {
                                    string sizeName = v.ProductSize != null ? v.ProductSize.Name : "Freesize";
                                    string colorName = v.ProductColor != null ? v.ProductColor.Name : "Mặc định";
                                    string hex = GetColorDot(colorName);
                                    bool isChecked = firstAvailable != null && v.VariantId == firstAvailable.VariantId;
                                    bool outOfStock = v.Stock <= 0;
                                    string radioId = "var_" + v.VariantId;

                                    <div>
                                        <input class="btn-check" type="radio" name="variantId" id="@radioId" value="@v.VariantId"
                                               autocomplete="off" @(isChecked ? "checked" : "") @(outOfStock ? "disabled" : "") required />
                                        <label class="variant-pill-label" for="@radioId" title="SKU: @v.SKU">
                                            <span class="color-dot" style="background-color:@hex;"></span>
                                            <span class="fw-semibold">@sizeName &mdash; @colorName</span>
                                            @if (v.Price.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">@PriceFormatter.Vnd(v.Price)</span>
                                            }
                                            <span class="small opacity-75">(@(outOfStock ? "Hết" : "Còn " + v.Stock))</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="row g-3 align-items-end">
                        <div class="col-4 col-sm-3">
                            <label class="form-label fw-bold small text-uppercase text-muted">Số lượng</label>
                            <input type="number" name="quantity" value="1" min="1" max="@Math.Max(1, Model.Stock)"
                                   class="form-control form-control-lg rounded-pill text-center fw-bold" @(Model.Stock <= 0 ? "disabled" : "") />
                        </div>
                        <div class="col-8 col-sm-9">
                            <button type="submit" class="btn btn-dark btn-lg rounded-pill w-100 fw-bold py-3" @(Model.Stock <= 0 ? "disabled" : "")>
                                <i class="bi bi-bag-plus-fill me-2"></i>THÊM VÀO GIỎ HÀNG
                            </button>
                        </div>
                    </div>
                }

                <div class="mt-3">
                    @using (Html.BeginForm("Toggle", "Favorite", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                        <button type="submit" class="btn @(isFav ? "btn-danger" : "btn-outline-danger") rounded-pill w-100 fw-semibold py-2">
                            <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart") me-2"></i>
                            @(isFav ? "Đã lưu trong danh sách Yêu thích (Nhấn để bỏ)" : "Thêm vào danh sách Yêu thích")
                        </button>
                    }
                </div>

                <div class="row g-2 mt-4 pt-3 border-top small text-muted">
                    <div class="col-6"><i class="bi bi-truck text-dark me-1"></i>Freeship đơn từ 500K</div>
                    <div class="col-6"><i class="bi bi-arrow-repeat text-dark me-1"></i>Đổi size miễn phí 7 ngày</div>
                    <div class="col-6"><i class="bi bi-ticket-perforated text-dark me-1"></i>Áp dụng mã SALE10 (-10%)</div>
                    <div class="col-6"><i class="bi bi-shield-check text-dark me-1"></i>Kiểm tra hàng trước khi thanh toán</div>
                </div>
            </div>
        </div>
    </div>

    @if (related.Any())
    {
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase small fw-bold text-muted">You May Also Like</span>
                    <h3 class="fw-bold mb-0">Sản phẩm liên quan</h3>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var item in related)
                {
                    <div class="col-6 col-md-3 catalog-card-wrap">
                        @Html.Partial("_ProductCard", item)
                    </div>
                }
            </div>
        </section>
    }
</div>

<script>
    (function () {
        var box = document.getElementById('pdpZoomBox');
        var img = document.getElementById('pdpMainImg');
        var lens = document.getElementById('pdpZoomLens');
        if (!box || !img) return;

        box.addEventListener('mousemove', function (e) {
            var rect = box.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            var px = Math.max(0, Math.min(100, (x / rect.width) * 100));
            var py = Math.max(0, Math.min(100, (y / rect.height) * 100));

            box.classList.add('is-zooming');
            img.style.transformOrigin = px + '% ' + py + '%';
            img.style.transform = 'scale(1.85)';
            if (lens) {
                lens.style.left = x + 'px';
                lens.style.top = y + 'px';
            }
        });

        box.addEventListener('mouseleave', function () {
            box.classList.remove('is-zooming');
            img.style.transform = 'scale(1)';
            img.style.transformOrigin = 'center center';
        });
    })();
</script>