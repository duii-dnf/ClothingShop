@using ClothingShop.Models
@using ClothingShop.Services
@model ClothingShop.Models.Product

@{
    ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var imgPath = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "~/Content/images/products/default.jpg"
        : (Model.ImageUrl.StartsWith("~") || Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "~/Content/images/products/" + Model.ImageUrl);
    var onSale = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < Model.Price;
    var finalPrice = onSale ? Model.DiscountPrice.Value : Model.Price;
    var relatedList = ViewBag.RelatedProducts as IEnumerable<Product>;
}

<nav class="breadcrumb-lite" aria-label="Breadcrumb">
    <a class="back" href="@Url.Action("Index", "Product")"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <span class="sep">/</span>
    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
    <span class="sep">/</span>
    @if (Model.Category != null)
    {
        <a href="@Url.Action("Index", "Product", new { categoryId = Model.CategoryId })">@Model.Category.Name</a>
        <span class="sep">/</span>
    }
    <span>@Model.Name</span>
</nav>

<div class="pdp">
    <div class="pdp-gallery pdp-gallery--single">
        <div class="pdp-gallery__item">
            <img src="@Url.Content(imgPath)" alt="@Model.Name" />
        </div>
    </div>

    <div class="pdp-info">
        <div class="pdp-label">@(Model.Category != null ? Model.Category.Name : "ClothingShop")</div>
        <h1 class="pdp-title">@Model.Name</h1>

        <div class="pdp-price">
            @if (onSale)
            {
                <span>@PriceFormatter.Vnd(Model.DiscountPrice)</span>
                <s>@PriceFormatter.Vnd(Model.Price)</s>
            }
            else
            {
                <span>@PriceFormatter.Vnd(Model.Price)</span>
            }
        </div>

        <div class="pdp-sub">
            @if (Model.Stock > 0)
            {
                <span class="text-success">Còn hàng (@Model.Stock sản phẩm)</span>
            }
            else
            {
                <span class="text-danger">Tạm hết hàng</span>
            }
        </div>

        <div class="opt-head">
            <span>Số lượng</span>
        </div>
        <div class="qty">
            <button type="button" id="qtyMinus" aria-label="Giảm">-</button>
            <input type="number" id="qtyInput" value="1" min="1" max="@(Model.Stock > 0 ? Model.Stock : 1)" />
            <button type="button" id="qtyPlus" aria-label="Tăng">+</button>
        </div>

        <button type="button"
                id="btnAddCart"
                class="btn-add"
                data-url="@Url.Action("Add", "Cart", new { area = "" })"
                data-id="@Model.ProductId"
                data-name="@Model.Name"
                data-img="@(Model.ImageUrl ?? "default.jpg")"
                data-price="@finalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                @(Model.Stock <= 0 ? "disabled" : null)>
            <i class="bi bi-bag"></i>
            <span>@(Model.Stock > 0 ? "Thêm vào giỏ hàng" : "Hết hàng")</span>
        </button>

        <div id="cartFeedback" class="small mt-2" style="display:none;"></div>

        <ul class="pdp-notes">
            <li><i class="bi bi-truck"></i> Miễn phí giao hàng cho đơn từ 500.000₫</li>
            <li><i class="bi bi-arrow-repeat"></i> Đổi trả dễ dàng trong 7 ngày</li>
            <li><i class="bi bi-shield-check"></i> Kiểm tra hàng trước khi thanh toán</li>
        </ul>

        <div class="accordion pdp-acc" id="pdpAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#descCollapse" aria-expanded="true">
                        Mô tả sản phẩm
                    </button>
                </h2>
                <div id="descCollapse" class="accordion-collapse collapse show" data-bs-parent="#pdpAccordion">
                    <div class="accordion-body">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Thiết kế tinh giản, phom dáng chuẩn hiện đại, dễ phối hợp trong nhiều hoàn cảnh." : Model.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (relatedList != null && relatedList.Any())
{
    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Sản phẩm liên quan</h2>
            @if (Model.Category != null)
            {
                <a class="link-underline" href="@Url.Action("Index", "Product", new { categoryId = Model.CategoryId })">Xem thêm</a>
            }
        </div>
        <div class="product-grid product-grid--4">
            @foreach (var item in relatedList)
            {
                @Html.Partial("_ProductCard", item)
            }
        </div>
    </section>
}

@section scripts {
    <script>
        (function () {
            var input = document.getElementById('qtyInput');
            var minus = document.getElementById('qtyMinus');
            var plus = document.getElementById('qtyPlus');
            var btn = document.getElementById('btnAddCart');
            var feedback = document.getElementById('cartFeedback');
            var maxStock = parseInt(input.getAttribute('max'), 10) || 1;

            if (minus) {
                minus.addEventListener('click', function () {
                    var val = parseInt(input.value, 10) || 1;
                    if (val > 1) input.value = val - 1;
                });
            }

            if (plus) {
                plus.addEventListener('click', function () {
                    var val = parseInt(input.value, 10) || 1;
                    if (val < maxStock) input.value = val + 1;
                });
            }

            if (btn) {
                btn.addEventListener('click', function () {
                    var qty = parseInt(input.value, 10) || 1;
                    if (qty < 1) qty = 1;
                    if (qty > maxStock) qty = maxStock;

                    btn.disabled = true;
                    $.post(btn.getAttribute('data-url'), {
                        productId: btn.getAttribute('data-id'),
                        productName: btn.getAttribute('data-name'),
                        imageUrl: btn.getAttribute('data-img'),
                        price: btn.getAttribute('data-price'),
                        quantity: qty
                    }, function (res) {
                        btn.disabled = false;
                        if (res && res.success) {
                            feedback.style.display = 'block';
                            feedback.className = 'small mt-2 text-success';
                            feedback.textContent = res.message + ' (' + qty + ' sản phẩm).';

                            var bag = document.querySelector('.header-actions a[aria-label="Giỏ hàng"]');
                            if (bag) {
                                var badge = bag.querySelector('.cart-count');
                                if (!badge) {
                                    badge = document.createElement('span');
                                    badge.className = 'cart-count';
                                    bag.appendChild(badge);
                                }
                                badge.textContent = res.cartCount;
                            }
                        }
                    }).fail(function () {
                        btn.disabled = false;
                        feedback.style.display = 'block';
                        feedback.className = 'small mt-2 text-danger';
                        feedback.textContent = 'Không thể thêm vào giỏ hàng, vui lòng thử lại.';
                    });
                });
            }
        })();
    </script>
}