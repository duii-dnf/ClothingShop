@using ClothingShop.Models
@using ClothingShop.Services
@model IEnumerable<ClothingShop.Models.Product>

@{
    var activeCategory = ViewBag.CurrentCategory as Category;
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    int? categoryId = ViewBag.CategoryId as int?;
    string keyword = ViewBag.Keyword as string ?? string.Empty;
    string sort = ViewBag.Sort as string ?? ProductSorting.Newest;
    string gender = ViewBag.Gender as string;
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    bool onSale = ViewBag.OnSale ?? false;
    bool isNew = ViewBag.IsNew ?? false;

    string filter = ViewBag.Filter as string ?? string.Empty;
    int totalItems = ViewBag.TotalItems ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    int currentPage = ViewBag.CurrentPage ?? 1;

    bool hasAnyFilter = categoryId.HasValue
        || !string.IsNullOrEmpty(keyword)
        || !string.IsNullOrEmpty(gender)
        || minPrice.HasValue
        || maxPrice.HasValue
        || onSale
        || isNew;

    var genderOptions = new[] { "Nam", "Nữ", "Unisex" };

    ViewBag.Title = activeCategory != null ? activeCategory.Name : "Tất cả sản phẩm";
    string pageHeading = "Tất cả sản phẩm";
    if (activeCategory != null)
    {
        pageHeading = activeCategory.Name;
    }
    else if (filter == "sale" || filter == "deal")
    {
        pageHeading = "Sản phẩm khuyến mãi (Hot Deals)";
    }
    else if (filter == "new")
    {
        pageHeading = "Sản phẩm mới về (New Arrivals)";
    }
    else if (filter == "bestseller" || filter == "hot" || filter == "featured")
    {
        pageHeading = "Sản phẩm bán chạy (Best Sellers)";
    }

    ViewBag.Title = pageHeading;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .listing__side summary,
    .listing__side .filter-list a,
    .listing__side .filter-sublist a,
    .listing__side .filter-pill,
    .listing__side .filter-check-item,
    .listing__side .filter-check-item span,
    .listing__side .btn-filter-apply,
    .listing__side .link-underline {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .listing__side .filter-group summary {
        cursor: pointer;
        user-select: none;
        transition: color .25s cubic-bezier(0.22, 1, 0.36, 1), opacity .25s ease;
    }

        .listing__side .filter-group summary:hover {
            color: #000;
            opacity: .75;
        }

        .listing__side .filter-group summary::after {
            transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1);
        }

    .listing__side .filter-group:not([open]) summary::after {
        transform: rotate(180deg);
    }

    .filter-body {
        overflow: hidden;
        transition: height .32s cubic-bezier(0.22, 1, 0.36, 1), opacity .28s ease;
    }

    .listing__side .filter-list a,
    .listing__side .filter-sublist a {
        display: block;
        transition: transform .25s cubic-bezier(0.22, 1, 0.36, 1), color .2s ease;
    }

        .listing__side .filter-list a:hover,
        .listing__side .filter-sublist a:hover {
            transform: translateX(4px);
            color: #000;
        }

    .filter-pills--gender {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 4px;
        margin-top: 8px;
    }

        .filter-pills--gender .filter-pill {
            padding: 5px 2px;
            font-size: 11.5px;
            text-align: center;
        }

    .filter-pills--price {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 8px;
    }

        .filter-pills--price .filter-pill {
            display: block;
            padding: 6px 10px;
            font-size: 12px;
            text-align: left;
        }

    .filter-pill {
        border: 1px solid #e0dcd6;
        color: #222;
        text-decoration: none;
        background: #fff;
        transition: background-color .25s cubic-bezier(0.22, 1, 0.36, 1), color .25s ease, border-color .25s ease, transform .2s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .filter-pill:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
            transform: translateY(-1px);
        }

        .filter-pill.is-active {
            background: #1a1a1a;
            border-color: #1a1a1a;
            color: #fff;
        }

    .price-range-form {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-top: 8px;
    }

    .price-range-inputs {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 5px;
    }

        .price-range-inputs input {
            width: 100%;
            min-width: 0;
            padding: 5px 7px;
            font-size: 12px;
            border: 1px solid #e0dcd6;
            outline: none;
            transition: border-color .25s ease, box-shadow .25s ease;
        }

            .price-range-inputs input:focus {
                border-color: #1a1a1a;
                box-shadow: 0 0 0 2px rgba(26, 26, 26, .06);
            }

    .btn-filter-apply {
        padding: 6px 10px;
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        background: #1a1a1a;
        color: #fff;
        border: 1px solid #1a1a1a;
        cursor: pointer;
        transition: background-color .25s ease, transform .2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .25s ease;
    }

        .btn-filter-apply:hover {
            background: #333;
            transform: translateY(-1px);
            box-shadow: 0 3px 10px rgba(0, 0, 0, .12);
        }

        .btn-filter-apply:active {
            transform: translateY(0);
        }

    .filter-check-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 8px;
    }

    .filter-check-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: #333;
        text-decoration: none;
        transition: transform .25s cubic-bezier(0.22, 1, 0.36, 1), color .2s ease;
    }

        .filter-check-item:hover {
            color: #000;
            transform: translateX(3px);
        }

    .filter-check-box {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
        border: 1px solid #999;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        transition: background-color .25s ease, border-color .25s ease, transform .2s ease;
    }

    .filter-check-item.is-active .filter-check-box {
        background: #1a1a1a;
        border-color: #1a1a1a;
        color: #fff;
        transform: scale(1.05);
    }

    .active-chips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .active-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: #f5f3f0;
        border: 1px solid #e2ddd7;
        font-size: 12px;
        color: #222;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color .25s ease, border-color .25s ease, color .25s ease, transform .2s ease;
    }

        .active-chip:hover {
            background: #1a1a1a;
            border-color: #1a1a1a;
            color: #fff;
            transform: translateY(-1px);
        }

    @@keyframes cardFadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .product-grid > * {
        animation: cardFadeUp .45s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

        .product-grid > *:nth-child(2) {
            animation-delay: .04s;
        }

        .product-grid > *:nth-child(3) {
            animation-delay: .08s;
        }

        .product-grid > *:nth-child(4) {
            animation-delay: .12s;
        }

        .product-grid > *:nth-child(5) {
            animation-delay: .16s;
        }

        .product-grid > *:nth-child(6) {
            animation-delay: .20s;
        }
</style>

<nav class="breadcrumb-lite" aria-label="Breadcrumb">
    <a class="back" href="@Url.Action("Index", "Home")"><i class="bi bi-arrow-left"></i> Trang chủ</a>
    <span class="sep">/</span>
    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
    @if (activeCategory != null)
    {
        if (activeCategory.Parent != null)
        {
            <span class="sep">/</span>
            <a href="@Url.Action("Index", "Product", new { categoryId = activeCategory.Parent.CategoryId })">@activeCategory.Parent.Name</a>
        }
        <span class="sep">/</span>
        <span>@activeCategory.Name</span>
    }
    else if (!string.IsNullOrEmpty(filter))
    {
        <span class="sep">/</span>
        <span>@pageHeading</span>
    }
</nav>

<h1 class="page-title">@pageHeading</h1>
<p class="page-intro">
    @if (!string.IsNullOrEmpty(keyword))
    {
        <span>Kết quả tìm kiếm cho "@keyword" — @totalItems sản phẩm</span>
    }
    else
    {
        <span>Bộ sưu tập thiết kế tối giản, chất liệu chọn lọc — @totalItems sản phẩm</span>
    }
</p>

<div class="listing">
    <aside class="listing__side">
        <form action="@Url.Action("Index", "Product")" method="get" class="side-search">
            @if (categoryId.HasValue)
            {<input type="hidden" name="categoryId" value="@categoryId" />}
            @if (!string.IsNullOrEmpty(gender))
            {<input type="hidden" name="gender" value="@gender" />}
            @if (minPrice.HasValue)
            {<input type="hidden" name="minPrice" value="@minPrice" />}
            @if (maxPrice.HasValue)
            {<input type="hidden" name="maxPrice" value="@maxPrice" />}
            @if (onSale)
            {<input type="hidden" name="onSale" value="true" />}
            @if (isNew)
            {<input type="hidden" name="isNew" value="true" />}
            {
                <input type="hidden" name="categoryId" value="@categoryId" />
            }
            @if (!string.IsNullOrEmpty(filter))
            {
                <input type="hidden" name="filter" value="@filter" />
            }
            <input type="hidden" name="sort" value="@sort" />
            <input type="text" name="keyword" value="@keyword" placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm" />
            <button type="submit" aria-label="Tìm"><i class="bi bi-search"></i></button>
        </form>

        <details class="filter-group" open>
            <summary>Danh mục</summary>
            <div class="filter-body">
                <ul class="filter-list">
                    <li>
                        <a class="@(!categoryId.HasValue ? "is-active" : "")"
                           href="@Url.Action("Index", "Product", new { keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                            Tất cả sản phẩm
                        </a>
                    </li>
                    @foreach (var cat in categories)
                    {
                        <li>
                            <a class="@(categoryId == cat.CategoryId ? "is-active" : "")"
                               href="@Url.Action("Index", "Product", new { categoryId = cat.CategoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })"
                               title="@cat.Name">
                                @cat.Name
                            </a>
                            @if (cat.Children != null && cat.Children.Any(c => c.IsActive))
                            {
                                <ul class="filter-sublist">
                                    @foreach (var sub in cat.Children.Where(c => c.IsActive).OrderBy(c => c.CategoryId))
                                    {
                                        <li>
                                            <a class="@(categoryId == sub.CategoryId ? "is-active" : "")"
                                               href="@Url.Action("Index", "Product", new { categoryId = sub.CategoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })"
                                               title="@sub.Name">
                                                @sub.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        </details>

        <details class="filter-group" open>
            <summary>Giới tính</summary>
            <div class="filter-body">
                <div class="filter-pills--gender">
                    <a class="filter-pill @(string.IsNullOrEmpty(gender) ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        Tất cả
                    </a>
                    @foreach (var g in genderOptions)
                    {
                        bool activeG = string.Equals(gender, g, StringComparison.OrdinalIgnoreCase);
                        <a class="filter-pill @(activeG ? "is-active" : "")"
                           href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = activeG ? null : g, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                            @g
                        </a>
                    }
                </div>
            </div>
        </details>

        <details class="filter-group" open>
            <summary>Khoảng giá</summary>
            <div class="filter-body">
                <div class="filter-pills--price">
                    <a class="filter-pill @(!minPrice.HasValue && maxPrice == 300000 ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, maxPrice = (!minPrice.HasValue && maxPrice == 300000) ? (decimal?)null : 300000, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        Dưới 300.000₫
                    </a>
                    <a class="filter-pill @(minPrice == 300000 && maxPrice == 600000 ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = (minPrice == 300000 && maxPrice == 600000) ? (decimal?)null : 300000, maxPrice = (minPrice == 300000 && maxPrice == 600000) ? (decimal?)null : 600000, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        300.000₫ – 600.000₫
                    </a>
                    <a class="filter-pill @(minPrice == 600000 && !maxPrice.HasValue ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = (minPrice == 600000 && !maxPrice.HasValue) ? (decimal?)null : 600000, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        Trên 600.000₫
                    </a>
                </div>
                <form action="@Url.Action("Index", "Product")" method="get" class="price-range-form">
                    @if (categoryId.HasValue)
                    {<input type="hidden" name="categoryId" value="@categoryId" />}
                    @if (!string.IsNullOrEmpty(keyword))
                    {<input type="hidden" name="keyword" value="@keyword" />}
                    @if (!string.IsNullOrEmpty(gender))
                    {<input type="hidden" name="gender" value="@gender" />}
                    @if (onSale)
                    {<input type="hidden" name="onSale" value="true" />}
                    @if (isNew)
                    {<input type="hidden" name="isNew" value="true" />}
                    <input type="hidden" name="sort" value="@sort" />
                    <div class="price-range-inputs">
                        <input type="number" name="minPrice" value="@(minPrice.HasValue ? ((int)minPrice.Value).ToString() : "")" placeholder="Từ (₫)" min="0" step="10000" />
                        <span>–</span>
                        <input type="number" name="maxPrice" value="@(maxPrice.HasValue ? ((int)maxPrice.Value).ToString() : "")" placeholder="Đến (₫)" min="0" step="10000" />
                    </div>
                    <button type="submit" class="btn-filter-apply">Áp dụng giá</button>
                </form>
            </div>
        </details>

        <details class="filter-group" open>
            <summary>Ưu đãi & Trạng thái</summary>
            <div class="filter-body">
                <div class="filter-check-list">
                    <a class="filter-check-item @(onSale ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)null : true, isNew = isNew ? (bool?)true : null })">
                        <span class="filter-check-box">@(onSale ? "✓" : "")</span>
                        <span>Đang giảm giá</span>
                    </a>
                    <a class="filter-check-item @(isNew ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)null : true })">
                        <span class="filter-check-box">@(isNew ? "✓" : "")</span>
                        <span>Hàng mới về</span>
                    </a>
                </div>
            </div>
        </details>

        @if (hasAnyFilter)
        {
            <div class="mt-3">
                <a class="link-underline" href="@Url.Action("Index", "Product")">Xóa tất cả bộ lọc</a>
            </div>
        }
    </aside>

    <div>
        @if (hasAnyFilter)
        {
            <div class="active-chips">
                @if (activeCategory != null)
                {
                    <a class="active-chip" href="@Url.Action("Index", "Product", new { keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        <span>Loại: @activeCategory.Name</span> <strong>×</strong>
                    </a>
                }
                @if (!string.IsNullOrEmpty(gender))
                {
                    <a class="active-chip" href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        <span>Giới tính: @gender</span> <strong>×</strong>
                    </a>
                }
                @if (minPrice.HasValue || maxPrice.HasValue)
                {
                    var priceText = (minPrice.HasValue ? PriceFormatter.Vnd(minPrice) : "0₫") + " – " + (maxPrice.HasValue ? PriceFormatter.Vnd(maxPrice) : "Trở lên");
                    <a class="active-chip" href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null })">
                        <span>Giá: @priceText</span> <strong>×</strong>
                    </a>
                }
                @if (onSale)
                {
                    <a class="active-chip" href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, isNew = isNew ? (bool?)true : null })">
                        <span>Đang giảm giá</span> <strong>×</strong>
                    </a>
                }
                @if (isNew)
                {
                    <a class="active-chip" href="@Url.Action("Index", "Product", new { categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null })">
                        <span>Hàng mới về</span> <strong>×</strong>
                    </a>
                }
            </div>
        }

        <div class="sort-bar">
            <label class="sort-bar__label" for="catalogSort">Sắp xếp</label>
            <select id="catalogSort" class="form-select sort-select" onchange="location.href=this.value">
                @foreach (var opt in ProductSorting.Options)
                {
                    var url = Url.Action("Index", "Product", new
                    {
                        categoryId = categoryId,
                        keyword = string.IsNullOrEmpty(keyword) ? null : keyword,
                        gender = gender,
                        minPrice = minPrice,
                        maxPrice = maxPrice,
                        onSale = onSale ? (bool?)true : null,
                        isNew = isNew ? (bool?)true : null,
                        sort = opt.Key
                        sort = opt.Key,
                        filter = string.IsNullOrEmpty(filter) ? null : filter
                    });
                    <option value="@url" @(sort == opt.Key ? "selected" : null)>@opt.Value</option>
                }
            </select>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="product-grid product-grid--3">
                @foreach (var item in Model)
                {
                    @Html.Partial("_ProductCard", item)
                }
            </div>
        }
        else
        {
            <div class="empty-catalog">
                <p class="text-uppercase mb-2" style="letter-spacing:.08em;">Không tìm thấy sản phẩm phù hợp</p>
                <p class="text-muted small mb-4">Thử thay đổi từ khóa hoặc nới lỏng điều kiện lọc.</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-ink">Xem tất cả sản phẩm</a>
            </div>
        }

        @if (totalPages > 1)
        {
            <nav class="pager" aria-label="Phân trang">
                @if (currentPage > 1)
                {
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage - 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null, sort = sort })">Trước</a>
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage - 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">Trước</a>
                }
                else
                {
                    <span class="pager__nav is-disabled">Trước</span>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="is-current">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Product", new { page = i, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null, sort = sort })">@i</a>
                        <a href="@Url.Action("Index", "Product", new { page = i, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">@i</a>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage + 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, gender = gender, minPrice = minPrice, maxPrice = maxPrice, onSale = onSale ? (bool?)true : null, isNew = isNew ? (bool?)true : null, sort = sort })">Sau</a>
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage + 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">Sau</a>
                }
                else
                {
                    <span class="pager__nav is-disabled">Sau</span>
                }
            </nav>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            document.querySelectorAll('.listing__side .filter-group').forEach(function (details) {
                var summary = details.querySelector('summary');
                var body = details.querySelector('.filter-body');
                if (!summary || !body) return;

                var isAnimating = false;

                summary.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (isAnimating) return;
                    isAnimating = true;

                    if (details.hasAttribute('open')) {
                        body.style.height = body.scrollHeight + 'px';
                        body.style.opacity = '1';
                        requestAnimationFrame(function () {
                            body.style.height = '0px';
                            body.style.opacity = '0';
                        });
                        setTimeout(function () {
                            details.removeAttribute('open');
                            body.style.height = '';
                            body.style.opacity = '';
                            isAnimating = false;
                        }, 320);
                    } else {
                        details.setAttribute('open', '');
                        var targetHeight = body.scrollHeight;
                        body.style.height = '0px';
                        body.style.opacity = '0';
                        requestAnimationFrame(function () {
                            body.style.height = targetHeight + 'px';
                            body.style.opacity = '1';
                        });
                        setTimeout(function () {
                            body.style.height = '';
                            body.style.opacity = '';
                            isAnimating = false;
                        }, 320);
                    }
                });
            });
        })();
    </script>
}