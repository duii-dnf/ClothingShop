@using ClothingShop.Models
@using ClothingShop.Services
@model IEnumerable<ClothingShop.Models.Product>

@{
    var activeCategory = ViewBag.CurrentCategory as Category;
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    int? categoryId = ViewBag.CategoryId as int?;
    string keyword = ViewBag.Keyword as string ?? string.Empty;
    string sort = ViewBag.Sort as string ?? ProductSorting.Newest;
    string filter = ViewBag.Filter as string ?? string.Empty;
    int totalItems = ViewBag.TotalItems ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    int currentPage = ViewBag.CurrentPage ?? 1;

    string pageHeading = "Tất cả sản phẩm";
    if (activeCategory != null)
    {
        pageHeading = activeCategory.Name;
    }
    else if (filter == "sale" || filter == "deal")
    {
        pageHeading = "Sản phẩm khuyến mãi (Hot Deals)";
    }
    else if (filter == "new")
    {
        pageHeading = "Sản phẩm mới về (New Arrivals)";
    }
    else if (filter == "bestseller" || filter == "hot" || filter == "featured")
    {
        pageHeading = "Sản phẩm bán chạy (Best Sellers)";
    }

    ViewBag.Title = pageHeading;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav class="breadcrumb-lite" aria-label="Breadcrumb">
    <a class="back" href="@Url.Action("Index", "Home")"><i class="bi bi-arrow-left"></i> Trang chủ</a>
    <span class="sep">/</span>
    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
    @if (activeCategory != null)
    {
        <span class="sep">/</span>
        <span>@activeCategory.Name</span>
    }
    else if (!string.IsNullOrEmpty(filter))
    {
        <span class="sep">/</span>
        <span>@pageHeading</span>
    }
</nav>

<h1 class="page-title">@pageHeading</h1>
<p class="page-intro">
    @if (!string.IsNullOrEmpty(keyword))
    {
        <span>Kết quả tìm kiếm cho "@keyword" — @totalItems sản phẩm</span>
    }
    else
    {
        <span>Bộ sưu tập thiết kế tối giản, chất liệu chọn lọc — @totalItems sản phẩm</span>
    }
</p>

<div class="listing">
    <aside class="listing__side">
        <form action="@Url.Action("Index", "Product")" method="get" class="side-search">
            @if (categoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@categoryId" />
            }
            @if (!string.IsNullOrEmpty(filter))
            {
                <input type="hidden" name="filter" value="@filter" />
            }
            <input type="hidden" name="sort" value="@sort" />
            <input type="text" name="keyword" value="@keyword" placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm" />
            <button type="submit" aria-label="Tìm"><i class="bi bi-search"></i></button>
        </form>

        <details class="filter-group" open>
            <summary>Danh mục</summary>
            <ul class="filter-list">
                <li>
                    <a class="@(!categoryId.HasValue ? "is-active" : "")"
                       href="@Url.Action("Index", "Product", new { keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort })">
                        Tất cả sản phẩm
                    </a>
                </li>
                @foreach (var cat in categories)
                {
                    <li>
                        <a class="@(categoryId == cat.CategoryId ? "is-active" : "")"
                           href="@Url.Action("Index", "Product", new { categoryId = cat.CategoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort })">
                            @cat.Name
                        </a>
                        @if (cat.Children != null && cat.Children.Any(c => c.IsActive))
                        {
                            <ul class="filter-sublist">
                                @foreach (var sub in cat.Children.Where(c => c.IsActive).OrderBy(c => c.CategoryId))
                                {
                                    <li>
                                        <a class="@(categoryId == sub.CategoryId ? "is-active" : "")"
                                           href="@Url.Action("Index", "Product", new { categoryId = sub.CategoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort })">
                                            @sub.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </details>

        @if (categoryId.HasValue || !string.IsNullOrEmpty(keyword))
        {
            <div class="mt-3">
                <a class="link-underline" href="@Url.Action("Index", "Product")">Xóa bộ lọc</a>
            </div>
        }
    </aside>

    <div>
        <div class="sort-bar">
            <label class="sort-bar__label" for="catalogSort">Sắp xếp</label>
            <select id="catalogSort" class="form-select sort-select" onchange="location.href=this.value">
                @foreach (var opt in ProductSorting.Options)
                {
                    var url = Url.Action("Index", "Product", new
                    {
                        categoryId = categoryId,
                        keyword = string.IsNullOrEmpty(keyword) ? null : keyword,
                        sort = opt.Key,
                        filter = string.IsNullOrEmpty(filter) ? null : filter
                    });
                    <option value="@url" @(sort == opt.Key ? "selected" : null)>@opt.Value</option>
                }
            </select>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="product-grid product-grid--3">
                @foreach (var item in Model)
                {
                    @Html.Partial("_ProductCard", item)
                }
            </div>
        }
        else
        {
            <div class="empty-catalog">
                <p class="text-uppercase mb-2" style="letter-spacing:.08em;">Không tìm thấy sản phẩm phù hợp</p>
                <p class="text-muted small mb-4">Thử thay đổi từ khóa hoặc chọn danh mục khác.</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-ink">Xem tất cả sản phẩm</a>
            </div>
        }

        @if (totalPages > 1)
        {
            <nav class="pager" aria-label="Phân trang">
                @if (currentPage > 1)
                {
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage - 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">Trước</a>
                }
                else
                {
                    <span class="pager__nav is-disabled">Trước</span>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="is-current">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Product", new { page = i, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">@i</a>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a class="pager__nav" href="@Url.Action("Index", "Product", new { page = currentPage + 1, categoryId = categoryId, keyword = string.IsNullOrEmpty(keyword) ? null : keyword, sort = sort, filter = string.IsNullOrEmpty(filter) ? null : filter })">Sau</a>
                }
                else
                {
                    <span class="pager__nav is-disabled">Sau</span>
                }
            </nav>
        }
    </div>
</div>