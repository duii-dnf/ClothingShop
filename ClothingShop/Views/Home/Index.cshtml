@model ClothingShop.ViewModels.HomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    ViewBag.FullWidth = true;   // hero và khối ảnh trải hết chiều ngang
    ViewBag.PromoWine = true;   // dải thông báo màu đỏ rượu như mẫu

    var heroUrl = Url.Content("~/Content/images/hero.jpg");
    var ed1 = Url.Content("~/Content/images/editorial-1.jpg");
    var ed2 = Url.Content("~/Content/images/editorial-2.jpg");
    var defaultImg = "~/Content/images/products/default.jpg";

    string link1 = Model.Categories.Count > 0
        ? Url.Action("Index", "Product", new { area = "", categoryId = Model.Categories[0].Id })
        : Url.Action("Index", "Product", new { area = "" });
    string link2 = Model.Categories.Count > 1
        ? Url.Action("Index", "Product", new { area = "", categoryId = Model.Categories[1].Id })
        : link1;
}

<section class="hero-banner" style="background-image:url('@heroUrl')">
    <h1 class="hero-banner__title">Bộ sưu tập mới</h1>
    <div class="hero-banner__caption">
        Thời trang cho mọi phong cách.<br />
        <a href="@Url.Action("Index", "Product", new { area = "" })">Khám phá ngay</a>
    </div>
</section>

@if (Model.Categories.Any())
{
    <section class="section container">
        <div class="section-head">
            <h2 class="section-title">Danh mục</h2>
            <div class="arrow-btns" id="catArrows">
                <button type="button" data-scroll="-1" aria-label="Trước"><i class="bi bi-arrow-left"></i></button>
                <button type="button" data-scroll="1" aria-label="Sau"><i class="bi bi-arrow-right"></i></button>
            </div>
        </div>
        <div class="cat-strip" id="catStrip">
            @foreach (var c in Model.Categories)
            {
                <a class="cat-tile" href="@Url.Action("Index", "Product", new { area = "", categoryId = c.Id })">
                    <img src="@Url.Content(string.IsNullOrWhiteSpace(c.ImageUrl) ? defaultImg : c.ImageUrl)" alt="@c.Name" loading="lazy" />
                    <span class="cat-tile__label">@c.Name</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.NewProducts.Any())
{
    <section class="section container">
        <div class="product-grid product-grid--4">
            @foreach (var p in Model.NewProducts)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>
}

<section class="section-wide">
    <div class="split">
        <a class="split__panel" style="background-image:url('@ed1')" href="@link1" aria-label="Xem bộ sưu tập"></a>
        <a class="split__panel" style="background-image:url('@ed2')" href="@link2" aria-label="Xem bộ sưu tập"></a>
    </div>
</section>

@if (Model.FeaturedProducts.Any())
{
    <section class="section container">
        <div class="product-grid product-grid--4">
            @foreach (var p in Model.FeaturedProducts)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>
}

@section Scripts {
    <script>(function () {
            var strip = document.getElementById('catStrip');
            var arrows = document.getElementById('catArrows');
            if (!strip) return;

            // Ẩn mũi tên khi dải danh mục không cần cuộn
            function toggleArrows() {
                if (arrows) arrows.style.visibility = strip.scrollWidth > strip.clientWidth + 2 ? 'visible' : 'hidden';
            }
            toggleArrows();
            window.addEventListener('resize', toggleArrows);

            document.querySelectorAll('[data-scroll]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    strip.scrollBy({ left: parseInt(btn.getAttribute('data-scroll'), 10) * strip.clientWidth * 0.8, behavior: 'smooth' });
                });
            });
        })();</script>
}