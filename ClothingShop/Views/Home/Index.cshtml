@using ClothingShop.Services
@model ClothingShop.ViewModels.HomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    ViewBag.FullWidth = true;
    ViewBag.PromoWine = true;

    string allUrl = Url.Action("Index", "Product", new { area = "" });
    string link1 = Model.Categories.Count > 0
        ? Url.Action("Index", "Product", new { area = "", categoryId = Model.Categories[0].Id }) : allUrl;
    string link2 = Model.Categories.Count > 1
        ? Url.Action("Index", "Product", new { area = "", categoryId = Model.Categories[1].Id }) : allUrl;

    var slides = new[]
    {
        new { Img = "~/Content/images/hero/hero-1.jpg", Alt = "Bộ sưu tập mới", Url = allUrl },
        new { Img = "~/Content/images/hero/hero-2.jpg", Alt = "Ưu đãi thành viên", Url = link1 },
        new { Img = "~/Content/images/hero/hero-3.jpg", Alt = "Xu hướng mới", Url = link2 }
    };
}

<section class="hero-carousel container" aria-label="Banner nổi bật">
    <div id="heroCarousel" class="carousel slide hero-frame" data-bs-ride="carousel" data-bs-interval="4800" data-bs-pause="hover">
        <div class="carousel-inner">
            @for (int i = 0; i < slides.Length; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a class="hero-slide" href="@slides[i].Url" aria-label="@slides[i].Alt"
                       style="background-image:url('@Url.Content(slides[i].Img)')"></a>
                </div>
            }
        </div>

        @if (slides.Length > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="hero-arrow" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                <span class="visually-hidden">Banner trước</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="hero-arrow" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                <span class="visually-hidden">Banner sau</span>
            </button>

            <div class="carousel-indicators">
                @for (int i = 0; i < slides.Length; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)"
                            aria-label="Banner @(i + 1)"></button>
                }
            </div>
        }
    </div>
</section>

@if (Model.Categories.Any())
{
    <section class="section container">
        <div class="section-head">
            <h2 class="section-title">Danh mục</h2>
        </div>
        <div class="cat-pills">
            <button type="button" class="cat-pill cat-pill--all is-active" data-category-id="">
                <span>Tất cả</span>
                <i class="bi bi-arrow-up-right"></i>
            </button>
            @foreach (var c in Model.Categories)
            {
                <button type="button" class="cat-pill" data-category-id="@c.Id">
                    <span>@c.Name</span>
                    <i class="bi bi-arrow-up-right"></i>
                </button>
            }
        </div>
    </section>
}

<section class="section container" id="products">
    <div class="section-head">
        <h2 class="section-title" id="productGridTitle">Sản phẩm mới</h2>
        @Html.Partial("_SortDropdown", Model.Sort)
    </div>

    <div id="ajaxProductContainer" style="transition: opacity 0.3s ease;">
        @if (Model.NewProducts.Any())
        {
            <div class="product-grid product-grid--4">
                @foreach (var p in Model.NewProducts)
                {
                    @Html.Partial("_ProductCard", p)
                }
            </div>
        }
        else
        {
            <p class="text-center text-muted py-5">Chưa có sản phẩm nào.</p>
        }
    </div>
</section>

@if (Model.FeaturedProducts.Any())
{
    <section class="section container">
        <div class="section-head">
            <h2 class="section-title">Sản phẩm nổi bật</h2>
        </div>
        <div class="product-grid product-grid--4">
            @foreach (var p in Model.FeaturedProducts)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        (function () {
            var heroEl = document.getElementById('heroCarousel');
            if (heroEl && window.bootstrap && bootstrap.Carousel) {
                bootstrap.Carousel.getOrCreateInstance(heroEl, {
                    interval: 4800,
                    pause: 'hover',
                    ride: 'carousel',
                    wrap: true
                });
            }

            var pills = document.querySelectorAll('.cat-pill');
            var container = document.getElementById('ajaxProductContainer');
            var titleEl = document.getElementById('productGridTitle');
            var sortSelect = document.getElementById('catalogSort') || document.querySelector('.sort-select');

            function loadCategoryProducts(categoryId, sortValue) {
                if (!container) return;
                container.style.opacity = '0.4';

                var url = '@Url.Action("Index", "Product")';
                var data = { page: 1 };
                if (categoryId) data.categoryId = categoryId;
                if (sortValue) data.sort = sortValue;

                $.get(url, data, function (html) {
                    var tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html;

                    var newGrid = tempDiv.querySelector('.product-grid');
                    var emptyCatalog = tempDiv.querySelector('.empty-catalog');

                    container.innerHTML = '';
                    if (newGrid) {
                        container.appendChild(newGrid);
                    } else if (emptyCatalog) {
                        container.innerHTML = '<p class="text-center text-muted py-5">Chưa có sản phẩm nào thuộc danh mục này.</p>';
                    } else {
                        container.innerHTML = '<p class="text-center text-muted py-5">Chưa có sản phẩm nào.</p>';
                    }
                    container.style.opacity = '1';
                }).fail(function () {
                    container.style.opacity = '1';
                });
            }

            pills.forEach(function (pill) {
                pill.addEventListener('click', function () {
                    pills.forEach(function (p) { p.classList.remove('is-active'); });
                    pill.classList.add('is-active');

                    var catId = pill.getAttribute('data-category-id');
                    var catName = pill.querySelector('span').textContent;
                    titleEl.textContent = catId ? 'Khám phá ' + catName : 'Sản phẩm mới';

                    var currentSort = sortSelect ? sortSelect.value : '';
                    if (currentSort.includes('sort=')) {
                        var urlParams = new URLSearchParams(currentSort.substring(currentSort.indexOf('?')));
                        currentSort = urlParams.get('sort');
                    }

                    loadCategoryProducts(catId, currentSort);
                });
            });

            if (sortSelect) {
                var oldOnChange = sortSelect.onchange;
                sortSelect.onchange = null;

                sortSelect.addEventListener('change', function () {
                    var activePill = document.querySelector('.cat-pill.is-active');
                    var catId = activePill ? activePill.getAttribute('data-category-id') : '';

                    var val = sortSelect.value;
                    var sortParam = val;
                    if (val.includes('sort=')) {
                        var urlParams = new URLSearchParams(val.substring(val.indexOf('?')));
                        sortParam = urlParams.get('sort');
                    }

                    loadCategoryProducts(catId, sortParam);
                });
            }
        })();
    </script>
}