@using ClothingShop.Services
@model IEnumerable<ClothingShop.Models.Coupon>

@{
    ViewBag.Title = "Quản lý Khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2"></i>Danh sách Khuyến mãi</h4>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="bi bi-plus-lg me-1"></i> Thêm mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Giảm (%)</th>
                <th>Từ ngày</th>
                <th>Đến ngày</th>
                <th>Đơn tối thiểu</th>
                <th>Lượt dùng</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge bg-dark">@item.Code</span></td>
                    <td class="text-danger fw-bold">-@item.DiscountPercent%</td>
                    <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@PriceFormatter.Vnd(item.MinOrder)</td>
                    <td>@item.UsedCount / @item.UsageLimit</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Hoạt động" : "Tạm khóa")</span>
                    </td>
                    <td class="text-end">
                        <a href="@Url.Action("Edit", new { id = item.CouponId })" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a href="@Url.Action("Delete", new { id = item.CouponId })" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
