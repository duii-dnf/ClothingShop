@model ClothingShop.Models.Coupon
@{
    ViewBag.Title = "Xóa mã khuyến mãi";
}

<h3 class="fw-bold text-danger mb-4">Xác nhận xóa mã khuyến mãi</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        <p>Bạn có chắc chắn muốn xóa mã khuyến mãi <strong>@Model.Code</strong> (giảm @Model.DiscountPercent%)?</p>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
            </div>
        }
    </div>
</div>
