@model ClothingShop.Models.Coupon
@{
    ViewBag.Title = "Chỉnh sửa mã khuyến mãi";
}

<h3 class="fw-bold mb-4">Chỉnh sửa mã khuyến mãi</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CouponId)
            @Html.HiddenFor(m => m.UsedCount)
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mã khuyến mãi <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control text-uppercase", required = "required" })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phần trăm giảm (%)</label>
                    @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control", type = "number", min = "1", max = "100", required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Đơn hàng tối thiểu (VNĐ)</label>
                    @Html.TextBoxFor(m => m.MinOrder, new { @class = "form-control", type = "number", min = "0", step = "10000" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Giới hạn lượt dùng</label>
                    @Html.TextBoxFor(m => m.UsageLimit, new { @class = "form-control", type = "number", min = "1" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày bắt đầu</label>
                    <input type="date" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày kết thúc</label>
                    <input type="date" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "chkActive" })
                        <label class="form-check-label" for="chkActive">Kích hoạt mã khuyến mãi</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-dark">Cập nhật</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>
