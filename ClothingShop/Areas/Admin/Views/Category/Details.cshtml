@model ClothingShop.Models.Category
@{
    ViewBag.Title = "Chi tiết loại sản phẩm";
}

<h3 class="fw-bold mb-4">Chi tiết loại sản phẩm</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã loại</dt>
            <dd class="col-sm-8">@Model.CategoryId</dd>

            <dt class="col-sm-4">Tên loại</dt>
            <dd class="col-sm-8 fw-bold">@Model.Name</dd>

            <dt class="col-sm-4">Danh mục cha</dt>
            <dd class="col-sm-8">@(Model.Category1 != null ? Model.Category1.Name : "Danh mục gốc")</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Đang hiển thị" : "Đang ẩn")</span>
            </dd>

            <dt class="col-sm-4">Danh mục con</dt>
            <dd class="col-sm-8">@(Model.Categories1 != null ? Model.Categories1.Count : 0)</dd>

            <dt class="col-sm-4">Số sản phẩm</dt>
            <dd class="col-sm-8">@(Model.Products != null ? Model.Products.Count : 0)</dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn btn-dark btn-sm">Chỉnh sửa</a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Quay lại</a>
    </div>
</div>
