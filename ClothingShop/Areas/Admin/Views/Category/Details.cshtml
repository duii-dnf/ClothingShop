@model ClothingShop.Models.Category

@{
    ViewBag.Title = "Chi tiết loại sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 fw-semibold">Chi tiết loại sản phẩm</h5>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Chỉnh sửa
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<dl class="row" style="max-width: 600px;">
    <dt class="col-sm-4 text-muted">Mã loại</dt>
    <dd class="col-sm-8">#@Model.CategoryId</dd>

    <dt class="col-sm-4 text-muted">Tên loại</dt>
    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

    <dt class="col-sm-4 text-muted">Danh mục cha</dt>
    <dd class="col-sm-8">@(Model.Parent != null ? Model.Parent.Name : "Danh mục gốc")</dd>

    <dt class="col-sm-4 text-muted">Trạng thái</dt>
    <dd class="col-sm-8">
        @(Model.IsActive ? "Hiển thị" : "Đang ẩn")
    </dd>

    <dt class="col-sm-4 text-muted">Số sản phẩm</dt>
    <dd class="col-sm-8">@(Model.Products != null ? Model.Products.Count : 0)</dd>
</dl>