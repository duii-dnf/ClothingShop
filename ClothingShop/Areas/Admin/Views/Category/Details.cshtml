@model ClothingShop.Models.Category
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Chi tiết loại sản phẩm";
    var children = Model.Categories1 != null
        ? Model.Categories1.OrderBy(c => c.CategoryId).ToList()
        : new List<Category>();

    var directProducts = Model.Products != null ? Model.Products.ToList() : new List<Product>();
    var childProducts = children
        .Where(c => c.Products != null)
        .SelectMany(c => c.Products)
        .ToList();

    var allProducts = directProducts
        .Concat(childProducts)
        .GroupBy(p => p.ProductId)
        .Select(g => g.First())
        .OrderBy(p => p.CategoryId)
        .ThenBy(p => p.ProductId)
        .ToList();

    int childCount = children.Count;
    int productCount = allProducts.Count;
    bool isRootWithChildren = !Model.ParentId.HasValue && childCount > 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Loại sản phẩm</a></li>
                @if (Model.Category1 != null)
                {
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Details", new { id = Model.Category1.CategoryId })" class="text-decoration-none text-muted">@Model.Category1.Name</a>
                    </li>
                }
                <li class="breadcrumb-item active text-dark fw-semibold">@Model.Name</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">Chi tiết loại sản phẩm</h3>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn btn-dark btn-sm rounded-pill px-4">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-light text-dark border rounded-pill px-3 mb-2">Mã loại: #@Model.CategoryId</span>
                        <h4 class="fw-bold mb-0">@Model.Name</h4>
                    </div>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2">
                        @(Model.IsActive ? "Đang hiển thị" : "Đang ẩn")
                    </span>
                </div>

                <div class="row g-2 my-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <small class="text-muted d-block">Phân cấp</small>
                            <strong class="small">@(Model.ParentId.HasValue ? "Cấp 2 (Danh mục con)" : "Cấp 1 (Danh mục gốc)")</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <small class="text-muted d-block">Danh mục cha</small>
                            <strong class="small">@(Model.Category1 != null ? Model.Category1.Name : "Không có")</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <small class="text-muted d-block">Danh mục con</small>
                            <strong class="fs-5 text-primary">@childCount</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <small class="text-muted d-block">@(isRootWithChildren ? "Tổng sản phẩm (gồm nhánh con)" : "Sản phẩm trực thuộc")</small>
                            <strong class="fs-5 text-dark">@productCount</strong>
                        </div>
                    </div>
                </div>

                <div class="pt-2 border-top">
                    <small class="text-muted fw-semibold d-block mb-2">Danh sách nhánh con trực thuộc:</small>
                    @if (childCount > 0)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sub in children)
                            {
                                <a href="@Url.Action("Details", new { id = sub.CategoryId })" class="badge bg-light text-dark border text-decoration-none rounded-pill px-3 py-2">
                                    @sub.Name (@(sub.Products != null ? sub.Products.Count : 0) SP) <i class="bi bi-arrow-up-right ms-1 text-muted"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="small text-muted">Không có danh mục con.</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden h-100">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-box-seam me-2"></i>@(isRootWithChildren ? "Tất cả sản phẩm thuộc nhóm này" : "Sản phẩm thuộc loại này")</span>
                <span class="badge bg-dark rounded-pill px-3">@productCount</span>
            </div>

            @if (isRootWithChildren)
            {
                <div class="bg-light border-bottom px-4 py-2">
                    <ul class="nav nav-pills gap-1 small" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill py-1 px-3 fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-all" type="button" role="tab">
                                Tất cả (@productCount)
                            </button>
                        </li>
                        @foreach (var sub in children)
                        {
                            int subCount = sub.Products != null ? sub.Products.Count : 0;
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-pill py-1 px-3 fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-sub-@sub.CategoryId" type="button" role="tab">
                                    @sub.Name (@subCount)
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-all" role="tabpanel">
                        @if (productCount > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase text-muted">
                                        <tr>
                                            <th class="ps-4" style="width: 75px;">Mã</th>
                                            <th>Tên sản phẩm</th>
                                            <th style="width: 130px;">Giá bán</th>
                                            <th class="text-center" style="width: 90px;">Kho</th>
                                            <th class="text-center" style="width: 110px;">Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in allProducts)
                                        {
                                            <tr>
                                                <td class="ps-4 text-muted">#@p.ProductId</td>
                                                <td>
                                                    <div class="fw-semibold">@p.Name</div>
                                                    @if (p.Category != null)
                                                    {
                                                        <span class="badge bg-light text-secondary border rounded-pill fw-normal mt-1">@p.Category.Name</span>
                                                    }
                                                </td>
                                                <td>@PriceFormatter.Vnd(p.DiscountPrice ?? p.Price)</td>
                                                <td class="text-center">@p.Stock</td>
                                                <td class="text-center">
                                                    <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2">@(p.IsActive ? "Hiển thị" : "Ẩn")</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="card-body text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 mb-2 d-block"></i>
                                <p class="small mb-0">Chưa có sản phẩm nào trong nhóm danh mục này.</p>
                            </div>
                        }
                    </div>

                    @foreach (var sub in children)
                    {
                        var subItems = sub.Products != null ? sub.Products.OrderBy(p => p.ProductId).ToList() : new List<Product>();
                        <div class="tab-pane fade" id="tab-sub-@sub.CategoryId" role="tabpanel">
                            @if (subItems.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small text-uppercase text-muted">
                                            <tr>
                                                <th class="ps-4" style="width: 75px;">Mã</th>
                                                <th>Tên sản phẩm</th>
                                                <th style="width: 130px;">Giá bán</th>
                                                <th class="text-center" style="width: 90px;">Kho</th>
                                                <th class="text-center" style="width: 110px;">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in subItems)
                                            {
                                                <tr>
                                                    <td class="ps-4 text-muted">#@p.ProductId</td>
                                                    <td class="fw-semibold">@p.Name</td>
                                                    <td>@PriceFormatter.Vnd(p.DiscountPrice ?? p.Price)</td>
                                                    <td class="text-center">@p.Stock</td>
                                                    <td class="text-center">
                                                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2">@(p.IsActive ? "Hiển thị" : "Ẩn")</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="card-body text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-4 mb-2 d-block"></i>
                                    <p class="small mb-0">Danh mục con "@sub.Name" chưa có sản phẩm nào.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (productCount > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4" style="width: 75px;">Mã</th>
                                <th>Tên sản phẩm</th>
                                <th style="width: 130px;">Giá bán</th>
                                <th class="text-center" style="width: 90px;">Kho</th>
                                <th class="text-center" style="width: 110px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in allProducts)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@p.ProductId</td>
                                    <td class="fw-semibold">@p.Name</td>
                                    <td>@PriceFormatter.Vnd(p.DiscountPrice ?? p.Price)</td>
                                    <td class="text-center">@p.Stock</td>
                                    <td class="text-center">
                                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2">@(p.IsActive ? "Hiển thị" : "Ẩn")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center py-5 text-muted">
                    <i class="bi bi-inbox display-4 mb-2"></i>
                    <p class="small mb-0">Chưa có sản phẩm nào thuộc loại này.</p>
                </div>
            }
        </div>
    </div>
</div>