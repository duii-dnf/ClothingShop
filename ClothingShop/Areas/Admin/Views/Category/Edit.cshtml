@model ClothingShop.Models.Category
@{
    ViewBag.Title = "Chỉnh sửa loại sản phẩm";
}

<h3 class="fw-bold mb-4">Chỉnh sửa loại sản phẩm</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CategoryId)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

            <div class="mb-3">
                <label class="form-label fw-semibold">Tên loại sản phẩm <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Danh mục cha</label>
                @Html.DropDownList("ParentId", null, "-- Danh mục gốc (Cấp 1) --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "text-danger small" })
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "chkActive" })
                <label class="form-check-label" for="chkActive">Hiển thị trên cửa hàng</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Cập nhật</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>
