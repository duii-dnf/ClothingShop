@model IEnumerable<ClothingShop.Models.Category>
@{
    ViewBag.Title = "Quản lý loại sản phẩm";
}

<div class="row g-3 mb-4 text-center">
    <div class="col-6 col-md-3"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Tổng danh mục</small><strong class="fs-4 font-display">@ViewBag.TotalCount</strong></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Danh mục cha</small><strong class="fs-4 font-display text-primary">@ViewBag.RootCount</strong></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Danh mục con</small><strong class="fs-4 font-display text-info">@ViewBag.ChildCount</strong></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Đang hiển thị</small><strong class="fs-4 font-display text-success">@ViewBag.ActiveCount</strong></div></div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm rounded-pill px-3" style="width:200px;" placeholder="Tìm tên loại..." />
        <select name="level" class="form-select form-select-sm rounded-pill" style="width:auto;">
            <option value="">Tất cả cấp</option>
            <option value="root" @(ViewBag.Level == "root" ? "selected" : "")>Cấp 1 (Cha)</option>
            <option value="child" @(ViewBag.Level == "child" ? "selected" : "")>Cấp 2 (Con)</option>
        </select>
        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Lọc</button>
    </form>
    <a href="@Url.Action("Create")" class="btn btn-dark rounded-pill px-4 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i>Thêm loại mới
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Tên loại</th>
                    <th>Danh mục cha</th>
                    <th class="text-center">Số SP</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 text-muted">@item.CategoryId</td>
                        <td>
                            @if (item.ParentId.HasValue)
                            {
                                <span class="text-muted ms-3">&mdash; @item.Name</span>
                            }
                            else
                            {
                                <strong class="text-dark">@item.Name</strong>
                            }
                        </td>
                        <td class="small">@(item.Category1 != null ? item.Category1.Name : "Danh mục gốc")</td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border rounded-pill px-3">@(item.Products != null ? item.Products.Count : 0)</span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-3">@(item.IsActive ? "Hiển thị" : "Đang ẩn")</span>
                        </td>
                        <td class="text-end pe-4 text-nowrap">
                            <a href="@Url.Action("Edit", new { id = item.CategoryId })" class="btn btn-outline-primary btn-sm rounded-pill">Sửa</a>
                            @using (Html.BeginForm("ToggleStatus", "Category", new { id = item.CategoryId }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill">@(item.IsActive ? "Ẩn" : "Hiện")</button>
                            }
                            <a href="@Url.Action("Delete", new { id = item.CategoryId })" class="btn btn-outline-danger btn-sm rounded-pill">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
