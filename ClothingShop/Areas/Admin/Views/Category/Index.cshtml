@model IEnumerable<ClothingShop.Models.Category>

@{
    ViewBag.Title = "Quản lý loại sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <form method="get" class="d-flex gap-2" style="max-width: 360px; width: 100%;">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tên loại sản phẩm..." />
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-search"></i>
        </button>
    </form>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Thêm loại mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 70px;">ID</th>
                <th>Tên loại sản phẩm</th>
                <th>Danh mục cha</th>
                <th class="text-center">Số SP</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-end" style="width: 180px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted">#@item.CategoryId</td>
                        <td>
                            @if (item.ParentId != null)
                            {
                                <span class="text-muted me-1">&mdash;</span>
                            }
                            <span class="fw-semibold">@item.Name</span>
                        </td>
                        <td>
                            @if (item.Parent != null)
                            {
                                <span class="badge bg-light text-dark border">@item.Parent.Name</span>
                            }
                            else
                            {
                                <span class="text-muted small">Danh mục gốc</span>
                            }
                        </td>
                        <td class="text-center">@(item.Products != null ? item.Products.Count : 0)</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đang ẩn</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = item.CategoryId })" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = item.CategoryId })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.CategoryId })" class="btn btn-sm btn-outline-danger" title="Xóa">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Chưa có loại sản phẩm nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>