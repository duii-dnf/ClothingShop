@model ClothingShop.Models.Category
@{
    ViewBag.Title = "Xóa loại sản phẩm";
}

<h3 class="fw-bold text-danger mb-4">Xác nhận xóa loại sản phẩm</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        <p>Bạn có chắc chắn muốn xóa loại sản phẩm <strong>@Model.Name</strong> không?</p>
        <ul class="small text-muted">
            <li>Danh mục cha: @(Model.Category1 != null ? Model.Category1.Name : "Danh mục gốc")</li>
            <li>Số danh mục con: @(Model.Categories1 != null ? Model.Categories1.Count : 0)</li>
            <li>Số sản phẩm thuộc loại này: @(Model.Products != null ? Model.Products.Count : 0)</li>
        </ul>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
            </div>
        }
    </div>
</div>
