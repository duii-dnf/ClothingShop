@model ClothingShop.Models.Category

@{
    ViewBag.Title = "Xóa loại sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int childCount = Model.Children != null ? Model.Children.Count : 0;
    int productCount = Model.Products != null ? Model.Products.Count : 0;
    bool canDelete = childCount == 0 && productCount == 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 fw-semibold text-danger">Xác nhận xóa loại sản phẩm</h5>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<dl class="row" style="max-width: 600px;">
    <dt class="col-sm-4 text-muted">Mã loại</dt>
    <dd class="col-sm-8">#@Model.CategoryId</dd>

    <dt class="col-sm-4 text-muted">Tên loại</dt>
    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

    <dt class="col-sm-4 text-muted">Danh mục cha</dt>
    <dd class="col-sm-8">@(Model.Parent != null ? Model.Parent.Name : "Danh mục gốc")</dd>

    <dt class="col-sm-4 text-muted">Số danh mục con</dt>
    <dd class="col-sm-8">@childCount</dd>

    <dt class="col-sm-4 text-muted">Số sản phẩm</dt>
    <dd class="col-sm-8">@productCount</dd>
</dl>

@if (!canDelete)
{
    <div class="alert alert-warning" style="max-width: 600px;">
        Loại này đang có danh mục con hoặc sản phẩm trực thuộc nên không thể xóa. Bạn có thể chuyển sang trạng thái Ẩn ở mục Chỉnh sửa hoặc bấm trực tiếp vào trạng thái ở bảng danh sách.
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2 mt-3">
        @if (canDelete)
        {
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
            </button>
        }
        else
        {
            <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i> Chuyển sang chỉnh sửa
            </a>
        }
        <a href="@Url.Action("Index")" class="btn btn-light border">Quay lại danh sách</a>
    </div>
}