@model ClothingShop.Models.Category
@{
    ViewBag.Title = "Thêm loại sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Loại sản phẩm</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold">Thêm mới</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">Thêm loại sản phẩm mới</h3>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 px-4 fw-bold">
                <i class="bi bi-plus-circle me-2"></i>Thông tin danh mục
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 py-2 small" })

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên loại sản phẩm <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control rounded-3", placeholder = "Ví dụ: Áo khoác bomber...", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phân cấp danh mục cha</label>
                            @Html.DropDownList("ParentId", null, "-- Danh mục gốc (Cấp 1) --", new { @class = "form-select rounded-3" })
                            @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="form-check form-switch mb-0">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "chkActive" })
                            <label class="form-check-label fw-semibold" for="chkActive">Kích hoạt hiển thị trên cửa hàng</label>
                            <div class="small text-muted">Khi bật, khách hàng có thể lọc và xem các sản phẩm thuộc loại này.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i>Lưu loại sản phẩm
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm bg-light h-100">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Quy tắc phân cấp</h6>
                <ul class="small text-muted ps-3 mb-0 lh-lg">
                    <li>Hệ thống hỗ trợ tối đa <strong>2 cấp danh mục</strong> (Danh mục gốc và Danh mục con).</li>
                    <li>Không được đặt trùng tên giữa hai danh mục nằm trong cùng một cấp cha.</li>
                    <li>Nên tạo đầy đủ danh mục con trước khi thêm mới sản phẩm để dễ phân loại.</li>
                </ul>
            </div>
        </div>
    </div>
</div>