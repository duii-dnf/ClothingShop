@using ClothingShop.Services
@{
    var currentUser = SessionHelper.CurrentUser;
    string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - AURELIA. Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&family=Urbanist:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100">
            <!-- Sidebar Obsidian hiện đại (Thuần Bootstrap 5) -->
            <aside class="col-md-3 col-lg-2 bg-obsidian text-white p-3 d-flex flex-column">
                <a href="@Url.Action("Index", currentUser != null && currentUser.IsAdmin ? "Dashboard" : "Order", new { area = "Admin" })"
                   class="text-white text-decoration-none pb-3 mb-3 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2">
                    <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="0.75" y="0.75" width="34.5" height="34.5" rx="7.25" fill="#111111" stroke="#F8F7F4" stroke-opacity="0.35" stroke-width="1.5" />
                        <path d="M18 10.5C18 9.12 19.12 8 20.5 8C21.88 8 23 9.12 23 10.5C23 11.74 22.05 12.76 20.82 12.95L18 13.8V15.4" stroke="#F8F7F4" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M18 15.4L8.5 21.8C7.85 22.24 8.16 23.25 8.95 23.25H27.05C27.84 23.25 28.15 22.24 27.5 21.8L18 15.4Z" stroke="#F8F7F4" stroke-width="1.65" stroke-linejoin="round" />
                        <path d="M14.5 26.75H21.5" stroke="#F8F7F4" stroke-width="1.35" stroke-linecap="round" opacity="0.7" />
                    </svg>
                    <span class="d-flex flex-column lh-1">
                        <span style="font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:1.1rem;letter-spacing:0.08em;color:#ffffff;">AURELIA<span style="color:#E11D48;">.</span></span>
                        <span style="font-family:'Urbanist',sans-serif;font-size:0.55rem;letter-spacing:0.2em;color:rgba(255,255,255,0.6);margin-top:3px;">STUDIO</span>
                    </span>
                </a>

                <div class="small text-uppercase text-white-50 fw-bold px-2 mb-2" style="font-size: 0.7rem;">Quản lý vận hành</div>
                <ul class="nav nav-pills flex-column gap-1 mb-auto">
                    @if (currentUser != null && currentUser.IsAdmin)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
                               class="nav-link admin-nav-link @(currentCtrl == "Dashboard" ? "badge-lime fw-bold" : "text-white-50")">
                                <i class="bi bi-bar-chart-line-fill me-2"></i>Thống kê doanh thu
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Category", new { area = "Admin" })"
                           class="nav-link admin-nav-link @(currentCtrl == "Category" ? "badge-lime fw-bold" : "text-white-50")">
                            <i class="bi bi-grid-fill me-2"></i>Loại sản phẩm
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Product", new { area = "Admin" })"
                           class="nav-link admin-nav-link @(currentCtrl == "Product" ? "badge-lime fw-bold" : "text-white-50")">
                            <i class="bi bi-box-seam-fill me-2"></i>Sản phẩm &amp; Kho
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Order", new { area = "Admin" })"
                           class="nav-link admin-nav-link @(currentCtrl == "Order" ? "badge-lime fw-bold" : "text-white-50")">
                            <i class="bi bi-receipt-cutoff me-2"></i>Đơn hàng
                        </a>
                    </li>
                    @if (currentUser != null && currentUser.IsAdmin)
                    {
                        <li class="nav-item mt-3">
                            <div class="small text-uppercase text-white-50 fw-bold px-2 mb-1" style="font-size: 0.7rem;">Hệ thống (Admin)</div>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Coupon", new { area = "Admin" })"
                               class="nav-link admin-nav-link @(currentCtrl == "Coupon" ? "badge-lime fw-bold" : "text-white-50")">
                                <i class="bi bi-ticket-perforated-fill me-2"></i>Khuyến mãi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "User", new { area = "Admin" })"
                               class="nav-link admin-nav-link @(currentCtrl == "User" ? "badge-lime fw-bold" : "text-white-50")">
                                <i class="bi bi-people-fill me-2"></i>Tài khoản &amp; Quyền
                            </a>
                        </li>
                    }
                </ul>

                <div class="pt-3 mt-4 border-top border-secondary border-opacity-25">
                    @if (currentUser != null)
                    {
                        <div class="bg-white bg-opacity-10 rounded-3 p-2 mb-3">
                            <div class="fw-bold small text-truncate">@currentUser.FullName</div>
                            <span class="badge @(currentUser.IsAdmin ? "bg-danger" : "bg-primary") rounded-pill" style="font-size:0.68rem;">
                                @currentUser.Role
                            </span>
                        </div>
                    }
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-light btn-sm rounded-pill">
                            <i class="bi bi-shop me-1"></i>Xem cửa hàng
                        </a>
                        <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-outline-danger btn-sm rounded-pill">
                            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Nội dung chính -->
            <div class="col-md-9 col-lg-10 p-0 d-flex flex-column">
                <!-- Top Studio Bar -->
                <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-muted text-uppercase fw-semibold">AURELIA. Admin</span>
                        <h5 class="font-display fw-bold mb-0">@ViewBag.Title</h5>
                    </div>
                    <div class="d-flex align-items-center gap-3 small">
                        <span class="text-muted d-none d-sm-inline">
                            <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")
                        </span>
                        @if (currentUser != null)
                        {
                            <span class="badge bg-obsidian rounded-pill px-3 py-2">
                                <i class="bi bi-person-badge me-1"></i>@currentUser.Role: @currentUser.FullName
                            </span>
                        }
                    </div>
                </header>

                <main class="p-4 flex-grow-1">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 rounded-4 shadow-sm alert-dismissible fade show">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 rounded-4 shadow-sm alert-dismissible fade show">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
