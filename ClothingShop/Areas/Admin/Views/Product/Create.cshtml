@model ClothingShop.Models.Product
@{
    ViewBag.Title = "Thêm sản phẩm";
}

<h3 class="fw-bold mb-4">Thêm sản phẩm mới</h3>

<div class="card border-0 shadow-sm col-lg-9">
    <div class="card-body">
        @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Loại sản phẩm <span class="text-danger">*</span></label>
                    @Html.DropDownList("CategoryId", null, "-- Chọn loại --", new { @class = "form-select", required = "required" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá gốc (VNĐ) <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", min = "1000", step = "1000", required = "required" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá khuyến mãi (VNĐ)</label>
                    @Html.TextBoxFor(m => m.DiscountPrice, new { @class = "form-control", type = "number", min = "0", step = "1000" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Số lượng tồn kho</label>
                    @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", min = "0" })
                </div>

                <!-- Radio: Giới tính -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold d-block">Giới tính (Radio)</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="Gender" id="gNam" value="Nam" @(Model.Gender == "Nam" ? "checked" : "") />
                        <label class="form-check-label" for="gNam">Nam</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="Gender" id="gNu" value="Nữ" @(Model.Gender == "Nữ" ? "checked" : "") />
                        <label class="form-check-label" for="gNu">Nữ</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="Gender" id="gUnisex" value="Unisex" @(string.IsNullOrEmpty(Model.Gender) || Model.Gender == "Unisex" ? "checked" : "") />
                        <label class="form-check-label" for="gUnisex">Unisex</label>
                    </div>
                </div>

                <!-- Checkbox: Thuộc tính sản phẩm -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold d-block">Tùy chọn hiển thị (Checkbox)</label>
                    <div class="form-check form-check-inline">
                        @Html.CheckBoxFor(m => m.IsNew, new { @class = "form-check-input", id = "chkIsNew" })
                        <label class="form-check-label" for="chkIsNew">Hàng mới</label>
                    </div>
                    <div class="form-check form-check-inline">
                        @Html.CheckBoxFor(m => m.IsFeatured, new { @class = "form-check-input", id = "chkFeatured" })
                        <label class="form-check-label" for="chkFeatured">Nổi bật</label>
                    </div>
                    <div class="form-check form-check-inline">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "chkActive" })
                        <label class="form-check-label" for="chkActive">Đang bán</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Hình ảnh sản phẩm</label>
                    <div class="row g-3 align-items-start">
                        <div class="col-md-7">
                            <label class="form-label small text-muted mb-1">Nhập link ảnh online (URL) hoặc tên file ảnh</label>
                            @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control rounded-3", id = "imgUrlInput", placeholder = "https://example.com/image.jpg hoặc sp-01.jpg" })
                            <div class="form-text">Nếu tải file lên, file sẽ được ưu tiên dùng thay link URL.</div>
                            <label class="form-label small text-muted mb-1 mt-2">Hoặc tải ảnh sản phẩm từ máy tính</label>
                            <input type="file" name="fileUpload" class="form-control rounded-3" accept="image/*" id="fileUploadInput" />
                        </div>
                        <div class="col-md-5 text-center">
                            <label class="form-label small text-muted d-block mb-1">Xem trước ảnh</label>
                            <img id="imgPreview" src="@Url.Content("~/Content/images/products/default.jpg")" alt="Preview"
                                 class="rounded border shadow-sm"
                                 style="height:120px;max-width:100%;object-fit:cover;"
                                 onerror="this.src='@Url.Content("~/Content/images/products/default.jpg")'" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Kích cỡ (Sizes)</label>
                    @Html.TextBoxFor(m => m.Sizes, new { @class = "form-control", placeholder = "VD: S,M,L,XL" })
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Màu sắc (Colors)</label>
                    @Html.TextBoxFor(m => m.Colors, new { @class = "form-control", placeholder = "VD: Đen,Trắng" })
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả chi tiết</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-dark">Lưu sản phẩm</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
    document.getElementById('imgUrlInput').addEventListener('input', function () {
        var url = this.value.trim();
        if (url) {
            document.getElementById('imgPreview').src = (url.indexOf('http') === 0 || url.indexOf('/') === 0) ? url : '/Content/images/products/' + url;
        }
    });
    document.getElementById('fileUploadInput').addEventListener('change', function () {
        if (this.files && this.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgPreview').src = e.target.result;
            };
            reader.readAsDataURL(this.files[0]);
        }
    });
</script>
}
