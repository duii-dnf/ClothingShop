@model ClothingShop.Models.Product
@using ClothingShop.Services
@{
    ViewBag.Title = "Xóa sản phẩm";
}

<h3 class="fw-bold text-danger mb-4">Xác nhận xóa sản phẩm</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        <p>Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong>?</p>
        <ul class="small text-muted">
            <li>Loại: @(Model.Category != null ? Model.Category.Name : "-")</li>
            <li>Giá bán: @PriceFormatter.Vnd(Model.Price)</li>
            <li>Tồn kho: @Model.Stock</li>
        </ul>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
            </div>
        }
    </div>
</div>
