@model ClothingShop.Models.Product

@{
    ViewBag.Title = "Sửa sản phẩm";
    var imgSrc = string.IsNullOrEmpty(Model.ImageUrl) ? "/Content/images/products/default.jpg"
        : (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : (Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "/Content/images/products/" + Model.ImageUrl));
}

<h4 class="fw-bold mb-3">Sửa sản phẩm #@Model.ProductId</h4>

@using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.Name, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.CategoryId, new { @class = "form-label fw-semibold" })
            @Html.DropDownList("CategoryId", null, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.Price, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", min = "0" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.DiscountPrice, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.DiscountPrice, new { @class = "form-control", type = "number", min = "0" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.Stock, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", min = "0" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Sizes, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Sizes, new { @class = "form-control" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Colors, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Colors, new { @class = "form-control" })
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold d-block">Giới tính</label>
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(m => m.Gender, "Nam", new { @class = "form-check-input", id = "gNam" })
                <label class="form-check-label" for="gNam">Nam</label>
            </div>
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(m => m.Gender, "Nữ", new { @class = "form-check-input", id = "gNu" })
                <label class="form-check-label" for="gNu">Nữ</label>
            </div>
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(m => m.Gender, "Unisex", new { @class = "form-check-input", id = "gUnisex" })
                <label class="form-check-label" for="gUnisex">Unisex</label>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold d-block">Tùy chọn</label>
            <div class="form-check form-check-inline">
                @Html.CheckBoxFor(m => m.IsNew, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsNew, new { @class = "form-check-label" })
            </div>
            <div class="form-check form-check-inline">
                @Html.CheckBoxFor(m => m.IsFeatured, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsFeatured, new { @class = "form-check-label" })
            </div>
            <div class="form-check form-check-inline">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Hình ảnh sản phẩm</label>
            <div class="mb-2">
                @Html.LabelFor(m => m.ImageUrl, "Link ảnh Online (URL)", new { @class = "form-label small text-muted" })
                @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control form-control-sm", placeholder = "https://images.unsplash.com/... hoặc để trống nếu tải file", id = "imageUrlInput" })
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Hoặc tải file ảnh mới từ máy</label>
                <input type="file" name="fileUpload" id="fileUploadInput" class="form-control form-control-sm" accept="image/*" />
            </div>
            <div class="d-flex align-items-center gap-3 mt-2">
                <img id="imgPreview" src="@imgSrc" alt="@Model.Name" class="rounded border" style="height: 90px; width: 90px; object-fit: cover;" onerror="this.onerror=null;this.src='/Content/images/products/default.jpg';" />
                <span class="small text-muted">Ảnh hiện tại / Xem trước</span>
            </div>
        </div>

        <div class="col-12">
            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
            @Html.TextAreaFor(m => m.Description, 4, 40, new { @class = "form-control" })
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-warning">Cập nhật</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
    </div>
}

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var urlInput = document.getElementById('imageUrlInput');
            var fileInput = document.getElementById('fileUploadInput');
            var preview = document.getElementById('imgPreview');
            if (urlInput && preview) {
                urlInput.addEventListener('input', function () {
                    var val = this.value.trim();
                    if (val) preview.src = val;
                });
            }
            if (fileInput && preview) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            preview.src = e.target.result;
                        };
                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }
        });
    </script>
}
