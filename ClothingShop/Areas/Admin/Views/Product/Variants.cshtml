@model ClothingShop.Models.Product
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Biến thể & Tồn kho";
    var sizes = ViewBag.Sizes as List<ProductSize> ?? new List<ProductSize>();
    var colors = ViewBag.Colors as List<ProductColor> ?? new List<ProductColor>();
    var logs = ViewBag.Logs as List<InventoryLog> ?? new List<InventoryLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Biến thể &amp; Tồn kho: @Model.Name</h3>
        <small class="text-muted">Tổng tồn kho hiện tại: <strong>@Model.Stock</strong></small>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>

<!-- Danh sách biến thể hiện có -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-dark text-white fw-semibold">Danh sách biến thể (Size / Màu)</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Size</th>
                    <th>Màu sắc</th>
                    <th>Cập nhật tồn kho / giá riêng / trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.ProductVariants)
                {
                    <tr>
                        <td class="fw-semibold">@v.SKU</td>
                        <td>@(v.ProductSize != null ? v.ProductSize.Name : "Freesize")</td>
                        <td>@(v.ProductColor != null ? v.ProductColor.Name : "Mặc định")</td>
                        <td>
                            @using (Html.BeginForm("UpdateVariantStock", "Product", FormMethod.Post, new { @class = "row g-2 align-items-center" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="variantId" value="@v.VariantId" />
                                <div class="col-auto">
                                    <input type="number" name="stock" value="@v.Stock" min="0" class="form-control form-control-sm" style="width:90px;" title="Tồn kho" />
                                </div>
                                <div class="col-auto">
                                    <input type="number" name="price" value="@v.Price" min="0" step="1000" class="form-control form-control-sm" style="width:130px;" placeholder="Giá riêng (tùy chọn)" />
                                </div>
                                <div class="col-auto">
                                    <select name="isActive" class="form-select form-select-sm">
                                        <option value="true" @(v.IsActive ? "selected" : "")>Đang bán</option>
                                        <option value="false" @(!v.IsActive ? "selected" : "")>Ẩn</option>
                                    </select>
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-dark btn-sm">Lưu</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Thêm biến thể mới -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Thêm biến thể mới</div>
    <div class="card-body">
        @using (Html.BeginForm("CreateVariant", "Product", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Size</label>
                    <select name="sizeId" class="form-select form-select-sm">
                        @foreach (var s in sizes)
                        {
                            <option value="@s.SizeId">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Màu sắc</label>
                    <select name="colorId" class="form-select form-select-sm">
                        @foreach (var c in colors)
                        {
                            <option value="@c.ColorId">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">SKU (để trống tự tạo)</label>
                    <input type="text" name="sku" class="form-control form-control-sm" placeholder="VD: SP001-L-RED" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Tồn kho</label>
                    <input type="number" name="stock" value="10" min="0" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Giá riêng</label>
                    <input type="number" name="price" min="0" step="1000" class="form-control form-control-sm" placeholder="Mặc định" />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-dark btn-sm">Thêm</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Lịch sử kho -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Lịch sử nhập / xuất kho (25 gần nhất)</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Thời gian</th>
                    <th>Loại thao tác</th>
                    <th class="text-center">Thay đổi</th>
                    <th class="text-center">Tồn sau</th>
                    <th>Ghi chú</th>
                    <th>Người thực hiện</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td class="small">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small"><span class="badge bg-light text-dark border">@log.ChangeType</span></td>
                        <td class="text-center fw-bold @(log.QuantityChange >= 0 ? "text-success" : "text-danger")">
                            @(log.QuantityChange > 0 ? "+" + log.QuantityChange : log.QuantityChange.ToString())
                        </td>
                        <td class="text-center">@log.StockAfter</td>
                        <td class="small">@log.Note</td>
                        <td class="small text-muted">@log.CreatedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
