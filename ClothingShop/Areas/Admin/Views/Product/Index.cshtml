@model IEnumerable<ClothingShop.Models.Product>
@using ClothingShop.Services
@{
    ViewBag.Title = "Quản lý sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div class="text-muted small">Tổng cộng <strong>@Model.Count()</strong> sản phẩm trong danh sách</div>
    <a href="@Url.Action("Create")" class="btn btn-dark rounded-pill px-4 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm mới
    </a>
</div>

<form method="get" class="card border-0 rounded-4 shadow-sm p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm rounded-pill px-3" placeholder="Tìm theo tên sản phẩm..." />
        </div>
        <div class="col-md-4">
            @Html.DropDownList("categoryId", null, "-- Tất cả loại sản phẩm --", new { @class = "form-select form-select-sm rounded-pill" })
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm rounded-pill flex-grow-1 fw-semibold">Lọc</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill">Đặt lại</a>
        </div>
    </div>
</form>

<div class="card border-0 rounded-4 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-4">Sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string img = string.IsNullOrEmpty(item.ImageUrl)
                        ? Url.Content("~/Content/images/products/default.jpg")
                        : (item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/")
                            ? item.ImageUrl
                            : Url.Content("~/Content/images/products/" + item.ImageUrl));
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@img" alt="@item.Name" class="rounded-3 border" style="width:52px;height:68px;object-fit:cover;" />
                                <div>
                                    <div class="fw-bold">@item.Name</div>
                                    <div class="small text-muted mt-1">
                                        <span class="badge bg-light text-dark border rounded-pill">@item.Gender</span>
                                        @if (item.IsNew) { <span class="badge bg-obsidian rounded-pill">NEW</span> }
                                        @if (item.IsFeatured) { <span class="badge badge-lime rounded-pill">HOT</span> }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="small">@(item.Category != null ? item.Category.Name : "-")</td>
                        <td class="text-end">
                            @if (item.DiscountPrice.HasValue && item.DiscountPrice.Value < item.Price)
                            {
                                <div class="fw-bold text-danger">@PriceFormatter.Vnd(item.DiscountPrice)</div>
                                <small class="text-muted text-decoration-line-through">@PriceFormatter.Vnd(item.Price)</small>
                            }
                            else
                            {
                                <div class="fw-bold">@PriceFormatter.Vnd(item.Price)</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(item.Stock > 5 ? "bg-light text-dark border" : "bg-danger") rounded-pill px-3">@item.Stock</span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-3">@(item.IsActive ? "Đang bán" : "Đã ẩn")</span>
                        </td>
                        <td class="text-end pe-4 text-nowrap">
                            <a href="@Url.Action("Variants", new { id = item.ProductId })" class="btn btn-outline-dark btn-sm rounded-pill">Kho / Size</a>
                            <a href="@Url.Action("Edit", new { id = item.ProductId })" class="btn btn-outline-primary btn-sm rounded-pill">Sửa</a>
                            <a href="@Url.Action("Delete", new { id = item.ProductId })" class="btn btn-outline-danger btn-sm rounded-pill">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
