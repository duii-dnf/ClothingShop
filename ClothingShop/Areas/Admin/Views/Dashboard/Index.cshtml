@model IEnumerable<ClothingShop.Models.Order>
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Thống kê doanh thu";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    decimal revenue = ViewBag.TongDoanhThu != null ? (decimal)ViewBag.TongDoanhThu : 0m;
}

<!-- Bộ lọc ngày -->
<div class="card border-0 rounded-4 shadow-sm p-3 mb-4">
    <form method="get" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="fw-bold small text-uppercase text-muted">
            <i class="bi bi-funnel-fill me-1"></i>Lọc doanh thu theo thời gian
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <input type="date" name="fromDate" value="@(fromDate.HasValue ? fromDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm rounded-pill w-auto" />
            <span class="text-muted small">&rarr;</span>
            <input type="date" name="toDate" value="@(toDate.HasValue ? toDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm rounded-pill w-auto" />
            <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3 fw-semibold">Lọc</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Tất cả</a>
        </div>
    </form>
</div>

<!-- 4 KPI Cards hiện đại (100% Bootstrap 5) -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 shadow-sm bg-dark text-white h-100">
            <div class="card-body p-4 d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-white-50">Tổng doanh thu (Hoàn thành)</div>
                    <div class="fs-4 fw-bold text-warning mt-2">@PriceFormatter.Vnd(revenue)</div>
                </div>
                <span class="badge bg-warning text-dark rounded-3 p-2 fs-5"><i class="bi bi-cash-stack"></i></span>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 shadow-sm bg-white h-100">
            <div class="card-body p-4 d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted">Tổng đơn hàng</div>
                    <div class="fs-3 fw-bold mt-1">@ViewBag.TongDonHang</div>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-3 p-2 fs-5"><i class="bi bi-bag-check-fill"></i></span>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 shadow-sm bg-white h-100">
            <div class="card-body p-4 d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted">Sản phẩm đang bán</div>
                    <div class="fs-3 fw-bold mt-1">@ViewBag.TongSanPham</div>
                </div>
                <span class="badge bg-warning bg-opacity-10 text-dark rounded-3 p-2 fs-5"><i class="bi bi-box-seam-fill"></i></span>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 rounded-4 shadow-sm bg-white h-100">
            <div class="card-body p-4 d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted">Khách hàng thành viên</div>
                    <div class="fs-3 fw-bold mt-1">@ViewBag.TongKhachHang</div>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-3 p-2 fs-5"><i class="bi bi-people-fill"></i></span>
            </div>
        </div>
    </div>
</div>

<!-- Trạng thái đơn hàng -->
<div class="row g-2 mb-4 text-center">
    <div class="col"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Chờ xác nhận</small><strong class="fs-4 text-warning">@ViewBag.DonChoXacNhan</strong></div></div>
    <div class="col">
        <a href="@Url.Action("Index", "Order", new { status = "CancelRequested" })" class="text-decoration-none">
            <div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Yêu cầu hủy</small><strong class="fs-4 text-danger">@(ViewBag.DonYeuCauHuy ?? 0)</strong></div>
        </a>
    </div>
    <div class="col"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Đã xác nhận</small><strong class="fs-4 text-primary">@ViewBag.DonDaXacNhan</strong></div></div>
    <div class="col"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Đang giao</small><strong class="fs-4 text-info">@ViewBag.DonDangGiao</strong></div></div>
    <div class="col"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Hoàn thành</small><strong class="fs-4 text-success">@ViewBag.DonHoanThanh</strong></div></div>
    <div class="col"><div class="card border-0 rounded-4 shadow-sm p-3"><small class="text-muted">Đã hủy</small><strong class="fs-4 text-danger">@ViewBag.DonDaHuy</strong></div></div>
</div>

<!-- Đơn hàng gần đây -->
<div class="card border-0 rounded-4 shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
        <span class="fw-bold">10 đơn hàng mới nhất</span>
        <a href="@Url.Action("Index", "Order")" class="btn btn-dark btn-sm rounded-pill px-3">Quản lý tất cả đơn</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string badge = item.Status == OrderStatus.Completed ? "bg-success"
                        : item.Status == OrderStatus.Cancelled ? "bg-danger"
                        : item.Status == OrderStatus.Shipping ? "bg-info text-dark"
                        : item.Status == OrderStatus.Confirmed ? "bg-primary"
                        : "bg-warning text-dark";
                    <tr>
                        <td class="ps-4 fw-bold">#@item.OrderId</td>
                        <td>
                            <div class="fw-semibold">@item.ReceiverName</div>
                            <small class="text-muted">@item.Phone</small>
                        </td>
                        <td class="small text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@item.PaymentMethod</td>
                        <td><span class="badge @badge rounded-pill px-3">@item.Status</span></td>
                        <td class="text-end fw-bold text-danger">@PriceFormatter.Vnd(item.TotalAmount)</td>
                        <td class="text-center pe-4">
                            <a href="@Url.Action("Details", "Order", new { id = item.OrderId })" class="btn btn-outline-dark btn-sm rounded-pill px-3">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
