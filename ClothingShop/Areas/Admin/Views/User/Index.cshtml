@model IEnumerable<ClothingShop.Models.User>
@using ClothingShop.Models
@{
    ViewBag.Title = "Quản lý tài khoản & Phân quyền";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="text-muted small">Phân quyền truy cập cho Admin, Nhân viên (Staff) và Khách hàng</div>
    <a href="@Url.Action("Create")" class="btn btn-dark rounded-pill px-4 fw-semibold">
        <i class="bi bi-person-plus-fill me-1"></i>Tạo nhân viên / Admin
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Vai trò</th>
                    <th class="pe-4">Cập nhật vai trò</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    string badge = u.Role == AppRoles.Admin ? "bg-danger"
                        : u.Role == AppRoles.Staff ? "bg-primary"
                        : "bg-secondary";
                    <tr>
                        <td class="ps-4 text-muted">@u.UserId</td>
                        <td class="fw-bold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td class="small text-muted">@u.Phone</td>
                        <td><span class="badge @badge rounded-pill px-3">@u.Role</span></td>
                        <td class="pe-4">
                            @using (Html.BeginForm("ChangeRole", "User", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.UserId" />
                                <select name="role" class="form-select form-select-sm rounded-pill" style="width:140px;">
                                    <option value="@AppRoles.Admin" @(u.Role == AppRoles.Admin ? "selected" : "")>Admin</option>
                                    <option value="@AppRoles.Staff" @(u.Role == AppRoles.Staff ? "selected" : "")>Staff</option>
                                    <option value="@AppRoles.Customer" @(u.Role == AppRoles.Customer ? "selected" : "")>Customer</option>
                                </select>
                                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Lưu</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
