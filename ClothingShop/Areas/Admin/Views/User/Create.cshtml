@model ClothingShop.Models.User
@using ClothingShop.Models
@{
    ViewBag.Title = "Tạo tài khoản mới";
}

<h3 class="fw-bold mb-4">Tạo tài khoản nhân viên / quản trị</h3>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })

            <div class="mb-3">
                <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                <input type="password" name="password" class="form-control" minlength="6" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Vai trò</label>
                <select name="Role" class="form-select">
                    <option value="@AppRoles.Staff" @(Model.Role == AppRoles.Staff ? "selected" : "")>Staff (Nhân viên)</option>
                    <option value="@AppRoles.Admin" @(Model.Role == AppRoles.Admin ? "selected" : "")>Admin (Quản trị viên)</option>
                    <option value="@AppRoles.Customer" @(Model.Role == AppRoles.Customer ? "selected" : "")>Customer (Khách hàng)</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Tạo tài khoản</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>
