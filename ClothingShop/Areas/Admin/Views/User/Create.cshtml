@using ClothingShop.Models
@model ClothingShop.Models.AppUser

@{
    ViewBag.Title = "Thêm tài khoản Nhân viên / Admin";
}

<h4 class="fw-bold mb-3">Thêm tài khoản mới</h4>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Mật khẩu</label>
            <input type="password" name="password" class="form-control" minlength="6" required />
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Phone, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Vai trò</label>
            <select name="Role" class="form-select">
                <option value="@AppRoles.Staff" selected>Staff (Nhân viên)</option>
                <option value="@AppRoles.Admin">Admin (Quản trị viên)</option>
                <option value="@AppRoles.Customer">Customer (Khách hàng)</option>
            </select>
        </div>
        <div class="col-12">
            @Html.LabelFor(m => m.Address, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
    </div>
}
