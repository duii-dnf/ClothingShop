@model IEnumerable<ClothingShop.Models.Order>
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Quản lý đơn hàng";
    int cancelReqCount = ViewBag.CancelRequestCount != null ? (int)ViewBag.CancelRequestCount : 0;
}

@if (cancelReqCount > 0)
{
    <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Hiện có <strong>@cancelReqCount đơn hàng</strong> khách gửi yêu cầu hủy (hoặc yêu cầu hoàn tiền) đang chờ xác nhận.
        </div>
        <a href="@Url.Action("Index", new { status = "CancelRequested" })" class="btn btn-dark btn-sm rounded-pill px-3 fw-semibold">
            Xem ngay
        </a>
    </div>
}

<form method="get" class="card border-0 rounded-4 shadow-sm p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm rounded-pill px-3" placeholder="Tìm tên người nhận hoặc SĐT..." />
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm rounded-pill">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="CancelRequested" @(ViewBag.Status == "CancelRequested" ? "selected" : "")>Yêu cầu hủy đơn (@cancelReqCount)</option>
                @foreach (var st in OrderStatus.All)
                {
                    <option value="@st" @(ViewBag.Status == st ? "selected" : "")>@st</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm rounded-pill flex-grow-1 fw-semibold">Lọc đơn hàng</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill">Đặt lại</a>
        </div>
    </div>
</form>

<div class="card border-0 rounded-4 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Người nhận</th>
                    <th>Ngày đặt</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool isCancelRequested = item.Status == OrderStatus.Pending
                        && !string.IsNullOrEmpty(item.Note)
                        && item.Note.Contains("[YÊU CẦU HỦY");
                    bool isPaid = string.Equals(item.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
                    bool isRefunded = string.Equals(item.PaymentStatus, "Refunded", StringComparison.OrdinalIgnoreCase);

                    string badge = item.Status == OrderStatus.Completed ? "bg-success"
                        : item.Status == OrderStatus.Cancelled ? "bg-danger"
                        : item.Status == OrderStatus.Shipping ? "bg-info text-dark"
                        : item.Status == OrderStatus.Confirmed ? "bg-primary"
                        : "bg-warning text-dark";

                    string payBadgeClass = isPaid ? "bg-success-subtle text-success border border-success-subtle"
                        : isRefunded ? "bg-info-subtle text-info border border-info-subtle"
                        : "bg-light text-muted border";

                    string payBadgeText = isPaid ? "Đã TT"
                        : isRefunded ? "Đã hoàn tiền"
                        : "Chưa TT";

                    <tr class="@(isCancelRequested ? "table-warning" : "")">
                        <td class="ps-4 fw-bold">#@item.OrderId</td>
                        <td>
                            <div class="fw-semibold">@item.ReceiverName</div>
                            <small class="text-muted">@item.Phone</small>
                        </td>
                        <td class="small text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">
                            <div>@item.PaymentMethod</div>
                            <span class="badge @payBadgeClass rounded-pill mt-1">@payBadgeText</span>
                        </td>
                        <td>
                            <span class="badge @badge rounded-pill px-3">@item.Status</span>
                            @if (isCancelRequested)
                            {
                                <div class="mt-1">
                                    <span class="badge bg-danger rounded-pill">
                                        <i class="bi bi-exclamation-circle me-1"></i>@(isPaid ? "Yêu cầu hủy & hoàn tiền" : "Yêu cầu hủy")
                                    </span>
                                </div>
                            }
                        </td>
                        <td class="text-end fw-bold text-danger">@PriceFormatter.Vnd(item.TotalAmount)</td>
                        <td class="text-center pe-4">
                            <a href="@Url.Action("Details", new { id = item.OrderId })" class="btn btn-dark btn-sm rounded-pill px-3">Xử lý đơn</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>