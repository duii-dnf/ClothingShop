@model ClothingShop.Models.Order
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderId;
    bool isPending = Model.Status == OrderStatus.Pending;
    bool isPaid = string.Equals(Model.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
    bool isRefunded = string.Equals(Model.PaymentStatus, "Refunded", StringComparison.OrdinalIgnoreCase);
    bool isCancelRequested = isPending && !string.IsNullOrEmpty(Model.Note) && Model.Note.Contains("[YÊU CẦU HỦY");
    bool isFinalized = Model.Status == OrderStatus.Cancelled || Model.Status == OrderStatus.Completed;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Chi tiết đơn hàng #@Model.OrderId</h3>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Quay lại danh sách</a>
</div>

@if (isCancelRequested)
{
    <div class="alert alert-danger border-0 rounded-4 shadow-sm p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h5 class="fw-bold mb-2">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @(isPaid ? "Khách hàng yêu cầu HỦY ĐƠN & HOÀN TIỀN" : "Khách hàng yêu cầu HỦY ĐƠN HÀNG")
                </h5>
                <p class="mb-2 small text-dark">
                    <strong>Nội dung ghi chú / Lý do &amp; Tài khoản hoàn tiền:</strong><br />
                    <span class="d-inline-block bg-white border rounded-3 px-3 py-2 mt-1">@Model.Note</span>
                </p>
                @if (isPaid)
                {
                    <div class="small fw-semibold text-danger">
                        <i class="bi bi-cash-coin me-1"></i>Đơn đã thanh toán chuyển khoản <strong>@PriceFormatter.Vnd(Model.TotalAmount)</strong>. Hãy kiểm tra hoàn tiền cho khách trước khi bấm duyệt hủy.
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap gap-2">
                @using (Html.BeginForm("UpdateStatus", "Order", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <input type="hidden" name="status" value="@OrderStatus.Cancelled" />
                    <input type="hidden" name="paymentStatus" value="@(isPaid ? "Refunded" : "Unpaid")" />
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold"
                            onclick="return confirm('@(isPaid ? "Xác nhận đã hoàn tiền, hủy đơn và hoàn tồn kho?" : "Xác nhận duyệt hủy đơn và hoàn tồn kho?")');">
                        <i class="bi bi-check2-circle me-1"></i>@(isPaid ? "Duyệt hủy & Đã hoàn tiền" : "Duyệt hủy đơn")
                    </button>
                }

                @using (Html.BeginForm("UpdateStatus", "Order", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <input type="hidden" name="status" value="@OrderStatus.Confirmed" />
                    <input type="hidden" name="paymentStatus" value="@Model.PaymentStatus" />
                    <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold"
                            onclick="return confirm('Từ chối yêu cầu hủy và chuyển đơn sang Đã xác nhận?');">
                        Từ chối hủy &amp; Xác nhận đơn
                    </button>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
            <div class="card-header bg-white fw-semibold py-3">Sản phẩm trong đơn</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Phân loại</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td class="fw-semibold">@(d.Product != null ? d.Product.Name : "SP #" + d.ProductId)</td>
                                <td class="small text-muted">@d.Size / @d.Color</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">@PriceFormatter.Vnd(d.UnitPrice)</td>
                                <td class="text-end fw-semibold">@PriceFormatter.Vnd(d.UnitPrice * d.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end">Tạm tính:</td>
                            <td class="text-end">@PriceFormatter.Vnd(Model.Subtotal)</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end">Phí vận chuyển:</td>
                            <td class="text-end">@PriceFormatter.Vnd(Model.ShippingFee)</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="4" class="text-end text-success">
                                    Giảm giá @(Model.Coupon != null ? "(" + Model.Coupon.Code + ")" : ""):
                                </td>
                                <td class="text-end text-success">-@PriceFormatter.Vnd(Model.DiscountAmount)</td>
                            </tr>
                        }
                        <tr class="fw-bold fs-5">
                            <td colspan="4" class="text-end">Tổng cộng:</td>
                            <td class="text-end text-danger">@PriceFormatter.Vnd(Model.TotalAmount)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
            <div class="card-header bg-dark text-white fw-semibold py-3">Cập nhật trạng thái đơn</div>
            <div class="card-body">
                @if (isFinalized)
                {
                    <div class="alert @(Model.Status == OrderStatus.Completed ? "alert-success" : "alert-secondary") border-0 rounded-3 small mb-0">
                        <i class="bi @(Model.Status == OrderStatus.Completed ? "bi-check-circle-fill" : "bi-lock-fill") me-1"></i>
                        Đơn hàng đã ở trạng thái kết thúc (<strong>@Model.Status</strong> - <strong>@Model.PaymentStatus</strong>), không thể chỉnh sửa thêm.
                    </div>
                }
                else
                {
                    using (Html.BeginForm("UpdateStatus", "Order", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Trạng thái đơn hàng</label>
                            <select name="status" class="form-select">
                                @foreach (var st in OrderStatus.All)
                                {
                                    <option value="@st" @(Model.Status == st ? "selected" : "")>@st</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Trạng thái thanh toán</label>
                            <select name="paymentStatus" class="form-select">
                                <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Chưa thanh toán (Unpaid)</option>
                                <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Đã thanh toán (Paid)</option>
                                @if (isPaid || isRefunded)
                                {
                                    <option value="Refunded" @(Model.PaymentStatus == "Refunded" ? "selected" : "")>Đã hoàn tiền (Refunded)</option>
                                }
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark rounded-pill fw-semibold">Cập nhật đơn hàng</button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
            <div class="card-header bg-white fw-semibold py-3">Thông tin giao hàng &amp; Thanh toán</div>
            <div class="card-body small">
                <p class="mb-1"><strong>Người nhận:</strong> @Model.ReceiverName</p>
                <p class="mb-1"><strong>Điện thoại:</strong> @Model.Phone</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> @Model.Address</p>
                <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                <p class="mb-1">
                    <strong>Thanh toán:</strong>
                    @if (isPaid)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Đã thanh toán</span>
                    }
                    else if (isRefunded)
                    {
                        <span class="badge bg-info bg-opacity-10 text-dark border border-info">Đã hoàn tiền</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border">Chưa thanh toán</span>
                    }
                </p>
                @if (Model.PaymentDate.HasValue)
                {
                    <p class="mb-1"><strong>Ngày thanh toán:</strong> @Model.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
                <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-2 p-2 bg-light rounded-3 border">
                        <strong>Ghi chú:</strong> @Model.Note
                    </div>
                }
            </div>
        </div>
    </div>
</div>