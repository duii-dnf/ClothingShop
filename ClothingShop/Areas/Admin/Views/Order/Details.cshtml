@model ClothingShop.Models.Order
@using ClothingShop.Models
@using ClothingShop.Services
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Chi tiết đơn hàng #@Model.OrderId</h3>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Sản phẩm trong đơn</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Phân loại</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td class="fw-semibold">@(d.Product != null ? d.Product.Name : "SP #" + d.ProductId)</td>
                                <td class="small text-muted">@d.Size / @d.Color</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">@PriceFormatter.Vnd(d.UnitPrice)</td>
                                <td class="text-end fw-semibold">@PriceFormatter.Vnd(d.UnitPrice * d.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end">Tạm tính:</td>
                            <td class="text-end">@PriceFormatter.Vnd(Model.Subtotal)</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end">Phí vận chuyển:</td>
                            <td class="text-end">@PriceFormatter.Vnd(Model.ShippingFee)</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="4" class="text-end text-success">
                                    Giảm giá @(Model.Coupon != null ? "(" + Model.Coupon.Code + ")" : ""):
                                </td>
                                <td class="text-end text-success">-@PriceFormatter.Vnd(Model.DiscountAmount)</td>
                            </tr>
                        }
                        <tr class="fw-bold fs-5">
                            <td colspan="4" class="text-end">Tổng cộng:</td>
                            <td class="text-end text-danger">@PriceFormatter.Vnd(Model.TotalAmount)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-semibold">Cập nhật trạng thái đơn</div>
            <div class="card-body">
                @using (Html.BeginForm("UpdateStatus", "Order", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái đơn hàng</label>
                        <select name="status" class="form-select">
                            @foreach (var st in OrderStatus.All)
                            {
                                <option value="@st" @(Model.Status == st ? "selected" : "")>@st</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái thanh toán</label>
                        <select name="paymentStatus" class="form-select">
                            <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Chưa thanh toán (Unpaid)</option>
                            <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Đã thanh toán (Paid)</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark">Cập nhật đơn hàng</button>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Thông tin giao hàng</div>
            <div class="card-body small">
                <p class="mb-1"><strong>Người nhận:</strong> @Model.ReceiverName</p>
                <p class="mb-1"><strong>Điện thoại:</strong> @Model.Phone</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> @Model.Address</p>
                <p class="mb-1"><strong>Thanh toán:</strong> @Model.PaymentMethod</p>
                <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p class="mb-0"><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
        </div>
    </div>
</div>
